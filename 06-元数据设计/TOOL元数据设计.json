{
    "id": "tool-550e8400e29b41d4a716446655440002",
    "type": "tool",
    "version": 1,
    "created_at": "2026-10-08T02:00:00Z",
    "updated_at": "2026-10-08T02:00:00Z",
    "enabled": true,
    "is_concurrency_safe": true,
    "permission": "allow",
    "name": "query-device-alarm",
    "display_name": "查询设备告警",
    "description": "按设备标识查询园区设备的当前告警，返回告警标识、级别、内容及发生时间；不修改设备状态。",
    "source": "builtin-toolset",
    "input_schema": {
        "type": "object",
        "properties": {
            "deviceId": {
                "type": "string",
                "minLength": 1,
                "description": "园区设备标识，例如 AHU-001。"
            }
        },
        "required": [
            "deviceId"
        ],
        "additionalProperties": false
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "deviceId": {
                "type": "string",
                "description": "本次查询的设备标识。"
            },
            "alarms": {
                "type": "array",
                "description": "当前告警列表；没有告警时返回空数组。",
                "items": {
                    "type": "object",
                    "properties": {
                        "alarmId": {
                            "type": "string",
                            "description": "告警标识。"
                        },
                        "severity": {
                            "type": "string",
                            "enum": [
                                "critical",
                                "major",
                                "minor",
                                "warning"
                            ],
                            "description": "告警级别。"
                        },
                        "message": {
                            "type": "string",
                            "description": "告警内容。"
                        },
                        "occurredAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "告警发生时间。"
                        }
                    },
                    "required": [
                        "alarmId",
                        "severity",
                        "message",
                        "occurredAt"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "required": [
            "deviceId",
            "alarms"
        ],
        "additionalProperties": false
    }
}
