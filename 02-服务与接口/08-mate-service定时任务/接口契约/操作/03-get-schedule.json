  "operation": {
    "method": "GET",
    "path": "/schedules/{scheduleId}",
    "summary": "读取定时任务详情",
    "description": "用户打开某个定时任务，查看保存的任务内容、Agent、时间规则和当前计划摘要。Mate 先检查任务对当前用户可见，再读取 Claw 并把 sessionId 换成 chatId；运行记录另从 Run 列表读取。本接口不定义请求头，前端调用时 Mate 框架已完成 access-token 校验。",
    "parameters": [
      {
        "in": "path",
        "name": "scheduleId",
        "required": true,
        "schema": "string, schedule-{32 位十六进制}",
        "description": "创建或列表返回的任务 ID，原样传回，不按名称查找，不自行构造；格式非法由 Claw 返回 400"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": "none",
      "description": "无请求体，也没有 query 参数。读取没有副作用，可以安全重试。"
    },
    "responses": [
      {
        "id": "200-ok",
        "status": "200",
        "tabLabel": "200 · 详情",
        "label": "OK",
        "summary": "返回与创建、列表相同的完整任务：接口创建的任务 chatId 为 null，对话中创建的任务为原 Chat。upcomingRunsAt 按本次读取时刻计算，updatedAt 不因读取变化。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
