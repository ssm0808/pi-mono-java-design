{
  "operation": {
    "shortName": "查看命令选项",
    "operationKey": "ListChatCommandOptions",
    "method": "GET",
    "path": "/chats/{chatId}/commands/{commandName}/options",
    "summary": "列出选项型命令的当前值与候选",
    "description": "查询当前 Chat 中某个 inputType=options 的命令可选择的值，返回当前值 currentValue 与候选列表 options，每个候选带可直接提交的 value 和可直接展示的 label。model 的候选取自该会话可选模型，label 为 mate-service 模型管理中的模型名称（没有名称时回退为 modelId）；thinking 的候选为 on、off，mode 的候选为 plan、build，label 按 Accept-Language 返回。前端把选中的 value 原样作为命令参数提交，不再自行查询模型信息或维护显示名。",
    "parameters": [
      {
        "$ref": "parameters.chatId"
      },
      {
        "$ref": "parameters.commandName"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不接受搜索、分页或内部 Session 参数。",
      "example": null
    },
    "responses": [
      {
        "id": "200-model",
        "status": "200",
        "label": "OK",
        "tabLabel": "200 · model",
        "summary": "model：当前值为会话当前模型，候选为该会话可选模型；模型名称是业务数据，各语言相同。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
