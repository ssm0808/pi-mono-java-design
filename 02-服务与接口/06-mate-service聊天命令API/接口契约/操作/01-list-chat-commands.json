{
  "operation": {
    "shortName": "查看聊天命令清单",
    "operationKey": "ListChatCommands",
    "method": "GET",
    "path": "/chats/{chatId}/commands",
    "summary": "列出当前 Chat 的命令",
    "description": "返回当前 Chat 对应会话的命令名称、类别、用途与参数提示，供前端展示 Slash 清单。描述符与 Runtime 保持同形；按固定 Builtin 顺序及 Skill 名称排序，并根据会话状态过滤命令。hints 仅供展示，不代表修改权限或附件能力。",
    "parameters": [
      {
        "$ref": "parameters.chatId"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不接受搜索、强制刷新或内部 Session 参数。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "tabLabel": "200 · Running",
        "summary": "Session 正在运行。只返回当前可调用的命令形态；Model/Thinking 仅保留无参查看，Compact 和 Skill 不返回。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "commands": [
                {
                  "name": "help",
                  "type": "builtin",
                  "description": "介绍当前 Agent 的用途和使用场景",
                  "hints": []
                },
                {
                  "name": "status",
                  "type": "builtin",
                  "description": "查看 Session 状态、模型和深度思考",
                  "hints": []
                },
                {
                  "name": "name",
                  "type": "builtin",
                  "description": "查看或修改 Session 名称",
                  "hints": [
                    "displayName"
                  ]
                },
                {
                  "name": "model",
                  "type": "builtin",
                  "description": "查看或切换模型",
                  "hints": [
                    "modelId"
                  ]
                },
                {
                  "name": "thinking",
                  "type": "builtin",
                  "description": "查看或切换深度思考",
                  "hints": [
                    "on|off"
                  ]
                },
                {
                  "name": "skills",
                  "type": "builtin",
                  "description": "列出当前 Agent 绑定的 Skill",
                  "hints": []
                }
              ]
            }
          }
        },
        "id": "200-running"
      },
      {
        "status": "200",
        "label": "OK",
        "tabLabel": "200 · Idle",
        "summary": "Session 处于空闲。恢复 Compact、Skill 以及 Model/Thinking 的带参调用形态。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "commands": [
                {
                  "name": "help",
                  "type": "builtin",
                  "description": "介绍当前 Agent 的用途和使用场景",
                  "hints": []
                },
                {
                  "name": "status",
                  "type": "builtin",
                  "description": "查看 Session 状态、模型和深度思考",
                  "hints": []
                },
                {
                  "name": "name",
                  "type": "builtin",
                  "description": "查看或修改 Session 名称",
                  "hints": [
                    "displayName"
                  ]
                },
                {
                  "name": "model",
                  "type": "builtin",
                  "description": "查看或切换模型",
                  "hints": [
                    "modelId"
                  ]
                },
                {
                  "name": "thinking",
                  "type": "builtin",
                  "description": "查看或切换深度思考",
                  "hints": [
                    "on|off"
                  ]
                },
                {
                  "name": "compact",
                  "type": "builtin",
                  "description": "压缩当前上下文",
                  "hints": []
                },
                {
                  "name": "skills",
                  "type": "builtin",
                  "description": "列出当前 Agent 绑定的 Skill",
                  "hints": []
                },
                {
                  "name": "skill:pdf",
                  "type": "skill",
                  "description": "分析和生成 PDF 文档",
                  "hints": [
                    "request"
                  ]
                }
              ]
            }
          }
        },
        "id": "200-idle"
      },
      {
        "status": "400",
        "label": "Bad Request",
        "summary": "chatId 为空、过长或格式不符合公共 Chat 约束。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "INVALID_CHAT_ID",
            "resMsg": "chatId 格式不正确。"
          },
          "en-US": {
            "resCode": "INVALID_CHAT_ID",
            "resMsg": "The chatId format is invalid."
          }
        }
      },
      {
        "status": "401",
        "label": "Unauthorized",
        "summary": "用户未登录或访问令牌无效。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "UNAUTHENTICATED",
            "resMsg": "请先登录。"
          },
          "en-US": {
            "resCode": "UNAUTHENTICATED",
            "resMsg": "Authentication is required."
          }
        }
      },
      {
        "status": "403",
        "label": "Forbidden",
        "summary": "登录用户无权访问该 Chat；不得据此探测内部 Session。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_ACCESS_DENIED",
            "resMsg": "无权访问该 Chat。"
          },
          "en-US": {
            "resCode": "CHAT_ACCESS_DENIED",
            "resMsg": "Access to the Chat is denied."
          }
        }
      },
      {
        "status": "404",
        "label": "Not Found",
        "summary": "Chat 不存在、已删除，或尚未建立有效 Runtime Session 映射。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_NOT_FOUND",
            "resMsg": "指定的 Chat 不存在。"
          },
          "en-US": {
            "resCode": "CHAT_NOT_FOUND",
            "resMsg": "The specified Chat does not exist."
          }
        }
      },
      {
        "status": "503",
        "label": "Service Unavailable",
        "summary": "暂时无法获取命令清单；UI 保留 Slash 草稿。",
        "headers": {
          "Content-Language": "zh-CN",
          "Retry-After": "3"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "COMMAND_CATALOG_UNAVAILABLE",
            "resMsg": "命令清单暂时不可用。"
          },
          "en-US": {
            "resCode": "COMMAND_CATALOG_UNAVAILABLE",
            "resMsg": "The command catalog is temporarily unavailable."
          }
        }
      }
    ],
    "contractSections": [
      {
        "title": "命令描述符字段",
        "description": "result.commands 为命令数组。描述符用于发现和展示；实际执行参数由 ExecuteSessionCommand 定义。",
        "columns": [
          "字段",
          "类型 / 必填",
          "含义与省略规则"
        ],
        "rows": [
          [
            "name",
            "string / 必填",
            "不带前导 /；Builtin 裸名或 skill:<name>，用于精确标识命令。"
          ],
          [
            "type",
            "string / 必填",
            "命令类别，仅 builtin 或 skill；不表示控件类型或业务响应类型，必须与 name 的命名空间一致。"
          ],
          [
            "description",
            "string / 必填",
            "非空的命令用途说明；描述语言与当前实现差异见下表。"
          ],
          [
            "hints",
            "string[] / 可省略",
            "有序参数提示列表，各项为非空文本；无提示可省略或返回 []，不返回 null。仅供展示，不解析成 Schema、枚举、必填规则或权限；idle/running 下相同命令的提示保持一致。"
          ],
          [
            "不公开的字段",
            "不返回",
            "kind、input、acceptsFiles、acceptsArguments、available、unavailableCode、allowedValues、catalogVersion；内部准入 DTO 不直接序列化。"
          ]
        ]
      }
    ]
  },
  "review": {
    "businessView": {
      "summary": "展示当前 Chat 可发现的命令，参数控件与状态限制由前端依据命令规则和权威会话状态处理。公共路径、认证、bridge 与错误映射待评审、待实现，不得作为已发布接口的依据。",
      "flow": [
        {
          "actor": "前端",
          "action": "读取当前 Chat 命令清单",
          "outcome": "按服务器顺序展示，不推测内部状态"
        },
        {
          "actor": "mate-service",
          "action": "在目标 bridge 中复用 Runtime 轻量投影",
          "outcome": "公共认证与错误映射另行评审"
        },
        {
          "actor": "前端",
          "action": "按 type/name 选择控件，hints 仅作参数提示",
          "outcome": "命令无匹配时保留草稿，不回退普通消息"
        }
      ],
      "notes": [
        "描述符仅包含 name、type、description 和可选 hints。hints 缺失不代表禁止参数；所有 Skill 允许附件，Builtin 不允许；运行中的 model/thinking 只允许无参查询。",
        "无完整 Agent 快照时，目标清单失败，不返回残缺 Builtin；公共错误映射保留待重审状态。",
        "GET 是观察结果，不保证随后 POST 一定成功；POST 仍需独立解析并在所属事务或锁内复核。",
        "Skill 发现不等于 Skill 执行协议已发布。旧公共 POST SSE 已废止，不属于本次 GET 恢复范围。",
        "状态未知、恢复中或清单过期时暂停提交并读取权威状态；状态变化不能清空参数后自动改成查询。"
      ]
    },
    "questions": []
  }
}
