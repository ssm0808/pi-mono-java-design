{
  "api": {
    "title": "mate-service Chat Command API",
    "version": "1.1.0",
    "basePath": "/mate-service/v1",
    "visibility": "Public · 已废止 · historical target-only",
    "fieldNaming": "lowerCamelCase",
    "headerNaming": "保留原名"
  },
  "commandNamePatterns": {
    "builtin": "^[a-z0-9-]+$",
    "skill": "^skill:[a-z0-9]+(?:-[a-z0-9]+)*$",
    "commandId": "^command-[0-9a-f]{32}$"
  },
  "commandLimits": {
    "skillNameCharacters": 64,
    "skillCommandNameCharacters": 70,
    "argumentsUtf16CodeUnits": 262144,
    "fileIds": 32
  },
  "requestHeaderExamples": [
    {
      "id": "user-token",
      "label": "登录用户 Header 示例",
      "preferred": true,
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer <USER_ACCESS_TOKEN>",
          "required": true,
          "description": "mate-service 验证登录用户并建立 Chat 权限上下文；不会原样转发到 CampusClaw"
        }
      ]
    }
  ],
  "parameters": {
    "chatId": {
      "in": "path",
      "name": "chatId",
      "required": true,
      "schema": "string, 1..128",
      "description": "用户有权访问的公共 Chat 标识；mate-service 通过稳定一对一映射解析内部 Session"
    },
    "acceptLanguage": {
      "in": "header",
      "name": "Accept-Language",
      "required": false,
      "schema": "zh-CN | en-US",
      "description": "异常消息语言；缺失或不支持时回退 en-US"
    }
  }
}
