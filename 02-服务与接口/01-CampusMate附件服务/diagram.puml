@startuml file_upload_and_scan_flow
' Source evidence:
' pi-mono packages/agent/src/agent.ts, prompt
' pi-mono packages/ai/src/types.ts, ImageContent
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/types/ImageContent.java, ImageContent
' Observed behavior: both baselines accept inline image content but have no generic upload and scan API.
' Architecture change: mate-service streams files to private OBS and stores metadata in openGauss.
' Security hardening: uploaded scripts remain untrusted bytes and are never executed.

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam maxMessageSize 210
skinparam sequenceMessageAlign left
hide footbox
skinparam sequence {
  ArrowColor #475569
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #64748B
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #CBD5E1
  GroupBackgroundColor #F8FAFC
}
title File Upload - Store, Scan, Respond
actor Client
participant "File API" as API
database "Chat Store" as Chats
database openGauss as DB
participant "Private OBS" as OBS
participant "Scan Worker" as Worker
participant Scanner

== 1. Authorize and allocate ==
Client -> API : Upload file\nJWT, X-File-Size, Prefer
API -> Chats : Authorize Chat / resolve Session
Chats --> API : session_id
API -> API : Normalize name / validate size
API -> DB : Insert identity + active detail
DB --> API : Commit file_id

== 2. Store immutable bytes ==
API -> OBS : Create-only PUT(file_id)\nCount bytes and calculate SHA-256
alt Object key already exists
  OBS --> API : Conflict
  API -> DB : FAILED + OBJECT_KEY_CONFLICT
  DB --> API : Quarantine committed
  API --> Client : Storage error
else Object stored
  OBS --> API : PUT complete
  API -> API : Check declared length and EOF
  API -> DB : Set PROCESSING + digest
  DB --> API : Commit

  == 3. Respond and scan independently ==
  par HTTP response policy
    alt No wait preference
      API --> Client : 202 PROCESSING
    else Prefer wait=N (at most 10 seconds)
      API -> DB : Observe committed scan state
      DB --> API : State within wait window
      alt READY
        API --> Client : 201 READY
      else BLOCKED
        API --> Client : 422 FILE_BLOCKED
      else Wait expires
        API --> Client : 202 PROCESSING
      end
    end
  else Scan work
    Worker -> DB : Claim short lease
    DB --> Worker : Lease committed
    Worker -> OBS : Stream GET(file_id)
    OBS --> Worker : Bounded byte stream
    Worker -> Scanner : Detect MIME / scan bytes
    Scanner --> Worker : Safe, blocked or failure
    Worker -> DB : Conditional state / retry update
    DB --> Worker : Commit
  end
end

note over API,OBS
file_id is the OBS Object Key.
No local file or complete byte array.
end note
note over DB,Worker
Release the database transaction before external I/O.
end note
@enduml

@startuml file_obs_opengauss_storage_split
' Source evidence:
' pi-mono packages/ai/src/types.ts, ImageContent
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/types/ImageContent.java, ImageContent
' Observed behavior: source images are inline; neither baseline defines a shared large-object authority.
' Architecture change: OBS owns immutable bytes and openGauss owns identity, state, and worker leases.
' Product constraint: Mate Chat Store alone owns chat_id to session_id mappings.
' Design reason: isolate large-object throughput from relational state and database backup.
' Target-only design: shared file storage for every stateless API Pod and background worker.
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #475569
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 35
skinparam component {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
title File Storage - Shared Authority Across Pods
top to bottom direction
component "CampusClaw" as Runtime
package "mate-service deployment" {
  component "File API Pods (1..N)" as API
  component "Scan / Delete Workers" as Worker
  interface "FileContentStore" as Port
  component "ObsFileContentStore" as Adapter
  API --> Port : stream(file_id)
  Worker --> Port : stat / delete(file_id)
  Adapter .up.|> Port
}
database "Mate Chat Store\nchat_id -> session_id" as Chat
database "Shared openGauss" as DB {
  rectangle "t_file\nPermanent identity / status" as File
  rectangle "t_file_active_detail\nLive metadata / lease / retry" as Detail
  File -- "0..1" Detail
}
cloud "Private OBS\nObject Key = file_id" as OBS
Runtime --> API : resolve / content
API --> Chat : authorize / resolve
API --> DB : metadata transaction
Worker --> DB : state / lease transaction
Adapter --> OBS : immutable bytes over TLS
legend bottom left
Target-only deployment; every Pod uses the same Chat, metadata and content authorities.
OBS stores one immutable object per file_id; no extra resource ID or path prefix.
Deletion removes active detail and retains the five-field t_file tombstone.
No file BLOB, URL, credentials, local authority or complete-file cache.
endlegend
@enduml

@startuml file_cross_pod_resolution_flow
' Source evidence:
' pi-mono packages/agent/src/agent.ts, prompt
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java, prompt
' Observed behavior: neither baseline has a generic file reference or cross-service content resolver.
' Architecture change: CampusClaw resolves ordered file_ids and streams verified content through mate-service.
' Security hardening: CampusClaw receives no OBS location or credential and validates length and digest.

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam maxMessageSize 210
skinparam sequenceMessageAlign left
hide footbox
skinparam sequence {
  ArrowColor #475569
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #64748B
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #CBD5E1
  GroupBackgroundColor #F8FAFC
}
title File Resolution - Atomic Batch, Verified Content
participant CampusClaw as Runtime
participant "File API" as API
database openGauss as DB
participant "Private OBS" as OBS
participant "Model Input Adapter" as Model

== 1. Resolve the complete batch ==
Runtime -> API : POST files:resolve\nsessionId + ordered fileIds
API -> API : Verify one service credential mode
API -> DB : Lock all IDs in stable order
DB --> API : Current rows
API -> API : Check Session, READY and expiry
alt Any file is invalid
  API -> DB : Roll back
  DB --> API : No references changed
  API --> Runtime : INVALID_FILE or FILE_NOT_READY
else All files are valid
  API -> DB : Set first reference / clear expiry
  DB --> API : Commit trusted snapshots
  API --> Runtime : ResultBean in request order

  == 2. Read each accepted file ==
  loop Each resolved file
    Runtime -> API : GET content\nSession, file_id, expected SHA-256
    API -> DB : Recheck READY, reference and digest
    DB --> API : Size / digest / trusted MIME
    API -> OBS : Stream GET(file_id)
    OBS --> API : Original bytes
    API -> API : Verify length and digest
    API --> Runtime : Bounded binary stream
    Runtime -> Runtime : Verify length and digest
    Runtime -> Model : Untrusted user content
  end
end

note over Runtime,API
Persist only the trusted metadata snapshot with User Entry.
A failed batch never starts content reads.
end note
note over API,OBS
Backpressure and cancellation propagate through the stream.
No local file or complete in-memory object.
end note
@enduml

@startuml file_deletion_and_reconciliation
' Source evidence:
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java, abort
' Observed behavior: the baseline has no generic file tombstone, lease, or reconciliation flow.
' Architecture change: conditional database state, short leases, and idempotent OBS operations replace XA.
' Product constraint: referenced files are retained until Chat and Runtime Session cleanup.

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam maxMessageSize 210
skinparam sequenceMessageAlign left
hide footbox
skinparam sequence {
  ArrowColor #475569
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #64748B
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #CBD5E1
  GroupBackgroundColor #F8FAFC
}
title File Deletion - Eligibility and Cleanup
actor Client
participant "File API" as API
participant "Chat / Session cleanup" as Cleanup
database openGauss as DB
participant "Delete Worker" as Worker
participant "Private OBS" as OBS

== 1. Establish deletion eligibility ==
alt Delete one file
  Client -> API : DELETE attachment
  API -> Cleanup : Authorize Chat / resolve Session
  Cleanup --> API : session_id
  API -> DB : Check reference / conditional update
  alt Referenced
    DB --> API : referenced_at is set
    API --> Client : 409 FILE_REFERENCED
  else Object-key quarantine
    DB --> API : Retain FAILED detail
    API --> Client : Bounded 503 error
  else Unreferenced or already deleting
    DB --> API : DELETING
    API --> Client : 202 ResultBean
  end
else Delete Chat and Session
  Client -> Cleanup : Delete Chat
  Cleanup -> Cleanup : Authorize / hide Runtime Session\nStop execution and reads
  Cleanup -> DB : Mark normal Session files DELETING
  DB --> Cleanup : Cleanup committed
end

== 2. Delete bytes outside a transaction ==
Worker -> DB : Claim eligible DELETING lease
DB --> Worker : Committed file_id / row_version
Worker -> OBS : Idempotent DELETE(file_id)
alt Deleted or NotFound
  OBS --> Worker : Success
  Worker -> DB : Remove detail / write DELETED
  DB --> Worker : Tombstone committed
else Temporary failure
  OBS --> Worker : Retryable failure
  Worker -> DB : Release lease / schedule retry
  DB --> Worker : Retry state committed
end

note over DB,OBS
Only audited reconciliation may resolve object-key quarantine.
DELETED retains five identity fields; file_id is never reused.
end note
@enduml


@startuml file_audited_reconciliation
' Baseline: pi-mono-java 195746614096312d4e93afb029d387837db78e0b.
' Source evidence: modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java: abort.
' Target-only architecture: no generic file cleanup in that baseline.
' Design reason: ownership evidence is required before deleting a conflicting OBS object.
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam maxMessageSize 210
skinparam sequenceMessageAlign left
hide footbox
skinparam sequence {
  ArrowColor #475569
  LifeLineBorderColor #94A3B8
  ParticipantBorderColor #64748B
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #CBD5E1
  GroupBackgroundColor #F8FAFC
}
title File Reconciliation - Prove Object Ownership
participant "Audited Reconciler" as Worker
database openGauss as DB
participant "Private OBS" as OBS

== 1. Compare recorded state and object ==
Worker -> DB : Read stale / quarantined candidates
DB --> Worker : file_id + recorded metadata
Worker -> OBS : Stat(file_id)
OBS --> Worker : Object metadata or NotFound

== 2. Reconcile only with evidence ==
alt Owned valid object
  Worker -> Worker : Verify ownership
  Worker -> DB : Recover processing or allow safe deletion
  DB --> Worker : Conditional update committed
else NotFound
  Worker -> DB : Remove detail / set DELETED
  DB --> Worker : Tombstone committed
else Ownership remains unknown
  Worker -> DB : Retain quarantine
  DB --> Worker : No deletion authorized
end
@enduml
