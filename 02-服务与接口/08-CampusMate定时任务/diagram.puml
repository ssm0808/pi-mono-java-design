  class ScheduleManagementController <<浏览器入口：待实现>> {
    + 10 个操作，/mate-service/v1/schedules…、/schedule-runs…
  }
  class ScheduleRuntimeController <<Claw 入口：待实现>> {
    + scheduledAccessToken()
    + registerSession(request)
    + findSession(sessionId)
  }
}

package "应用服务（待实现）" as AppPkg {
  class ScheduleManagementService <<待实现>> {
    + 10 个操作(accessToken, 请求)：转发 Claw 并投影
  }
  class ScheduledSessionRegistrationService <<待实现>> {
    + register(sessionId, scheduleId, runId, agentId, userId)
    + find(sessionId)
  }
  class ScheduledAccessTokenService <<待实现>> {
    + currentToken() : String
  }
  class ScheduledSessionReconciler <<定时运行：待实现>> {
    + reconcile()
  }
  class ScheduleProjector <<待实现>> {
    + toView(clawSchedule) : ScheduleView
    + toView(clawRun) : ScheduleRunView
  }
}

package "持久化（待实现，物理表由 Mate 决定）" as StorePkg {
  interface ScheduledSessionStore <<待实现>> {
    + 定时会话登记：写入、按 sessionId 读取、确认、删除
  }
  class ScheduledSessionRegistration <<t_schedule_session>> {
    sessionId : String
    scheduleId, runId : String
    status : registered / confirmed
    createdAt : Instant
  }
}

package "外部边界" as ExtPkg {
  interface ClawScheduleClient <<待实现>> {
    + 10 个 Claw 定时任务接口（带用户的 access-token）
  }
  interface ChatService <<Mate 既有：未核验>> {
    + create(userId, chatId = sessionId)
    + ownerOf(chatId)
  }
  interface UnifiedAccountTokenSource <<Mate 既有：未核验>> {
    + accessToken()
  }
}

ScheduleManagementController --> ScheduleManagementService
ScheduleRuntimeController --> ScheduledSessionRegistrationService
ScheduleRuntimeController --> ScheduledAccessTokenService
ScheduleManagementService --> ClawScheduleClient
ScheduleManagementService --> ScheduleProjector
ScheduledSessionRegistrationService --> ScheduledSessionStore
ScheduledSessionRegistrationService --> ChatService
ScheduledAccessTokenService --> UnifiedAccountTokenSource
ScheduledSessionReconciler --> ScheduledSessionStore
ScheduledSessionReconciler --> ClawScheduleClient
ScheduledSessionStore "1" o-- "*" ScheduledSessionRegistration
WebPkg -[hidden]down- AppPkg
AppPkg -[hidden]down- StorePkg
@enduml

