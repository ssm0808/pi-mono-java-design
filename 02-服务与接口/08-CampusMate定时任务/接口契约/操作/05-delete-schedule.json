        }
      },
      {
        "id": "503-schedule-service-unavailable",
        "status": "503",
        "tabLabel": "503 · SCHEDULE_SERVICE_UNAVAILABLE",
        "label": "Service Unavailable",
        "summary": "Claw 不可达、证书校验失败，或结果未知（超时、断连）。Mate 不自动重试；删除可以重发，再次得到 404 即表示已删除。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "SCHEDULE_SERVICE_UNAVAILABLE",
            "resMsg": "定时任务服务暂不可用，请稍后重试。"
          },
          "en-US": {
            "resCode": "SCHEDULE_SERVICE_UNAVAILABLE",
            "resMsg": "The schedule service is temporarily unavailable. Please try again later."
          }
        }
      }
    ]
  },
