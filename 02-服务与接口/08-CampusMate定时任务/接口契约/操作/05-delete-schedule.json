          "en-US": {
            "resCode": "SCHEDULE_REQUEST_INVALID",
            "resMsg": "Invalid schedule request."
          }
        }
      },
      {
        "id": "404-schedule-not-found",
        "status": "404",
        "tabLabel": "404 · SCHEDULE_NOT_FOUND",
        "label": "Not Found",
        "summary": "任务不存在、已删除，或对当前用户不可见，三种情况结果相同。重复删除也返回 404，页面按已删除处理。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
