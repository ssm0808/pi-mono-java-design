{
  "api": {
    "title": "CampusMate 定时任务管理 API",
    "version": "2.1.0",
    "basePath": "/mate-service/v1",
    "visibility": "Public · 待评审 · 待实现"
  },
  "operation": {
    "method": "DELETE",
    "path": "/schedules/{scheduleId}",
    "summary": "删除定时任务",
    "description": "用户不再需要某个定时任务时删除它，之后不再产生新的运行。Mate 把用户的 access-token 转给 Claw，Claw 按任务的创建者判断归属，不属于当前用户与不存在一样返回 404；可见时 Claw 在同一事务内删除，Mate 返回 Claw 删除时的最后配置，sessionId 改名为 chatId。该任务的 Run 随之删除，已生成的会话、定时会话登记与 Chat 记录保留，已受理的运行不取消。本接口不定义请求头，前端调用时 Mate 框架已完成 access-token 校验。",
    "parameters": [
      {
        "in": "path",
        "name": "scheduleId",
        "required": true,
        "schema": "string, schedule-{32 位十六进制}",
        "description": "创建或列表返回的任务 ID，原样传回，不按名称查找，不自行构造；格式非法由 Claw 返回 400"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": "none",
      "description": "无请求体，也没有 query 参数；带非空正文或 query 参数由 Claw 返回 400。重复删除不会再次删除，结果未知时可以直接重发同一请求。"
    },
    "responses": [
      {
        "id": "200-ok",
        "status": "200",
        "tabLabel": "200 · 删除回执",
        "label": "OK",
        "summary": "删除已生效。result 是删除时的最后配置，形状与详情相同：status 与 pausedReason 保留删除前的值，有 Cron 规则时 upcomingRunsAt 为空数组，updatedAt 为删除时间。这是一次性回执，页面应从列表中移除该任务，之后详情返回 404。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "bodies": {
          "接口创建的任务": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "type": "schedule",
              "id": "schedule-927e03d2a4784f90a6238e790539c6e4",
              "name": "工作日园区告警汇总",
              "description": null,
              "agentId": "agent-550e8400e29b41d4a716446655440000",
              "chatId": null,
              "prompt": "汇总园区过去24小时的设备告警，并标出需要跟进的工单。",
              "schedule": {
                "type": "cron",
                "expression": "0 0 8 * * MON-FRI",
                "timezone": "Asia/Shanghai",
                "lastRunAt": null,
                "upcomingRunsAt": []
              },
              "status": "active",
              "pausedReason": null,
              "createdAt": "2026-10-04T02:00:00Z",
              "updatedAt": "2026-10-21T03:00:00Z",
              "metadata": {
                "parkCode": "park-east",
                "purpose": "alarm-summary"
              }
            }
          },
          "对话中创建的任务（删除前已暂停）": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "type": "schedule",
              "id": "schedule-1f2e3d4c5b6a47988a7b6c5d4e3f2a1b",
              "name": "每晚门禁异常复盘",
              "description": "在门禁巡检对话中创建，每晚复盘当天的门禁异常。",
              "agentId": "agent-550e8400e29b41d4a716446655440000",
              "chatId": "b5e1c2d3f4a5468798a0b1c2d3e4f506",
              "prompt": "复盘今天东区门禁的异常记录，列出需要处理的设备。",
              "schedule": {
                "type": "cron",
                "expression": "0 30 21 * * *",
                "timezone": "Asia/Shanghai",
                "lastRunAt": "2026-10-03T13:30:00Z",
                "upcomingRunsAt": []
              },
              "status": "paused",
              "pausedReason": "manual",
              "createdAt": "2026-10-01T09:12:00Z",
              "updatedAt": "2026-10-21T03:00:00Z",
              "metadata": {}
            }
          }
        }
      },
      {
        "id": "400-schedule-request-invalid",
        "status": "400",
        "tabLabel": "400 · SCHEDULE_REQUEST_INVALID",
        "label": "Bad Request",
        "summary": "scheduleId 格式非法、带了 query 参数或非空请求体。Claw 校验，错误码原样返回。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "SCHEDULE_REQUEST_INVALID",
