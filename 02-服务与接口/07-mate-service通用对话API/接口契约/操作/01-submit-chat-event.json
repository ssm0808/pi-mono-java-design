{
  "api": {
    "title": "mate-service General Chat Events API",
    "version": "1.4.2",
    "basePath": "/mate-service/v1",
    "visibility": "Public · 已确认 · target-only"
  },
  "operation": {
    "method": "POST",
    "path": "/chats/{chatId}/events",
    "summary": "提交一条用户事件",
    "description": "向指定 Chat 提交一项用户操作：发送消息、中断当前执行，或回复工具调用确认。服务端接收并保存事件后，在 result.event 中返回与历史记录一致的完整用户事件；Agent 的后续输出仍从实时流或历史查询获取。一次请求只接受一个事件；提交 interrupt 后，必须等待 chat.status_idle(reason=terminated) 再发送新消息。POST 响应丢失时应查询权威历史，禁止盲目重放。",
    "authModes": [
      {
        "id": "jwt",
        "label": "JWT 首选",
        "preferred": true,
        "headers": [
          {
            "name": "X-HW-ID",
            "value": "<CALLER_ID>",
            "required": true,
            "description": "公司调用方身份，非空"
          },
          {
            "name": "access-token",
            "value": "<ACCESS_TOKEN>",
            "required": true,
            "description": "当前调用上下文访问令牌，非空"
          },
          {
            "name": "Authorization",
            "value": "Bearer <JWT>",
            "required": true,
            "description": "首选公司 JWT；与 APPKEY 同时存在时使用 JWT，JWT 无效不回退"
          }
        ]
      },
      {
        "id": "appkey",
        "label": "APPKEY 兼容",
        "preferred": false,
        "headers": [
          {
            "name": "X-HW-ID",
            "value": "<CALLER_ID>",
            "required": true,
            "description": "公司调用方身份，非空"
          },
          {
            "name": "access-token",
            "value": "<ACCESS_TOKEN>",
            "required": true,
            "description": "当前调用上下文访问令牌，非空"
          },
          {
            "name": "X-HW-APPKEY",
            "value": "<APPKEY>",
            "required": true,
            "description": "未提供 Authorization 时使用的公司 AppKey"
          }
        ]
      }
    ],
    "parameters": [
      {
        "in": "path",
        "name": "chatId",
        "required": true,
        "schema": "string, 1..64, case-sensitive",
        "description": "调用方有权访问的公共 Chat 标识；不施加额外正则，不接受内部 sessionId"
      }
    ],
    "requestBody": {
      "required": true,
      "contentType": "application/json",
      "description": "示例展示用户附上园区巡检记录，请 Agent 梳理异常告警并提出处理建议。一次请求只提交一个 event；也可以提交 user.interrupt 中断当前执行，或以 user.tool_confirmation 回复 Tool 确认。user.message 的 content 长度为 1..5，仅允许 text/file；最多一个 text 且必须位于第一项，text 非空白且最多 2048 Unicode code point；最多四个不重复 file，fileId 匹配 ^[0-9a-f]{32}$。user.interrupt 只有 type。user.tool_confirmation 包含 toolCallId、result=allow|deny；toolCallId 必须原样回传 agent.tool_call.toolCallId，其值直接来自 OpenAI Responses call_id 或 Chat Completions tool_calls[].id，按大小写区分的不透明非空字符串处理，不施加正则。denyMessage 仅 deny 可省略或提供非空白的最多 2048 code point 字符串。已知对象忽略未知字段；未知 type、null 条件字段和批量事件非法。",
      "example": {
        "event": {
          "type": "user.message",
          "content": [
            {
              "type": "text",
              "text": "请结合附件中的巡检记录，梳理东区园区的异常告警，并给出处理建议。"
            },
            {
              "type": "file",
              "fileId": "7f12d8a380964fdc8518f48be1cf6a42"
            }
          ]
        }
      }
    },
    "responses": [
      {
        "id": "200-accepted",
        "status": "200",
        "tabLabel": "200 · 已接受",
        "label": "OK",
        "summary": "示例分别展示消息、中断指令和工具确认结果被接收后的完整记录。result.event 可直接用于界面更新和历史对账；它不代表 Agent 已完成执行。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store"
        },
        "bodies": {
          "园区巡检分析请求已接收（user.message）": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "event": {
                "eventId": "b7ef45d40a854c33af7a36df871a21e8",
                "type": "user.message",
                "createdAt": "2026-09-02T08:30:15.123Z",
                "content": [
                  {
                    "type": "text",
                    "text": "请结合附件中的巡检记录，梳理东区园区的异常告警，并给出处理建议。"
                  },
                  {
                    "type": "file",
                    "fileId": "7f12d8a380964fdc8518f48be1cf6a42"
                  }
                ]
              }
            }
          },
          "中断分析的指令已接收（user.interrupt）": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "event": {
                "eventId": "aee903c130e048b9bc2894fc32cd63a8",
                "type": "user.interrupt",
                "createdAt": "2026-09-02T08:30:14.800Z"
              }
            }
          },
          "拒绝高风险操作的结果已接收（user.tool_confirmation）": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "event": {
                "eventId": "2781508bb1c9496f94a0454d0bf8c0f8",
                "type": "user.tool_confirmation",
                "createdAt": "2026-09-02T08:30:16.420Z",
                "toolCallId": "call_unLAR8MvFNptuiZK6K6HCy5k",
                "result": "deny",
                "denyMessage": "该操作会修改生产配置，请先给出无变更风险的处理建议。"
              }
            }
          }
        }
      },
      {
        "id": "400-chat-id-invalid",
        "status": "400",
        "tabLabel": "400 · CHAT_ID_INVALID",
        "label": "Bad Request",
        "summary": "chatId 长度不在 1..64。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_ID_INVALID",
            "resMsg": "chatId 长度必须为 1 到 64 个字符。"
          },
          "en-US": {
            "resCode": "CHAT_ID_INVALID",
            "resMsg": "chatId must contain between 1 and 64 characters."
          }
        }
      },
      {
        "id": "400-chat-event-invalid",
        "status": "400",
        "tabLabel": "400 · CHAT_EVENT_INVALID",
        "label": "Bad Request",
        "summary": "JSON、content、fileId、toolCallId、result 或 denyMessage 不符合约束。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_EVENT_INVALID",
            "resMsg": "事件内容不符合要求。"
          },
          "en-US": {
            "resCode": "CHAT_EVENT_INVALID",
            "resMsg": "The event does not satisfy the required constraints."
          }
        }
      },
      {
        "id": "400-chat-event-type-invalid",
        "status": "400",
        "tabLabel": "400 · CHAT_EVENT_TYPE_INVALID",
        "label": "Bad Request",
        "summary": "event.type 不是三个受支持的用户事件之一。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_EVENT_TYPE_INVALID",
            "resMsg": "事件 type 不受支持。"
          },
          "en-US": {
            "resCode": "CHAT_EVENT_TYPE_INVALID",
            "resMsg": "The event type is not supported."
          }
        }
      },
      {
        "id": "401-unauthenticated",
        "status": "401",
        "tabLabel": "401 · UNAUTHENTICATED",
        "label": "Unauthorized",
        "summary": "必要认证字段缺失或凭据无效；JWT 无效时不得回退 APPKEY。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "UNAUTHENTICATED",
            "resMsg": "调用方身份认证失败。"
          },
          "en-US": {
            "resCode": "UNAUTHENTICATED",
            "resMsg": "Caller authentication failed."
          }
        }
      },
      {
        "id": "403-chat-access-denied",
        "status": "403",
        "tabLabel": "403 · CHAT_ACCESS_DENIED",
        "label": "Forbidden",
        "summary": "调用方无权访问该 Chat；拒绝发生在内部 Session 解析之前。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_ACCESS_DENIED",
            "resMsg": "无权访问该 Chat。"
          },
          "en-US": {
            "resCode": "CHAT_ACCESS_DENIED",
            "resMsg": "You do not have permission to access this Chat."
          }
        }
      },
      {
        "id": "404-chat-not-found",
        "status": "404",
        "tabLabel": "404 · CHAT_NOT_FOUND",
        "label": "Not Found",
        "summary": "公共 Chat 不存在。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_NOT_FOUND",
            "resMsg": "Chat 不存在。"
          },
          "en-US": {
            "resCode": "CHAT_NOT_FOUND",
            "resMsg": "The Chat does not exist."
          }
        }
      },
      {
        "id": "409-chat-busy",
        "status": "409",
        "tabLabel": "409 · CHAT_BUSY",
        "label": "Conflict",
        "summary": "Chat 正在执行或等待 Tool 确认，不能接受新的 user.message。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_BUSY",
            "resMsg": "当前 Chat 不能接受新的用户消息。"
          },
          "en-US": {
            "resCode": "CHAT_BUSY",
            "resMsg": "The Chat cannot accept a new user message."
          }
        }
      },
      {
        "id": "409-chat-not-running",
        "status": "409",
        "tabLabel": "409 · CHAT_NOT_RUNNING",
        "label": "Conflict",
        "summary": "idle Chat 没有可被 user.interrupt 终止的执行。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_NOT_RUNNING",
            "resMsg": "当前 Chat 没有可中断的执行。"
          },
          "en-US": {
            "resCode": "CHAT_NOT_RUNNING",
            "resMsg": "The Chat has no running execution to interrupt."
          }
        }
      },
      {
        "id": "409-tool-confirmation-not-pending",
        "status": "409",
        "tabLabel": "409 · TOOL_CONFIRMATION_NOT_PENDING",
        "label": "Conflict",
        "summary": "Tool Call 不存在、不属于该 Chat 或没有等待确认。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "TOOL_CONFIRMATION_NOT_PENDING",
            "resMsg": "指定的 Tool Call 不在等待确认。"
          },
          "en-US": {
            "resCode": "TOOL_CONFIRMATION_NOT_PENDING",
            "resMsg": "The specified Tool Call is not awaiting confirmation."
          }
        }
      },
      {
        "id": "503-chat-runtime-unavailable",
        "status": "503",
        "tabLabel": "503 · CHAT_RUNTIME_UNAVAILABLE",
        "label": "Service Unavailable",
        "summary": "Claw 暂不可用且事件没有被接受。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN",
          "Retry-After": "3"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "CHAT_RUNTIME_UNAVAILABLE",
            "resMsg": "对话执行服务暂时不可用。"
          },
          "en-US": {
            "resCode": "CHAT_RUNTIME_UNAVAILABLE",
            "resMsg": "The conversation runtime is temporarily unavailable."
          }
        }
      }
    ]
  },
  "review": {
    "questions": [],
    "followUpTitle": "三个接口已确认",
    "promptPrefix": "更新 POST /mate-service/v1/chats/{chatId}/events",
    "promptSuffix": "保持与三接口 1.4.2 契约、OpenAPI、Markdown 和 PlantUML/SVG 同步。"
  }
}
