' Source paths: modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/web/RuntimeSessionController.java.
' Source paths: modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/web/RuntimeEventController.java.
' Test paths: modules/coding-agent-cli/src/test/java/com/campusclaw/codingagent/runtimeapi/web/RuntimeHttpProcessOpenGaussIT.java.
' Observed behavior: route tests and opt-in process/OpenGauss integration tests exist, but default CI only runs Maven verify.
' Design reason: deterministic contract and state oracles must remain authoritative while the agent plans, launches, and maintains tests.
' Pending implementation: recommended test-platform assembly; implementation evidence remains scoped to the baseline.

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #475569
top to bottom direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 35
skinparam component {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
title Runtime HTTP Test Adapter - Target Structure
actor "CI / Developer" as Trigger
package "Inputs and planning" {
  [Baseline Resolver] as Baseline
  [Contract Extractor] as Extractor
  [Change Impact Analyzer] as Impact
  [Test Planner] as Planner
  artifact "Immutable test plan" as Plan
}
package "Execution" {
  [Environment Provisioner] as Env
  [Test Executor] as Executor
  [Deterministic Oracle] as Oracle
}
package "Test boundaries" {
  node "Isolated environment\nJAR / openGauss / model stub\nAgent fixture / local ports" as Environment
  [HTTP and state layers\nL0-L6 adapters] as Layers
}
package "Evidence and maintenance" {
  artifact "Evidence bundle" as Evidence
  [Case Maintenance Proposer] as Maintainer
  artifact "Verdict / catalog proposal" as Result
}
artifact "Pinned Git commits" as Git
artifact "Historical HTTP 1.37\nreview model + case catalog" as Contract

Trigger --> Baseline
Git --> Baseline
Contract --> Extractor
Baseline --> Impact
Extractor --> Impact
Impact --> Planner
Planner --> Plan
Plan --> Env
Plan --> Executor
Env --> Environment
Env -[hidden]down-> Executor
Executor -[hidden]down-> Oracle
Executor --> Layers
Layers --> Environment : run against
Layers -down-> Oracle : results
Oracle --> Evidence
Oracle --> Result : deterministic verdict
Impact --> Maintainer : contract / coverage gap
Evidence --> Maintainer
Maintainer --> Result : reviewable proposal

legend bottom left
Historical contract adapter; current Runtime migration is a separate requirement.
The immutable plan retains every P0 invariant; unknown impact selects all layers.
Required environment and tests must run; skip never means pass.
The Agent can propose cases; checked-in assertions determine the verdict.
Grouped environments and layers are collaborators, not replacement classes.
endlegend
@enduml

