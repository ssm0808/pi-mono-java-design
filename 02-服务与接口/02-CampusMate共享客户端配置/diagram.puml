@startuml campusmate_client_target_classes
' Java 基线：628dca25a694d9d056b15f012e1223d68091ab66；2026-10-21 拉取 main。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/config/CampusMateClientProperties.java Endpoints（待删除）。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/util/MateRestUtil.java（待删除）。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtime/MateServiceClient.java send（迁入通道）。
' 源码：modules/ai/src/main/java/com/campusclaw/ai/provider/mate/CampusMateProvider.java validateChatPath（待删除）。
' 目标：待实现；接口目录与地址放 common，短请求通道放 coding-agent-cli，三个业务客户端只依赖通道。
' 依赖方向：common <- ai <- agent-core <- coding-agent-cli；ai 不依赖 coding-agent-cli，所以目录必须在 common。
' 基线：Codex Provider + EndpointSession；Anthropic Java SDK ClientOptions + 各 Service。
title CampusMate 客户端：全局目标类图
skinparam backgroundColor white
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50

package "common" as CommonPkg {
  enum CampusMateOperation <<待实现>> {
    MODEL_CHAT
    AGENT_INFO
    AGENT_RUNTIME
    SKILL_INFO
    TOOL_METADATA_QUERY
    TOOL_EXECUTE
    SCHEDULED_ACCESS_TOKEN
    + method() : String
    + pathTemplate() : String
  }
  class CampusMateOrigin <<待实现>> {
    - origin : URI
    + {static} of(baseUrl) : CampusMateOrigin
    + resolve(operation, pathValues...) : URI
  }
}

package "ai" as AiPkg {
  class CampusMateProvider {
    - endpoint : URI
    - webClient : WebClient
    + stream(model, context, options)
  }
}

package "coding-agent-cli：配置" as ConfigPkg {
  class CampusMateClientProperties <<record，改造>> {
    + baseUrl : CampusMateOrigin
    + http : Http
  }
  class "CampusMateClientProperties.Http" as HttpOptions <<record，待实现>> {
    + connectTimeout : Duration
    + requestTimeout : Duration
    + maxResponseBytes : int
  }
  class MateToolProperties <<改造>> {
    + enabled : boolean
    + executeTimeout : Duration
  }
}

package "coding-agent-cli：短请求通道" as ChannelPkg {
  class CampusMateHttpClient <<Spring 单例，待实现>> {
    - httpClient : HttpClient
    - origin : CampusMateOrigin
    + call(request) : JsonNode
  }
  class CampusMateRequest <<record，待实现>> {
    + operation : CampusMateOperation
    + pathValues : List<String>
    + body : String
    + headers : Map<String, String>
    + timeout : Duration
  }
  class CampusMateCallException <<待实现>> {
    + kind : FailureKind
    + resCode : String（仅非 2xx 时解析）
  }
  enum FailureKind <<待实现>> {
    UNREACHABLE
    REJECTED
    TOO_LARGE
    INVALID
  }
}

package "coding-agent-cli：业务客户端" as ClientPkg {
  class MateServiceClient <<改造>> {
    + getAgentRuntime(agentId) : AgentRuntime
    + querySkillInfo(skillId) : SkillInfo
  }
  class HttpMateToolClient <<改造>> {
    + listAgentTools(agentId) : List<MateToolMeta>
    + listSkillTools(skillId) : List<MateToolMeta>
    + callTool(toolId, args, credentials) : ToolResult
  }
  class MateAccessTokenClient <<改造>> {
    + accessToken() : String
  }
}

CampusMateOperation <-- CampusMateOrigin : 按目录生成地址
CampusMateProvider --> CampusMateOrigin : 校验地址
CampusMateProvider --> CampusMateOperation : MODEL_CHAT
CampusMateClientProperties *-- HttpOptions
CampusMateClientProperties --> CampusMateOrigin : 启动时校验
CampusMateHttpClient --> CampusMateClientProperties : 地址、超时、上限
CampusMateHttpClient ..> CampusMateRequest : 发送
CampusMateHttpClient ..> CampusMateCallException : 失败时抛出
CampusMateCallException *-- FailureKind
CampusMateRequest --> CampusMateOperation
MateServiceClient --> CampusMateHttpClient
HttpMateToolClient --> CampusMateHttpClient
MateAccessTokenClient --> CampusMateHttpClient
HttpMateToolClient ..> MateToolProperties : 工具执行超时

legend bottom
  通道统一判定：未收到响应或 5xx 为不可达，4xx 为被拒绝；超过响应上限为过大；非 JSON 对象为无效；成败只看 HTTP 状态，resCode 只进日志。
  模型推理保留自己的连接与超时（见 Model 专题第 5 节），只共用接口目录与地址。
  删除：MateRestUtil、CampusMateClientProperties.Endpoints（待实现）。
endlegend
