package "Startup configuration" {
  [campusmate.base-url] as Origin #DBEAFE
  [campusmate.endpoints] as Paths #DBEAFE
  [model / runtime / tool options] as Options
}
package "Independent clients" {
  [CampusMateProvider] as ChatClient
  [MateServiceClient] as RuntimeClient
  [HttpMateToolClient] as ToolClient
}
package "CampusMate - same origin" {
  [Chat] as Chat
  [Agent runtime] as Runtime
  [Shared Skill query] as Skill #DBEAFE
  [Agent info + Tool operations] as Tools
}
Origin --> Paths : join validated path
Paths --> ChatClient : model-chat-path
Paths --> RuntimeClient : agent-runtime / skill-info
Paths --> ToolClient : agent-info / skill-info / tools
Options ..> ChatClient : model options
Options ..> RuntimeClient : runtime options
Options ..> ToolClient : enabled
ChatClient --> Chat : POST / SSE
RuntimeClient --> Runtime : GET
RuntimeClient --> Skill : full Skill projection
ToolClient --> Skill : tool-binding projection
ToolClient --> Tools : discover / execute

note bottom of Skill
