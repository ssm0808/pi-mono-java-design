package "common" as CommonPkg {
  interface UpstreamOperation <<待实现，暂定名>> {
    + method() : String
    + pathTemplate() : String
  }
  enum CampusMateOperation <<待实现>> {
    MODEL_CHAT
    AGENT_INFO
    AGENT_RUNTIME
    SKILL_INFO
