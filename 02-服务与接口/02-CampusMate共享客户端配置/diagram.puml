@startuml campusmate_shared_base_url_configuration
title CampusMate Configuration and Endpoint Deduplication

' Source evidence baseline: pi-mono-java 320d790726a70aada6100052952d5494d2a378ac
' Local rename evidence: pi-mono-java f61906b9136246ca60f333704b6fc92b5420d0ec
' Target-only: rename the Provider; configuration keys and endpoint semantics stay unchanged.
' Source evidence:
' pi-mono-java modules/coding-agent-cli/src/main/resources/application.yml:89-140
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/provider/mate/MateServiceModelManagerProvider.java:68-76 and eventFlux
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtime/MateServiceClient.java:43-113 and 184-197
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/config/MateToolAutoConfiguration.java:31-81
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/HttpMateToolClient.java:41-190 and 299-320
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/dto/SkillInfoResult.java:12-20
' mate-service src/main/java/com/huawei/hicampus/mate/agentdefinition/controller/AgentDefinitionController.java:38-73
' mate-service src/main/java/com/huawei/hicampus/mate/agentdefinition/modelmanager/controller/LlmChatController.java:35-55
' Observed behavior: three configuration roots own three origins and seven path keys.
' Observed duplication: two keys normalize to GET /mate-service/v1/skill/query/{skillId}.
' Product constraint: Mate and CampusMate are one service identity.
' Architecture change: one campusmate tree owns one origin and six unique operation paths.
' Architecture change: target model options move from campusmate.model-manager to campusmate.model.
' Security hardening: endpoint paths cannot carry another origin.
' Target-only server scope: Skill and Tool controllers were not found in the analyzed mate-service baseline.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam componentStyle rectangle
skinparam component {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #475569
  FontColor #0F172A
}
skinparam ArrowColor #475569

rectangle "Historical Configuration (320d7907)\n3 service identities, 3 origins, 7 path keys" as Before {
  component "campusmate.model-manager\nbase-url\nchat-path" as OldModel #FFF7ED
  component "campusmate.runtime\nbase-url\nagent-runtime-path-template\nskill-info-query-path-template" as OldRuntime #FFF7ED
  component "mate\ninnerGWSerive\nagent-info-path-prefix\nskill-tools-query-path-prefix\ntool-metadata-query-path\ntool-execute-path-template\ntool.enabled" as OldTool #FEE2E2
  component "Duplicate operation\nGET /mate-service/v1/skill/query/{skillId}\nRuntime key + Tool key" as Duplicate #FECACA

  OldRuntime --> Duplicate : key A
  OldTool --> Duplicate : key B
}

rectangle "Target Configuration\n1 service identity, 1 origin, 6 unique operation paths" as After {
  component "campusmate.base-url\nCAMPUSMATE_BASE_URL" as BaseUrl #DCFCE7
  component "campusmate.endpoints\nmodel-chat-path\nagent-info-path-template\nagent-runtime-path-template\nskill-info-path-template\ntool-metadata-query-path\ntool-execute-path-template" as Endpoints #DCFCE7
  component "campusmate.model\nAPI, capability, SSE timeouts" as ModelOptions
  component "campusmate.runtime\ncache, short timeout, limits" as RuntimeOptions
  component "campusmate.tool.enabled" as ToolOptions
}

Before -down[#2563EB,dashed]-> After : unify service namespace\nand deduplicate Skill path

rectangle "CampusClaw Clients" {
  component "CampusMateProvider\n(target-only rename)" as ModelClient
  component "MateServiceClient" as RuntimeClient
  component "MateToolClient" as ToolClient
}

rectangle "CampusMate Service - Same Origin" {
  component "POST /mate-service/v1/LLM/chat" as ChatEndpoint
  component "Agent operations\nGET /mate-service/v1/agents/{agentId}\nGET /mate-service/v1/agents/{agentId}/runtime" as AgentEndpoints
  component "GET /mate-service/v1/skill/query/{skillId}" as SkillEndpoint #DBEAFE
  component "Tool operations\nPOST /mate-service/v1/runtime/tools/query\nPOST /mate-service/v1/runtime/tools/{toolId}/execute" as ToolEndpoints
}

BaseUrl --> ModelClient : shared origin
BaseUrl --> RuntimeClient : shared origin
BaseUrl --> ToolClient : shared origin
Endpoints --> ModelClient : model Chat path
Endpoints --> RuntimeClient : Agent Runtime + shared Skill path
Endpoints --> ToolClient : Agent info + shared Skill + Tool paths
ModelOptions --> ModelClient
RuntimeOptions --> RuntimeClient
ToolOptions --> ToolClient

ModelClient --> ChatEndpoint
RuntimeClient --> AgentEndpoints : Runtime projection
RuntimeClient --> SkillEndpoint : full Skill projection
ToolClient --> AgentEndpoints : bindingTools projection
ToolClient --> SkillEndpoint : bindingTools projection
ToolClient --> ToolEndpoints : metadata and execute

note bottom of SkillEndpoint
One HTTP operation and one configuration key.
Two clients may keep different DTO projections.
end note

note bottom of Endpoints
No top-level mate configuration remains.
No target campusmate.model-manager configuration remains.
Every ID path uses one %s template.
Paths start with /mate-service/ and contain no origin.
end note
@enduml
