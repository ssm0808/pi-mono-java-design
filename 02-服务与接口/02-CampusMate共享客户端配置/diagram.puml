    + resolve(operation, pathValues...) : URI
  }
}

package "ai" as AiPkg {
  class CampusMateProvider {
    - endpoint : URI
    - webClient : WebClient
    + stream(model, context, options)
  }
}

package "coding-agent-cli：配置" as ConfigPkg {
  class CampusMateClientProperties <<record，改造>> {
    + baseUrl : UpstreamOrigin
  }
  class CampusMcpClientProperties <<record，待实现，暂定名>> {
    + baseUrl : UpstreamOrigin
  }
  class "OutboundHttpProperties" as HttpOptions <<record，待实现>> {
