' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/provider/mate/CampusMateProvider.java: streamSimple, eventFlux, cancel
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/provider/mate/MateChatSseParser.java: accept, parseUsage, abort
' Observed behavior: CampusMateProvider is the current implementation name.
' pi-mono-java modules/agent-core/src/main/java/com/campusclaw/agent/loop/AgentLoop.java: invokeModel and consumeStream
' mate-service src/main/java/com/huawei/hicampus/mate/agentdefinition/modelmanager/controller/LlmChatController.java:35-55
' Observed behavior: POST /mate-service/v1/LLM/chat exists in the analyzed mate-service baseline.
' Product constraint: cancellation closes the foreground request and has no separate cancel operation.
' Architecture change: successful Chat SSE is returned without ResultBean or payload rewriting.

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #475569
title CampusMate Chat - One Invocation
hide footbox
skinparam maxMessageSize 210
skinparam sequenceMessageAlign left
skinparam sequence {
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #64748B
  LifeLineBorderColor #94A3B8
  GroupBorderColor #CBD5E1
  GroupBackgroundColor #F8FAFC
}
participant AgentLoop as Loop
participant "AI service / provider registry" as AI
participant CampusMateProvider as Provider
participant "Mate Chat\nvia internal gateway" as Mate

== 1. Select and prepare ==
Loop -> AI : stream(model, context, options)
AI -> AI : Resolve Provider identity
AI -> Provider : streamSimple(model, context, options)
Provider -> Provider : Validate and map text context
Provider --> AI : Per-call event stream
AI --> Loop : Event stream

== 2. Create foreground request ==
Provider -> Mate : POST /mate-service/v1/LLM/chat\nProtocol headers only
alt Rejected before SSE
  Mate --> Provider : HTTP error + ResultBean
  Provider --> Loop : ERROR (one terminal)
else SSE established
  Mate --> Provider : 200 text/event-stream
  loop While invocation is active
    Mate --> Provider : Original Chat chunk
    Provider -> Provider : Parse content, tools and usage
    Provider --> Loop : AssistantMessageEvent
  end

  == 3. End the invocation ==
  alt Normal completion
    Mate --> Provider : data: [DONE]
    Provider --> Loop : Final AssistantMessage
  else Caller cancels
    Loop -> Provider : Cancel stream
    Provider -> Mate : Close request and body
    Mate -> Mate : Stop upstream invocation
    Provider --> Loop : ABORTED (one terminal)
  else Stream fails
    Mate --> Provider : event:error; then close\nNo [DONE]
    Provider --> Loop : ERROR (one terminal)
  end
end

note over Loop,Provider
Tool execution remains in AgentLoop.
A completed, failed or cancelled call emits one terminal.
end note
note over Provider,Mate
No application credentials; no create replay after unknown outcome.
Mate owns upstream routing and cancellation propagation.
end note
@enduml

