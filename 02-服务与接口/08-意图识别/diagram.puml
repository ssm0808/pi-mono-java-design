  class "工具准备与执行边界\n待对齐集成" as Pipeline <<职责复用>> {
    解析与校验()
    授权及必要确认()
    放行执行并回传()
  }
  class "绑定 Child 委派\nAgent 工具" as Child <<已有可复用>>
  interface "Session 历史记录\n待对齐集成" as ClawRecords
  RuntimePort --> MainTask : 第一阶段全量／第二阶段深度
  RuntimePort --> Factory : 第二阶段指定 Agent 直达
  MainTask "1" *-- "1..*" TaskState : 维护任务与处理项
  MainTask --> Factory : 准备 MainAgent 执行
  Factory ..> Execution : 创建隔离 Session
  Execution --> Pipeline : 请求工具调用
  Pipeline --> Child : 直接绑定目标
  Child --> Factory : 创建 Child，结束关闭
  MainTask --> ClawRecords : 读取与记录
  Execution --> ClawRecords : 执行事实
  MainTask -[hidden]right-> TaskState
}
package "业务执行边界（部署不新增约定）" #F7F3E8 {
  interface "工具服务" as Business {
    执行业务并返回实际结果()
  }
}
Snapshot -[hidden]down-> RuntimePort
Legacy -[hidden]down-> RuntimePort
Router -down-> RuntimePort : 待实现集成
Router --> Legacy : 第二阶段直达／原实例接续
Pipeline -up-> LegacyBridge : 受控业务工具（待实现）
Pipeline -down-> Business : 放行后执行
Legacy -down-> Business : 校验及授权后执行
legend bottom
实线为目标依赖，菱形表示任务记录的生命周期归属；不是跨服务共享内存。
新职责标记待实现；已有类仅表示可复用，不代表任务编排、桥接或多等待已经完成。
Main/Child 共用内核但消息与工具实例隔离；直接绑定、禁止子级递归，无 Agent 池。
endlegend
@enduml

