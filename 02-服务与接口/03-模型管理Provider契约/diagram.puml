  class ApiProviderRegistry
  interface ApiProvider
  class ModelRegistry <<target-only>>
  class Model <<descriptor>>
}
package "CampusMate adapter - singleton" as Adapter {
  class CampusMateProvider <<target-only>> {
    id = campusmate
    auth = none
  }
  class MateChatRequestMapper
  class WebClient
}
package "Invocation state" as Call {
  class MateChatSseParser <<per call>>
  class AssistantMessageEventStream <<per call>>
}
package "Configuration and external I/O" as IO {
  class "campusmate.*" as Config <<startup config>>
  class "CampusMate Chat" as Chat <<external HTTP>>
}

