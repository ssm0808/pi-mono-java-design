{
  "operation": {
    "shortName": "创建会话",
    "operationKey": "createSession",
    "method": "POST",
    "path": "/agents/{agent_id}/sessions",
    "summary": "创建 Runtime Session",
    "description": "根据 agent_id 创建一个全新的 Runtime Session。CampusClaw 生成 session_id，直接从受控 agent/{agent_id}/.campusclaw/ 目录读取 settings.json、SYSTEM.md 和 skills/，解析并校验默认模型，然后完成 Session 持久化；AgentSession 在首次执行时惰性初始化。该操作无请求体，不调用模型、不启动执行，也不消耗 token；每次成功 POST 都创建新 Session，默认 thinking=true。",
    "parameters": [
      {
        "$ref": "parameters.agentId"
      },
      {
        "$ref": "parameters.acceptLanguage",
        "description": "错误消息语言；缺失或不支持时回退 en-US"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不接受 session_id、model_id 或 thinking。",
      "example": null
    },
    "responses": [
      {
        "status": "201",
        "label": "Created",
        "summary": "Session 已完成初始化和持久化，可以接受后续请求；初始 state=idle、thinking=true。",
