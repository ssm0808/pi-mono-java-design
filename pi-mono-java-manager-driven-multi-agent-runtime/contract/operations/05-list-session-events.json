{
  "operation": {
    "shortName": "查询会话事件",
    "operationKey": "listSessionEvents",
    "method": "GET",
    "path": "/sessions/{session_id}/events",
    "summary": "分页读取 Session 持久化事件",
    "description": "从与 POST 相同的 Events 集合路径分页读取当前 Session 分支中已经持久化的 user.message、assistant.message.completed 和 tool.result，不返回废弃分支或内部控制 Entry。GET 事件的 type 等于第四接口的 SSE event 名称，其余字段等于同一持久化 Entry 的 SSE data；started/delta、工具执行状态和流控制事件不会进入历史。示例明确使用 limit=3；next_page 是服务端签发的不透明游标，客户端只能原样回传，不得解析、修改或自行构造，下一页从 entry_seq=20 的最终 assistant.message.completed 继续。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": "integer 1..200; default 100",
        "description": "限制本页最多返回的持久化事件数量；下方成功示例使用 limit=3"
      },
      {
        "in": "query",
        "name": "page",
        "required": false,
        "schema": "opaque string",
        "description": "后续页原样使用上一响应的 next_page；第一页不传。客户端不得解析、修改或自行构造；游标只表示当前分支的继续位置，不包含固定历史上界"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。成功示例对应第一页 ?limit=3；后续请求原样传入上一响应的 next_page。limit 可在每页指定。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "summary": "以下为 limit=3 的第一页：按 entry_seq 从小到大返回三个持久化事件，next_page 指向 entry_seq=20；next_page=null 才表示响应时刻没有更多事件。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "en-US"
        },
        "bodies": {
          "en-US": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "events": [
                {
                  "type": "user.message",
                  "entry_id": "entry_100",
                  "entry_seq": 17,
                  "message": "请分析这些订单文件，并列出异常项。",
                  "file_ids": [
                    "file_01JY8X2E3R4T5Y6U7I8O9P0A1S"
                  ],
                  "created_at": "2026-08-17T10:00:00Z"
                },
                {
                  "type": "assistant.message.completed",
                  "entry_id": "entry_101",
                  "entry_seq": 18,
                  "message": {
                    "role": "assistant",
                    "content": [
