{
  "operation": {
    "shortName": "查询会话事件",
    "operationKey": "listSessionEvents",
    "method": "GET",
    "path": "/sessions/{session_id}/events",
    "summary": "分页读取 Session 持久化事件",
    "description": "从与 POST 相同的 Events 集合路径分页读取当前 Session 分支中的持久化事件。当前 Session thinking=true 时返回 user.message、assistant.thinking.completed、assistant.message.completed 和 tool.result；thinking=false 时过滤全部 assistant.thinking.completed。thinking started/delta、message preview、工具执行状态和流控制事件不进入历史。page 绑定签发时的 thinking 状态；开关改变后旧 page 无效，调用方必须从第一页重读。示例假设当前 thinking=true 且 limit=3，下一页从 entry_seq=20 的 tool.result 继续。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": "integer 1..200; default 100",
        "description": "限制本页最多返回的持久化事件数量；下方成功示例使用 limit=3"
      },
      {
        "in": "query",
        "name": "page",
        "required": false,
        "schema": "opaque string",
        "description": "后续页原样使用上一响应的 next_page；第一页不传。客户端不得解析、修改或自行构造；游标只表示当前分支的继续位置，不包含固定历史上界"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。成功示例对应第一页 ?limit=3；后续请求原样传入上一响应的 next_page。limit 可在每页指定。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "summary": "以下假设当前 Session thinking=true：limit=3 的第一页按 entry_seq 返回用户消息、完整 thinking 和完整 Assistant 消息，next_page 指向 entry_seq=20；thinking=false 时同一查询过滤 thinking 事件。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "en-US"
        },
        "bodies": {
          "en-US": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "events": [
                {
                  "type": "user.message",
