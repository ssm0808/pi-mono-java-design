{
  "operation": {
    "shortName": "查询可用模型",
    "operationKey": "listSessionModels",
    "method": "GET",
    "path": "/sessions/{session_id}/models",
    "summary": "列出 Session 当前可选模型",
    "description": "实时返回当前 Session 的 Agent 目录 allowlist 与 Runtime 当前可用模型的交集，用于模型选择器和切换前校验。结果保持 Agent enabledModels 的稳定顺序，不分页；models 直接使用 model_id 字符串数组，不保留无扩展字段的对象层。current_model_id 是 Session 已保存的当前模型；若管理员在 Session 创建后停用了该模型，它可以暂时不出现在 models 中。模型名称等展示信息由调用方自己的模型目录解析。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不支持 all、provider、page 或 capability 过滤参数。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "summary": "返回当前模型标识和实时可选模型；models 允许为空，且 current_model_id 不承诺一定出现在 models 中。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "en-US"
        },
        "bodies": {
          "en-US": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "current_model_id": "model_011CZq2GkV8aD4NwP7sLmXfR",
              "models": [
                "model_011CZq2GkV8aD4NwP7sLmXfR",
                "model_011CZq2GkV8aD4NwP7sLmXfS"
              ]
            }
          }
        }
      },
      {
        "status": "400",
        "label": "Bad Request",
        "summary": "session_id 不符合标识格式。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "session_id 格式不正确。"
          },
          "en-US": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "The session_id format is invalid."
          }
        }
      },
      {
        "status": "404",
        "label": "Not Found",
        "summary": "Session 不存在或已删除。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "SESSION_NOT_FOUND",
            "resMsg": "指定的 Session 不存在。"
          },
          "en-US": {
            "resCode": "SESSION_NOT_FOUND",
            "resMsg": "The specified Session does not exist."
          }
        }
      },
      {
        "status": "503",
        "label": "Service Unavailable",
        "summary": "Model Manager 暂时不可用，无法形成实时可选模型列表。",
        "headers": {
          "Content-Language": "zh-CN",
          "Retry-After": "3"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "MANAGER_UNAVAILABLE",
            "resMsg": "Model Manager 暂时不可用，请稍后重试。"
          },
          "en-US": {
            "resCode": "MANAGER_UNAVAILABLE",
            "resMsg": "Model Manager is temporarily unavailable. Try again later."
          }
        }
      }
    ]
  },
  "review": {
    "questions": [

    ]
  }
}
