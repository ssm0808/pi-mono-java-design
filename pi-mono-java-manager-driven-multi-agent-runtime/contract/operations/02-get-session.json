{
  "operation": {
    "shortName": "查询会话",
    "operationKey": "getSession",
    "method": "GET",
    "path": "/sessions/{session_id}",
    "summary": "读取 Session 当前资源",
    "description": "按 session_id 只读获取已存在 Session 的当前默认配置和粗粒度运行状态。该接口不创建或恢复 Session，不调用模型，也不实时校验 Model Manager。state 仅表达 Session 当前是 idle 还是 running；thinking 是是否对后续用户消息启用深度思考的布尔开关，不表示披露原始思考过程。",
    "parameters": [
      {
        "$ref": "parameters.sessionId",
        "description": "CampusClaw 生成的不透明 Session 标识；区分大小写，删除后不复用"
      },
      {
        "$ref": "parameters.acceptLanguage",
        "description": "错误消息语言；缺失或不支持时回退 en-US"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不接受 model_id、thinking 或恢复参数。",
      "example": null
    },
