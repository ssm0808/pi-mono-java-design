{
  "operation": {
    "shortName": "追加后续消息",
    "operationKey": "appendFollowUp",
    "method": "POST",
    "path": "/sessions/{session_id}/follow-ups",
    "summary": "向当前执行追加 FollowUp Message",
    "description": "仅在 Session 处于 running 时接受一条 FollowUp Message。服务端将其按接收顺序加入当前 active execution 的 FollowUp 队列；只有当前执行不再有工具调用或 Steering Message、原本将自然结束时，才把下一条 FollowUp 投递为新的用户消息并继续执行。成功只表示队列已接受，不创建公共 Run 或 FollowUp 资源；消息实际投递时才作为既有 user.message 写入当前分支并通过原 SSE 流发送。首版固定 one-at-a-time，且 FollowUp 的优先级低于 Steer。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": true,
      "contentType": "application/json",
      "description": "只接受 message；必须包含非空白字符且最多 262144 个字符。首版不接受 file_ids、model_id、thinking、metadata、队列模式或 Idempotency-Key。",
      "example": {
        "message": "分析完成后，再生成一份简短的管理层摘要。"
      }
    },
    "responses": [
      {
        "status": "202",
        "label": "Accepted",
        "summary": "FollowUp Message 已进入当前 active execution 的运行队列；尚未成为持久化 user.message。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "en-US"
        },
        "bodies": {
          "en-US": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "session_id": "session-550e8400e29b41d4a716446655440003",
              "accepted_at": "2026-08-17T15:11:00Z"
            }
          }
        }
      },
      {
        "id": "400-invalid-session-id",
        "status": "400",
        "tabLabel": "400 · INVALID_SESSION_ID",
        "label": "Bad Request",
        "summary": "session_id 不符合标识格式。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "session_id 格式不正确。"
          },
          "en-US": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "The session_id format is invalid."
          }
        }
      },
      {
        "id": "400-invalid-follow-up-request",
        "status": "400",
        "tabLabel": "400 · INVALID_FOLLOW_UP_REQUEST",
        "label": "Bad Request",
        "summary": "JSON 非法、message 缺失/空白/过长或包含未知字段。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "INVALID_FOLLOW_UP_REQUEST",
            "resMsg": "FollowUp Message 请求不符合约束。"
          },
          "en-US": {
            "resCode": "INVALID_FOLLOW_UP_REQUEST",
            "resMsg": "The FollowUp Message request is invalid."
          }
        }
      },
      {
        "status": "404",
        "label": "Not Found",
        "summary": "Session 不存在或已删除。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
