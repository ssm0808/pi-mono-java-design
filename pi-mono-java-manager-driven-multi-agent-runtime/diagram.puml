' Observed behavior: current inbound HTTP routes do not install an authentication adapter.
' Observed behavior: outbound A2A calls already send X-HW-ID and X-HW-APPKEY.
' Target-only company constraint: inbound JWT uses X-HW-ID and Authorization; APPKEY uses X-HW-ID and X-HW-APPKEY.
' Security hardening: mixed credentials are rejected and a failed verifier never falls back to another mode.
' Architecture change: both verifiers return one immutable CallerAuthContext for shared authorization.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam ArrowColor #475569
skinparam sequence {
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "Authorized internal caller" as Caller
participant "CredentialAuthenticationFilter" as Filter
participant "CredentialHeaderResolver" as Resolver
participant "JwtCredentialVerifier" as Jwt
participant "AppKeyCredentialVerifier" as AppKey
participant "AgentAuthorizationService" as Authorization
participant "SessionController" as Controller

Caller -> Filter : HTTP request
Filter -> Resolver : resolve X-HW-ID, Authorization, X-HW-APPKEY
Resolver -> Resolver : require exactly one complete credential pair

break Authorization and X-HW-APPKEY are both present
  Resolver --> Filter : AUTH_CREDENTIAL_CONFLICT
  Filter --> Caller : 401 ResultBean
end

break no complete credential pair
  Resolver --> Filter : UNAUTHENTICATED
  Filter --> Caller : 401 ResultBean
end

alt preferred JWT pair
  Resolver --> Filter : JwtCredentialInput
  Filter -> Jwt : verify with company JWT library
  Jwt --> Filter : CallerAuthContext or UNAUTHENTICATED
else compatible APPKEY pair
  Resolver --> Filter : AppKeyCredentialInput
  Filter -> AppKey : verify with company APPKEY library
  AppKey --> Filter : CallerAuthContext or UNAUTHENTICATED
end

break selected verifier rejects
  Filter --> Caller : 401 UNAUTHENTICATED\nno fallback
end

Filter -> Authorization : authorize immutable CallerAuthContext and agent_id
Authorization --> Filter : allowed
Filter -> Controller : authenticated request and CallerAuthContext
Controller --> Caller : operation-specific ResultBean

note over Resolver,AppKey
Header names are case-insensitive under HTTP.
Credential values remain opaque and are never logged,
persisted, copied into ResultBean, or passed to Session state.
end note
@enduml

