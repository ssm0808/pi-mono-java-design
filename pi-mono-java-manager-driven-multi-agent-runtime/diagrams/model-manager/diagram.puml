@startuml model_manager_streaming_flow
title Model Manager Provider Streaming Flow

' Source evidence (pi-mono 5cd93f688aaab89dbb6dfa4aca535f21796ae185):
' packages/ai/src/types.ts, Model, Context, AssistantMessageEvent, and Usage.
' packages/coding-agent/src/core/agent-session.ts, _checkCompaction and _runAutoCompaction.
' packages/coding-agent/src/core/compaction/compaction.ts, generateSummaryWithUsage.
' packages/ai/src/utils/overflow.ts, isContextOverflow and isRecoverableLength.
' Source evidence (pi-mono-java PR 167 f60cc3e78bb8b700527ac082c7c8e10524ede095):
' modules/ai/src/main/java/com/campusclaw/ai/provider/ApiProvider.java, ApiProvider.
' modules/ai/src/main/java/com/campusclaw/ai/provider/ApiProviderRegistry.java, ApiProviderRegistry.
' modules/ai/src/main/java/com/campusclaw/ai/types/SimpleStreamOptions.java, metadata.
' modules/ai/src/main/java/com/campusclaw/ai/stream/AssistantMessageEvent.java, event records.
' Observed behavior: Java dispatches by Model.api to a Spring-discovered ApiProvider.
' Architecture change: one MODEL_MANAGER Api routes every managed model through Model Manager.
' Design reason: model_id selects the model while agent_id authorizes it for the current Agent.
' Architecture change: ManagedAgentSession owns compaction calls and preserves their returned Usage.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam ArrowColor #475569
skinparam sequence {
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor Client
participant "ManagedAgentSession" as Session
participant "AgentLoop" as Loop
participant "CampusClawAiService" as AiService
participant "ApiProviderRegistry" as Registry
participant "ModelManagerApiProvider" as Provider
participant "Model Manager" as ModelManager

Client -> Session : prompt
Session -> Loop : prompt
Loop -> AiService : stream(model, Context, options)
AiService -> Registry : getProvider(MODEL_MANAGER)
Registry --> AiService : ModelManagerApiProvider
AiService -> Provider : streamSimple(model, Context, metadata)
Provider -> Provider : require immutable agent_id,\nsession_id, and Trace Context
Provider -> ModelManager : invoke(agent_id, model.id,\nContext, mapped options)
ModelManager -> ModelManager : revalidate Agent model binding

loop stream events
  ModelManager --> Provider : start, content delta,\ntool call, done or error
  Provider --> Loop : AssistantMessageEvent
end

opt a safe prepared threshold or overflow window exists
  Session -> AiService : completeSimple(model, summary Context, options)
  AiService -> Registry : getProvider(MODEL_MANAGER)
  Registry --> AiService : ModelManagerApiProvider
  AiService -> Provider : streamSimple(model, summary Context, metadata)
  Provider -> ModelManager : invoke authorized compaction request
  ModelManager --> Provider : completed summary with Usage
  Provider --> Session : full summary and Usage
  alt ERROR or LENGTH overflow and first recovery attempt
    Session -> Loop : continue execution once with compacted context
  else successful STOP overflow
    Session -> Session : preserve answer and do not replay
  end
end

alt Session-scoped abort
  Client -> Loop : POST /sessions/{sessionId}/abort
  Loop -> Provider : cancel model subscription
  Provider -> ModelManager : close stream
end

note over Provider,ModelManager
The Provider maps events only.
Tool execution remains in AgentLoop.
No fallback to built-in providers.
end note

note over Session,ModelManager
Compaction uses the same Agent model authority.
The returned input, output, cache, total token, and USD cost fields
are persisted with the compaction completion event.
Summary calls have no tools or cache and use a fresh routing ID.
end note
@enduml
