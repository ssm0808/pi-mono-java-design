' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/error/RuntimeApiException.java: RuntimeApiException
' modules/ai/src/main/java/com/campusclaw/ai/provider/mate/MateInvocationFailures.java: raise, record
' modules/ai/src/main/java/com/campusclaw/ai/provider/mate/MateModelInvocationException.java: MateModelInvocationException
' modules/ai/src/main/java/com/campusclaw/ai/provider/mate/MateChatSseParser.java: fail, streamFailure
