' Source evidence: pi@1a584a7a56eb5e7b4ff8ccbd46430f1533282eed
' packages/session-backends/sqlite-node/src/sqlite/session/branch-entries.ts:
' appendEntryToBranchIndex, readBranchSegmentsNewestFirst, scanBranchSegments.
' packages/session-backends/sqlite-node/src/sqlite/storage.ts: applyCommit.
' Source evidence: Java@fb842b1ac6cb4818f6b146f79dd184a5cd88bf12
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/
' persistence/MyBatisRuntimeSessionRepository.java: appendLocked, findEventPage.
' modules/coding-agent-cli/src/main/resources/mapper/session/RuntimeSessionMapper.xml:
' listCurrentBranchEntries, listCommittedEvents, countUnmappedCurrentBranchEntries.
' Observed behavior: Java appends at the locked tail but still reads recursive paths.
' Design reason: one append-only timeline needs ordered scans, not branch membership.
' Product constraint: no conversation editing, rewind, or branch switching.
' Pending implementation: ordered reads under append-only writes.

rectangle "WRITE REQUEST\nAppendEntryDTO" as request #DCEBFF

package "One GaussDB Transaction" as transaction {
  rectangle "1  CHECK CURRENT STATE\nBEGIN\nLock t_sessions FOR UPDATE\nRecheck execution and expected parent\nReject stale state" as stateCheck #FFE9CC

  rectangle "2  SEQUENCE ALLOCATION\nLock t_session_sequences FOR UPDATE\nAllocate the next entry_seq" as sequence #FFE9CC

  rectangle "3  APPEND MUTATION\nReject leaf, branch_summary, and label\nInsert entry with parent = expected parent\nIncrement activePath and usage as applicable" as append #E4F4E8

  rectangle "4  ATOMIC COMMIT\nAdvance next_seq\nPersist materialized payload\nMove active_leaf_id to the new entry\nCOMMIT" as commit #DCEBFF

  stateCheck --> sequence
  sequence --> append : append
  append --> commit
}

rectangle "FAIL CLOSED\nAny validation or DML failure rolls back the entire transaction.\nSequence, summary, and latest Entry remain unchanged." as rollback #FDE8E7

request --> stateCheck
rollback .up. transaction

note right of commit
Lock order is always:
1. t_sessions
2. t_session_sequences

External Tool side effects are not rolled back.
end note

@enduml

