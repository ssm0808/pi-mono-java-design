{
  "api": {
    "title": "MateService Model Manager Provider API",
    "version": "1.2.0-proposal",
    "basePath": "/mate-service/internal/v1",
    "visibility": "Internal · 接口字段待评审"
  },
  "operation": {
    "method": "GET",
    "path": "/models",
    "summary": "读取通用 Provider 的全局模型目录",
    "description": "为 pi-mono-java 的 MateServiceModelManagerProvider 提供不含 Agent 授权的全局安全模型描述，支持 ETag 条件读取。MateService 托管调用的资源模型已经确认，但本 operation 的字段仍是待后续评审的同步候选。",
    "authModes": [
      {
        "id": "jwt",
        "label": "JWT 首选",
        "preferred": true,
        "headers": [
          {
            "name": "X-HW-ID",
            "value": "<CALLER_ID>",
            "required": true,
            "description": "公司内部调用方标识"
          },
          {
            "name": "Authorization",
            "value": "Bearer <JWT>",
            "required": true,
            "description": "公司 JWT；不得与 X-HW-APPKEY 同时提供"
          }
        ]
      },
      {
        "id": "appkey",
        "label": "APPKEY 兼容",
        "preferred": false,
        "headers": [
          {
            "name": "X-HW-ID",
            "value": "<CALLER_ID>",
            "required": true,
            "description": "公司内部调用方标识"
          },
          {
            "name": "X-HW-APPKEY",
            "value": "<APPKEY>",
            "required": true,
            "description": "公司 APPKEY；不得与 Authorization 同时提供"
          }
        ]
      }
    ],
    "parameters": [
      {
        "in": "header",
        "name": "If-None-Match",
        "required": false,
        "schema": "strong ETag",
        "description": "上一次成功目录响应的 ETag；匹配当前 catalog revision 时返回 304"
      },
      {
        "in": "header",
        "name": "Accept-Language",
        "required": false,
        "schema": "zh-CN | en-US",
        "description": "错误消息语言；缺失或不支持时回退 en-US"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不接受 agentId、providerId、状态筛选或分页参数。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "summary": "返回当前全局安全模型描述，并携带强 ETag。",
        "headers": {
          "Content-Type": "application/json",
          "Content-Language": "en-US",
          "Cache-Control": "private, max-age=0, must-revalidate",
          "ETag": "\"model-catalog-42\""
        },
        "bodies": {
          "en-US": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "catalogRevision": 42,
              "models": [
                {
                  "modelId": "managed-coding-model",
                  "displayName": "Managed General Model",
                  "reasoningSupported": true,
                  "thinkingLevelMap": {
                    "off": "off",
                    "low": "low",
                    "medium": "medium",
                    "high": "high"
                  },
                  "inputModalities": [
                    "text",
                    "image"
                  ],
                  "cost": {
                    "input": 0,
                    "output": 0,
                    "cacheRead": 0,
                    "cacheWrite": 0
                  },
                  "contextWindow": 128000,
                  "maxOutputTokens": 8192,
                  "modelRevision": 7
                }
              ]
            }
          }
        }
      },
      {
        "status": "304",
        "label": "Not Modified",
        "summary": "目录 revision 未变化；无响应体，Provider 保留现有目录。",
        "headers": {
          "ETag": "\"model-catalog-42\"",
          "Cache-Control": "private, max-age=0, must-revalidate"
        },
        "bodies": {
          "default": "(no body)"
        }
      },
      {
        "id": "401-unauthenticated",
        "status": "401",
        "tabLabel": "401 · UNAUTHENTICATED",
        "label": "Unauthorized",
        "summary": "凭据缺失、不完整、无效或已过期。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "UNAUTHENTICATED",
            "resMsg": "调用方身份认证失败。"
          },
          "en-US": {
            "resCode": "UNAUTHENTICATED",
            "resMsg": "Caller authentication failed."
          }
        }
      },
      {
        "id": "401-auth-conflict",
        "status": "401",
        "tabLabel": "401 · AUTH_CREDENTIAL_CONFLICT",
        "label": "Unauthorized",
        "summary": "JWT 与 APPKEY 两组凭据同时出现。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "AUTH_CREDENTIAL_CONFLICT",
            "resMsg": "一次请求只能使用一种认证方式。"
          },
          "en-US": {
            "resCode": "AUTH_CREDENTIAL_CONFLICT",
            "resMsg": "Use exactly one authentication mode per request."
          }
        }
      },
      {
        "status": "403",
        "label": "Forbidden",
        "summary": "调用方已认证但没有读取 Model Manager 目录的权限。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "FORBIDDEN",
            "resMsg": "调用方无权访问模型目录。"
          },
          "en-US": {
            "resCode": "FORBIDDEN",
            "resMsg": "The caller is not allowed to access the model catalog."
          }
        }
      },
      {
        "status": "503",
        "label": "Service Unavailable",
        "summary": "目录存储或 Secret Store 暂时不可用；Provider 保留最后一次成功目录。",
        "headers": {
          "Content-Language": "zh-CN",
          "Retry-After": "3"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "MANAGER_UNAVAILABLE",
            "resMsg": "Model Manager 暂时不可用，请稍后重试。"
          },
          "en-US": {
            "resCode": "MANAGER_UNAVAILABLE",
            "resMsg": "Model Manager is temporarily unavailable. Try again later."
          }
        }
      }
    ]
  },
  "review": {
    "questions": [],
    "followUpTitle": "继续评审模型目录接口",
    "promptPrefix": "继续评审 GET /mate-service/internal/v1/models",
    "promptSuffix": "请只调整接口 1 的主维护 HTML、设计文档和结构化评审模型；不要改变已冻结的 Responses create/cancel 契约。"
  }
}
