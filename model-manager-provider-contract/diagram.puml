package "pi-mono-java Runtime" {
  [AgentLoop] as Loop
  [CampusClawAiService] as AiService
  [AiProviderRegistry] as Registry
  [MateServiceModelManagerProvider\nproviderId = mate-model-manager\napiId = openai-responses] as GenericProvider
  [ManagedModelCatalogClient] as CatalogClient
  [ManagedModelInvocationClient] as InvocationClient
}

package "mate-service" {
  [Internal Model Manager API] as ManagerApi
  [Agent Model Availability] as Availability
  [OpenAI Responses Transparent Proxy] as Router
  database "t_model_provider\nt_model_definition\nt_agent_binding_models" as Catalog
  [Secret Store] as Secrets
}

cloud "Upstream LLM Services" as Vendors
[Internal Gateway Trust Boundary] as Gateway

Loop --> AiService : model + Context + options
AiService --> Registry : get(model.providerId)
Registry --> GenericProvider
GenericProvider --> CatalogClient
GenericProvider --> InvocationClient
CatalogClient --> Gateway : HTTPS JSON and protocol headers
InvocationClient --> Gateway : Responses JSON and SSE
Gateway --> ManagerApi : no identity or credential headers
ManagerApi --> Availability : catalog operations 2 and 3 only
Availability --> Catalog
ManagerApi --> Router : exact Mate modelId\nand unchanged Responses body
Router --> Catalog
Router --> Secrets : credentialRef
Router --> Vendors : same Responses body and SSE\nmodel value patched

note bottom of GenericProvider
The Runtime sees one provider and opaque modelIds.
It never receives upstream credentials or endpoints.
Mate Provider authentication is ProviderAuth.none.
Other CampusMate APIs are outside this decision.
end note
@enduml

@startuml model_manager_invocation_sequence
title Mate OpenAI Responses Invocation and Cancellation

' Source evidence:
' pi-mono packages/ai/src/api/openai-responses.ts: stream and buildParams (lines 99-189 and 273-344)
' pi-mono packages/ai/src/api/openai-responses-shared.ts: convertResponsesMessages and processResponsesStream (lines 131-342 and 500-792)
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/provider/openai/OpenAIResponsesProvider.java: buildParams, handleResponseEvent, and convertInputItems
' pi-mono-java modules/agent-core/src/main/java/com/campusclaw/agent/loop/AgentLoop.java: invokeModel and consumeStream (lines 198-288)
' OpenAI API: POST /responses and POST /responses/{response_id}/cancel
' Target-only design: mate-service Responses create and foreground cancel operations do not exist yet.
' Product constraint: all five operations rely on internal gateway reachability and carry no application credentials or identity.
' Scope boundary: other CampusMate APIs are not covered by this no-auth decision.
' Transparent proxy rule: Provider performs the only Context conversion; Mate patches model but does not convert the Responses payload.
' OpenAI compatibility extension: Mate cancels active foreground streams although official cancel requires background=true.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam participant {
  BackgroundColor #F8FAFC
  BorderColor #475569
  FontColor #0F172A
}
skinparam ArrowColor #475569
skinparam sequence {
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor Client
participant "AgentLoop" as Loop
participant "CampusClawAiService" as AiService
participant "AiProviderRegistry" as Registry
participant "MateServiceModelManagerProvider" as Provider
participant "Internal Gateway" as Gateway
participant "mate-service Responses Proxy" as Manager
participant "OpenAI Responses Endpoint" as OpenAI

Client -> Loop : submit prompt
Loop -> AiService : stream(model, Context, options)
AiService -> Registry : get(model.providerId)
Registry --> AiService : generic Provider
AiService -> Provider : streamSimple(model, Context, options)
Provider -> Provider : convert Context once\nto a direct Responses request
Provider -> Gateway : POST /responses\nprotocol headers only
Gateway -> Manager : trusted internal route\nno app identity or credential
Manager -> Manager : validate without reshaping\nand resolve exact Mate modelId
Manager -> Manager : clone payload and patch model only\ninject endpoint and credential at HTTP layer
Manager -> OpenAI : POST /responses\nsame input, tools, reasoning, and options

loop OpenAI Responses SSE
  OpenAI --> Manager : Responses event
  Manager -> Manager : preserve event payload\nrewrite response.model only
  Manager --> Gateway : Responses event
  Gateway --> Provider : Responses event
  Provider -> Provider : store responseId and map event
  Provider --> Loop : AssistantMessageEvent
end

alt Abort after response.created
  Loop -> Provider : cancel subscription
  Provider -> Gateway : POST /responses/{responseId}/cancel
  Gateway -> Manager : trusted internal route
  Manager -> OpenAI : abort active foreground stream
  Manager --> Gateway : 200 Response with status cancelled
  Gateway --> Provider : 200 Response with status cancelled
  Manager --> Gateway : close original SSE
  Gateway --> Provider : close original SSE
  Provider --> Loop : StopReason.ABORTED
else Abort before response.created
  Loop -> Provider : cancel subscription
  Provider -> Gateway : close create stream
  Gateway -> Manager : close create stream
  Provider --> Loop : StopReason.ABORTED
else Response already terminal
  Provider -> Gateway : POST /responses/{responseId}/cancel
  Gateway -> Manager : trusted internal route
  Manager --> Gateway : 404 RESPONSE_NOT_ACTIVE
  Gateway --> Provider : 404 RESPONSE_NOT_ACTIVE
end

note over Provider,Manager
No automatic create POST replay after an unknown outcome.
No Responses-to-Chat or vendor protocol conversion in Mate.
Every routed upstream must support OpenAI Responses natively.
Cancellation emits no synthetic Responses terminal event.
Tool execution stays in AgentLoop.
end note
@enduml

@startuml java_provider_alignment
title Java Provider Alignment with pi-mono

' Source evidence:
