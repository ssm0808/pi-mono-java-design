' Design reason: a slow SSE client must not retain unbounded memory or control the run lifecycle.
@startuml bounded_sse_and_downstream
title Bounded Model Stream and SSE Slow-Consumer Isolation

skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #111827
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowColor #374151

cloud "Model Provider" as provider
component "Shared Model Client" as model_client

rectangle "Run-Local Path" {
  queue "Model Channel\n256 events AND 256 KiB" as model_channel
  component "Single Message Accumulator" as accumulator
  component "Typed Delta Coalescer\n50 ms OR 8 KiB" as coalescer
  database "Bounded Event Journal\nrun_seq and terminal" as journal
}

rectangle "Subscription-Local Path" {
  component "SSE Subscriber" as subscriber
  queue "Send Buffer\n1 MiB per subscription" as send_buffer
  component "Node Byte Budget\n64 MiB aggregate" as node_budget
  component "SSE Writer with timeout" as writer
}

database "RuntimeSessionStore\nterminal and history" as store
actor "Fast Client" as fast
actor "Slow Client" as slow

provider --> model_client : bounded streaming response
model_client --> model_channel : producer waits when full
model_channel --> accumulator : consume in order
accumulator --> coalescer : delta only
coalescer --> journal : ordered event
accumulator --> store : persist terminal first
store --> journal : terminal committed

journal --> subscriber : resume after run_seq
subscriber --> node_budget : reserve serialized bytes
node_budget --> send_buffer : budget granted
send_buffer --> writer : ordered SSE frame
writer --> fast : write succeeds
writer --> node_budget : release sent bytes

send_buffer --> slow : write cannot keep up
node_budget --> writer : local or node budget exhausted
writer --> slow : close only this subscription
writer --> subscriber : cancel subscription lease

note bottom of model_channel
  Model backpressure is independent
  from SSE client backpressure.
end note

note bottom of journal
  The run continues after disconnect.
  History remains authoritative after
  the bounded journal cursor expires.
end note
@enduml
