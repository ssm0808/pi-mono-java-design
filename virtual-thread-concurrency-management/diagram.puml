' Design reason: no accepted record or virtual thread may exist before capacity and persistence succeed.
@startuml run_admission_and_execution
title Run Admission, Execution, and Exact Lease Release

skinparam backgroundColor #FFFFFF
skinparam defaultFontColor #111827
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam sequenceMessageAlign center
skinparam ArrowColor #374151

actor "Internal HTTP Client" as client
participant "Run HTTP Resource" as http
participant "Session Run Slot" as slot
participant "Run Capacity Manager" as capacity
queue "Bounded PendingRun Queue" as queue
database "RuntimeSessionStore" as store
participant "Virtual-Thread Executor" as executor
participant "Agent Loop" as loop
participant "Phase Gates" as phase_gates
database "Event Journal" as journal

client -> http : POST run with Idempotency-Key
http -> http : authenticate, authorize, and validate
http -> slot : reserve ADMITTING

alt another run is active
  slot --> client : 409 RUN_ACTIVE
else run slot reserved
  slot -> capacity : acquire count and weighted bytes
  alt capacity is available
    capacity --> slot : idempotent RunLease
  else queue has item and byte capacity
    capacity -> queue : enqueue immutable PendingRun
    alt lease granted before timeout
      queue --> slot : RunLease
    else timeout or cancellation
      queue --> slot : admission rejected
      slot -> slot : clear ADMITTING
      slot --> client : 429 or 503 with Retry-After
    end
  else queue is full or runtime is shedding
    capacity --> slot : admission rejected
    slot -> slot : clear ADMITTING
    slot --> client : 429 or 503 with Retry-After
  end
end

slot -> store : atomically persist message, run, and idempotency result
store --> slot : accepted run identifier
slot --> client : 202 Accepted
slot -> executor : submit accepted run
executor -> loop : start one new virtual thread

loop -> phase_gates : acquire only the current resource lease
phase_gates --> loop : bounded result or timeout
loop -> store : persist terminal state first
store --> loop : terminal committed
loop -> journal : append terminal event
loop -> capacity : close RunLease exactly once
loop -> slot : ACTIVE to READY

note over capacity, queue
  Pending work stores descriptors only.
  It owns no run thread or downstream lease.
end note

note over loop, phase_gates
  Cancellation must close downstream I/O
  before all leases are released.
end note
@enduml

