package "Observed pi-mono" as PiObserved {
  class "ProtocolSessionSnapshot" as PiSnapshot <<observed_public>> {
    +id: string
    +createdAt: timestamp
    +updatedAt: timestamp
    +phase: SessionPhase
    +model: ModelRef
    +thinkingLevel: ThinkingLevel
    +revision: long
    +transcript: TranscriptItem[*]
    +queuedSteer: UserTranscriptItem[*]
    +queuedSteerCount: int
    +attached: boolean
    +locked: boolean
  }

  class "DurableRuntimeState" as PiDurable <<observed_internal>> {
    +operation: OperationState?
    +stepAttempt: StepAttempt?
    +toolBatch: ToolBatch?
    +pendingSteer: Entry[*]
    +pendingFollowUp: Entry[*]
    +pendingNextRun: Entry[*]
    +pendingWrites: Entry[*]
    +deferredHandle: DeferredHandle?
    +replayPolicy: ReplayPolicy
  }

  PiSnapshot .. PiDurable : public view is not checkpoint
}

package "Observed pi-mono-java" as JavaObserved {
  class "AgentStateSnapshot" as JavaState <<observed_process_local>> {
    +systemPrompt: string
    +model: Model
    +thinkingLevel: ThinkingLevel
    +tools: AgentTool[*]
    +messages: Message[*]
    +streaming: boolean
    +streamMessage: Message?
    +pendingToolCalls: string[*]
    +error: string?
  }

  class "CurrentWebSocketGetState" as JavaGetState <<observed_public_summary>> {
    +conversationId: string
    +isStreaming: boolean
    +model: string
    +thinkingLevel: string
    +messageCount: int
  }

  JavaState ..> JavaGetState : narrow live projection
}

package "CampusClaw target" as CampusTarget {
  class "ManagedSessionAggregate" as Session <<internal_target>> {
    +sessionId: SessionId
    +agentId: AgentId
    +agentVersion: string
    +bundleRevision: string
    +currentModelId: ModelId
    +thinking: ThinkingLevel
    +state: idle | running | deleting
    +activeRunId: RunId?
    +historySeq: long
    +revision: long
    +createdAt: timestamp
    +updatedAt: timestamp
    +deleteRequestedAt: timestamp?
  }

  class "RuntimeCheckpoint" as Checkpoint <<private_recovery>> {
    +runId: RunId
    +operation: OperationState
    +stepAttempt: StepAttempt
    +phase: RunPhase
    +streamMessage: Message?
    +openContents: OpenContent[*]
    +activeTools: ActiveTool[*]
    +queuedSteers: Steer[*]
    +pendingWrites: Entry[*]
    +recoveryHandle: RecoveryHandle?
  }

  class "MessageRecord" as MessageRecord <<owned_record>> {
    +messageId: MessageId
    +historySeq: long
    +status: MessageStatus
  }

  class "RunRecord" as RunRecord <<owned_record>> {
    +runId: RunId
    +modelId: ModelId
    +thinking: ThinkingLevel
    +state: RunState
    +outcome: RunOutcome?
  }

  class "IdempotencyRecord" as IdempotencyRecord <<owned_record>> {
    +key: string
    +requestHash: string
    +originalResult: object
  }

  class "RunEventEntry" as RunEvent <<owned_bounded_record>> {
    +runId: RunId
    +runSeq: long
    +safeEvent: object
  }

  class "AttachmentMetadata" as AttachmentMetadata <<owned_reference>> {
    +attachmentId: AttachmentId
    +safeMetadata: object
  }

  class "CreateSessionResponseVO" as CreateResult <<confirmed_public>> {
    +sessionId: SessionId
    +agentId: AgentId
    +modelId: ModelId
    +state: idle
    +thinking: ThinkingLevel
    +activeRun: null
    +createdAt: timestamp
  }

  class "GetSessionResponseVO" as GetSnapshot <<proposed_public>> {
    +sessionId: SessionId
    +agentId: AgentId
    +modelId: ModelId
    +thinking: ThinkingLevel
    +state: idle | running
    +historySeq: long
    +createdAt: timestamp
    +updatedAt: timestamp
  }

  class "ActiveRunResponseVO" as ActiveRun <<proposed_public>> {
    +runId: RunId
    +state: queued | running | aborting | suspended
    +phase: RunPhase
    +startedAt: timestamp
    +runSeq: long
    +modelId: ModelId
    +thinking: ThinkingLevel
    +messageSnapshot: StreamingMessage?
    +openContents: OpenContentProjection[*]
    +activeTools: ActiveToolProjection[*]
    +queuedSteers: QueuedSteerProjection[*]
  }

  class "SessionSnapshotProjector" as Projector <<target_service>> {
    +project(session, checkpoint): GetSessionResponseVO
  }

  Session "1" o-- "0..1" Checkpoint : private active state
  Session "1" o-- "0..*" MessageRecord : owns separately
  Session "1" o-- "0..*" RunRecord : owns separately
  Session "1" o-- "0..*" IdempotencyRecord : owns separately
  RunRecord "1" o-- "0..*" RunEvent : bounded journal
  Session "1" o-- "0..*" AttachmentMetadata : safe references
  Session ..> CreateResult : confirmed projection
  Session --> Projector
  Checkpoint --> Projector
  Projector --> GetSnapshot : atomic safe projection
  GetSnapshot "1" *-- "0..1" ActiveRun : null when idle
}

PiSnapshot ..> Projector : public snapshot evidence
PiDurable ..> Checkpoint : recovery evidence
JavaState ..> Projector : live state evidence

note right of Session
The Session identity does not include modelId.
Changing the default model keeps the same Session.
Each Run freezes its own modelId and thinking value.
end note

note right of GetSnapshot
The strong ETag identifies the complete public projection.
It changes with Session revision, active run sequence,
or history watermark. Full history remains paginated.
end note

note bottom of Checkpoint
Credentials, caller claims, system prompts, Java objects,
raw tool context, stack traces, and replay internals are
never part of the public snapshot.
end note
@enduml
