@startuml tool_system_architecture
title CampusClaw Tool System Target Architecture
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center

' Source evidence (CampusClaw d649866):
' modules/agent-core/src/main/java/com/campusclaw/agent/tool/AgentTool.java: AgentTool
' modules/agent-core/src/main/java/com/campusclaw/agent/tool/ToolExecutionPipeline.java: execute, executeAll
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java: initialize, configureRuntimeTools
' PR 167 f60cc3e: TUI/CLI removal diff deleted entry-independent session capabilities.
' Observed behavior: the current CLI session combines catalogs, reload, skills,
' delegation, and tool assembly; the Runtime path has separate assembly logic.
' Design reason: one closed factory and one light session factory keep all managed
' entry points aligned while Hosts retain their own persistence and lifecycle.

package "Managed Hosts" {
  [Runtime Host] as RuntimeHost
  [Cron Host] as CronHost
  [Child Execution Host] as ChildHost
}

package "Common Session Layer" {
  [AgentSessionFactory] as SessionFactory
  [ManagedAgentSession] as Session
  [SessionCompactor] as Compactor
  [ConfiguredToolAssembler] as Assembler
  [BuiltInToolFactory] as ToolFactory
  [ToolExecutionPipeline] as Pipeline
  [Immutable hook chain] as Hooks
}

package "Retained Source Only" {
  [SlashCommandRegistry] as Slash
  [/model /thinking /compact /name] as SlashHandlers
}

package "Active Built-in Tools" {
  [Read]
  [Find]
  [Grep]
  [Ls]
  [Cron]
  [ListMateTools]
  [CallMateTool]
  [Agent]
}

package "Shared Application Services" {
  [AgentRuntimeManager] as RuntimeManager
  [AgentWorkspaceBoundary] as Workspace
  [MateToolClient] as MateClient
  [MateToolResolutionCache] as MateCache
  [Cron Service] as CronService
  [SubagentExecutionService] as ChildService
}

RuntimeHost --> SessionFactory : RUNTIME
CronHost --> SessionFactory : CRON
ChildHost --> SessionFactory : CHILD_AGENT
SessionFactory --> RuntimeManager : prepare(agentId)
SessionFactory --> Workspace : create per session
SessionFactory --> Assembler : immutable context
Assembler --> ToolFactory
ToolFactory --> Read
ToolFactory --> Find
ToolFactory --> Grep
ToolFactory --> Ls
ToolFactory --> Cron
ToolFactory --> ListMateTools
ToolFactory --> CallMateTool
ToolFactory --> Agent
SessionFactory --> Session : new instance
Session --> Pipeline
Session --> Compactor : threshold and overflow
Pipeline --> Hooks
Slash --> SlashHandlers
ListMateTools --> MateClient
ListMateTools --> MateCache : update one source
CallMateTool --> MateCache : resolve by name
CallMateTool --> MateClient : discover or execute
Cron --> CronService
Agent --> ChildService
Read --> Workspace
Find --> Workspace
Grep --> Workspace
Ls --> Workspace

note bottom of ToolFactory
Only Read, Find, Grep, Ls, Cron,
ListMateTools, CallMateTool, Agent.
No dynamic catalog or extension tools.
end note

note bottom of Workspace
Root is agent/{agentId}.
Reject symlink and realpath escape.
end note

note bottom of Slash
No Host registration in version 1.
No HTTP route or message interception.
end note
@enduml

@startuml agent_session_assembly
title Three Entry Points Use One Session Assembly Contract
skinparam shadowing false

' Source evidence (CampusClaw d649866):
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtime/AgentRuntimeManager.java: prepare
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/runtime/RuntimeSessionEngineRegistry.java
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java: initialize
' Observed behavior: current entry paths do not share one small session factory.
' Design reason: parent and child use the same AgentSession type and factory but
' receive different instances, state, workspaces, tools, and cancellation scopes.

actor "Runtime request" as Runtime
actor "Cron trigger" as Cron
actor "Agent tool" as AgentTool
participant "Runtime Host" as RH
participant "Cron Host" as CH
participant "Child Execution Host" as EH
participant "AgentSessionFactory" as Factory
participant "AgentRuntimeManager" as Manager
participant "ConfiguredToolAssembler" as Tools
participant "ManagedAgentSession" as Session

alt Runtime execution
  Runtime -> RH : begin(agentId, sessionId)
  RH -> Factory : create(RUNTIME, agentId, context)
else Cron execution
  Cron -> CH : trigger(job.agentId)
  CH -> Factory : create(CRON, agentId, context)
else Child execution
  AgentTool -> EH : begin(boundChild, task)
  EH -> Factory : create(CHILD_AGENT, childAgentId, context)
end

Factory -> Manager : prepare(agentId)
Manager --> Factory : PreparedAgentRuntime
Factory -> Factory : resolve SYSTEM, models,\nworkspace, skill and child indexes
Factory -> Tools : assemble(entryPoint, immutableContext)
Tools --> Factory : new tool instances in profile order
Factory -> Session ++ : new ManagedAgentSession(state, tools, hooks, cancelScope)
Session --> Factory : ready
Factory --> RH : Runtime session instance
Factory --> CH : Cron session instance
Factory --> EH : Child session instance

note over RH,EH
Each Host restores or owns its own state,
events, progress, and close policy.
end note

note over Factory,Session
Same type, compaction, and assembly semantics.
Never the same Session instance.
end note
@enduml

@startuml managed_runtime_refresh
title Managed Runtime Prepare and Explicit Refresh
skinparam shadowing false

' Source evidence (CampusClaw d649866):
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtime/AgentRuntimeManager.java:
' prepare, materialize, isRuntimeComplete
' Observed behavior: current materialization writes the managed tree directly and
' generates references/tools.json.
' Design reason: candidate-tree publication prevents partial reads; explicit
' management refresh changes only future sessions and never tool configuration.

actor "Session Host" as Host
actor "Management workflow" as Admin
participant "AgentRuntimeManager" as Manager
participant "Per-agent lock" as Lock
participant "Mate directory client" as Mate
participant "Sibling candidate tree" as Candidate
database "Published agent/{agentId}" as Published

group prepare(agentId)
  Host -> Manager : prepare(agentId)
  Manager -> Published : validate complete tree
  alt cache is complete
    Published --> Manager : PreparedAgentRuntime
    Manager --> Host : immutable runtime snapshot
  else missing or incomplete
    Manager -> Lock : acquire(agentId)
    Manager -> Published : validate again
    alt another caller published a valid tree
      Published --> Manager : PreparedAgentRuntime
    else still invalid
      Manager -> Mate : fetch agent, settings, SYSTEM,\nskills, and direct children
      Mate --> Manager : source data
      Manager -> Candidate : write complete candidate
      Manager -> Candidate : validate names, IDs, versions,\nmodels, paths, and no symlinks
      alt candidate is valid
        Manager -> Published : atomic publish
      else build or validation failed
        Manager -> Candidate : discard candidate
        note right
        Keep the old published tree.
        end note
      end
    end
    Manager -> Lock : release
    Manager --> Host : runtime or explicit error
  end
end

group refresh(agentId)
  Admin -> Manager : refresh(agentId)
  Manager -> Lock : acquire(agentId)
  Manager -> Mate : force fetch complete directory source
  Mate --> Manager : source data
  Manager -> Candidate : build and validate
  alt valid
    Manager -> Published : atomic replace
    Manager --> Admin : refreshed runtime
  else failed
    Manager -> Candidate : discard candidate
    Manager --> Admin : error; old tree retained
  end
  Manager -> Lock : release
end

note over Published
No references/tools.json.
Existing sessions retain their snapshots.
New sessions use the published tree.
end note
@enduml

@startuml list_mate_tools_sequence
title ListMateTools Live Discovery
skinparam shadowing false

' Source evidence (CampusClaw d649866):
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/ListMateTool.java: execute
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/HttpMateToolClient.java
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/MateToolSessionCache.java: refresh
' Observed behavior: current List writes one flat name-to-ID map and Call depends
' on a prior successful List.
' Design reason: List remains live while a successful response updates only its
' source cache, so listing one Skill cannot erase tools from another source.

actor Model
participant "ListMateTools" as List
participant "SkillNameIndex" as Index
participant "MateToolClient" as Client
participant "Mate binding API" as Binding
participant "Mate metadata API" as Meta
participant "Session source cache" as Cache

Model -> List : {skillName?}
alt no skillName
  List -> Client : listAgentTools(currentAgentId)
  Client -> Binding : list ordered Agent tool IDs
  Binding --> Client : [toolId...]
  Client -> Meta : batch get metadata(toolIds)
  Meta --> Client : metadata by toolId
  Client -> Client : join by ID and restore binding order
  Client --> List : internal tool records
  List -> Cache : replace Agent source map
  List -> List : project scope={type:agent}
else exact direct Skill name
  List -> Index : resolve(skillName)
  Index --> List : skillId or error
  List -> Client : listSkillTools(skillId)
  Client -> Binding : list ordered Skill tool IDs
  Binding --> Client : [toolId...]
  Client -> Meta : batch get metadata(toolIds)
  Meta --> Client : metadata by toolId
  Client -> Client : join by ID and restore binding order
  Client --> List : internal tool records
  List -> Cache : replace this Skill source map
  List -> List : project scope={type:skill,name}
end
List --> Model : stable JSON: scope +\nname, description, inputSchema

note over List
Do not expose agentId, skillId, toolId,
permission, outputSchema, or execution mode.
Every List queries Mate.
end note
@enduml

@startuml call_mate_tool_sequence
title CallMateTool Name Resolution and Single-flight Refresh
skinparam shadowing false

' Source evidence (CampusClaw d649866):
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/CallMateTool.java: execute
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/mate/MateToolSessionCache.java
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/common/client/HttpMateToolClient.java: invokeTool
' Observed behavior: current Call fails when a prior List did not populate the
' name-to-ID cache.
' Design reason: a cache miss is resolved inside Call. Discovery may retry, but
' the actual Mate execution is sent at most once to avoid duplicated effects.

actor Model
participant "CallMateTool" as Call
participant "Session resolution cache" as Cache
participant "Session single-flight" as Flight
participant "MateToolClient" as Client
participant "Mate APIs" as Mate

Model -> Call : {tool, args?}
Call -> Cache : resolve(toolName)
alt cache hit
  Cache --> Call : toolId
else cache miss
  Cache --> Call : missing
  Call -> Flight : join or start full discovery
  activate Flight
  Flight -> Client : listAgentTools(currentAgentId)
  Client -> Mate : discover Agent tools
  Mate --> Client : ordered records
  Client --> Flight : Agent records
  loop every directly bound Skill
    Flight -> Client : listSkillTools(skillId)
    Client -> Mate : discover Skill tools
    Mate --> Client : ordered records
    Client --> Flight : Skill records
  end
  Flight -> Flight : merge all sources
  alt same name maps to different IDs
    Flight --> Call : discovery conflict
    Call --> Model : isError=true
  else every source succeeded
    Flight -> Cache : atomically replace full snapshot
    Flight --> Call : discovery complete
    Call -> Cache : resolve(toolName) again
    alt still missing
      Cache --> Call : missing
      Call --> Model : isError=true
    else resolved
      Cache --> Call : toolId
    end
  else discovery failed
    Flight --> Call : error; old snapshot retained
    Call --> Model : isError=true
  end
  deactivate Flight
end

opt one toolId was resolved
  Call -> Client : callTool(toolId, args or {}, context)
  Client -> Mate : execute exactly once
  Mate --> Client : result or error
  Client --> Call : result or error
  Call --> Model : ToolResultMessage
end

note over Mate
Never replay execute after timeout,
disconnect, or Mate error.
end note
@enduml

@startuml subagent_execution_sequence
title Direct Child Agent Execution Through Common SessionFactory
skinparam shadowing false

' Source evidence (CampusClaw d649866):
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/subagent/tool/SpawnAgentTool.java
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/delegation/InvokeAgentTool.java
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtime/TransientAgentRunner.java
' pi packages/coding-agent/examples/extensions/subagent/index.ts
' OpenCode packages/opencode/src/tool/task.ts
' Observed behavior: current code has separate spawn and invoke paths plus a
' session after-hook special case.
' Design reason: one Agent tool resolves direct bindings and delegates creation
' to the common AgentSessionFactory. Execution location is not a tool contract.

actor "Parent model" as Model
participant "Agent tool" as Agent
participant "BoundAgentResolver" as Resolver
participant "SubagentExecutionService" as Service
participant "AgentRuntimeManager" as Manager
participant "AgentSessionFactory" as Factory
participant "Child AgentSession" as Child
participant "Progress sink" as Progress

Model -> Agent : {agentName, task}
Agent -> Resolver : resolve direct binding
Resolver -> Resolver : validate exact name, self, enabled,\nversion, depth=1, and ancestry
Resolver --> Agent : BoundAgent or error
Agent -> Service : execute(boundAgent, task, parentContext)
Service -> Manager : prepare(childAgentId)
Manager --> Service : PreparedAgentRuntime
Service -> Service : validate fixed version and child model
Service -> Factory : create(CHILD_AGENT, childAgentId, context)
Factory --> Service : independent AgentSession instance
Service -> Child ++ : run task with empty child messages
loop high-level progress only
  Child -> Service : target, tool start/end, completion
  Service -> Progress : project progress
end
alt parent cancellation
  Agent -> Service : cancel
  Service -> Child : cancel child scope
  Child --> Service : cancelled
  Service --> Agent : cancellation error
else child completes
  Child --> Service : final non-empty Assistant text
  deactivate Child
  Service --> Agent : final text
end
Agent --> Model : ToolResultMessage

note over Factory,Child
Same AgentSession type and pipeline as the parent.
Separate messages, workspace, SYSTEM, tools,
cache, hooks, state, and cancellation scope.
end note
@enduml

@startuml tool_batch_scheduling
title Tool Batch Scheduling with Sequential Barriers
skinparam shadowing false

' Source evidence (CampusClaw d649866):
' modules/agent-core/src/main/java/com/campusclaw/agent/tool/AgentTool.java: AgentTool
' modules/agent-core/src/main/java/com/campusclaw/agent/tool/ToolExecutionPipeline.java: executeAll
' Observed behavior: the pipeline does not yet implement the target adjacent
' parallel-segment planner.
' Design reason: read-only tools may overlap, but Cron, Mate execution, and Child
' execution preserve their model order as explicit barriers.

participant "Batch planner" as Planner
participant "Virtual thread executor" as Executor
participant "Read call #1" as P1
participant "Grep call #2" as P2
participant "CallMateTool #3" as S3
participant "Find call #4" as P4
participant "Ls call #5" as P5
collections "Ordered results" as Results

Planner -> Planner : classify P, P, S, P, P
group first parallel segment
  Planner -> Executor : submit call #1
  Executor -> P1 : validate, hooks, execute
  Planner -> Executor : submit call #2
  Executor -> P2 : validate, hooks, execute
  P1 --> Executor : result #1
  P2 --> Executor : result #2
  Planner -> Executor : join segment
end
Planner -> S3 : execute sequential barrier
S3 --> Planner : result #3
group second parallel segment
  Planner -> Executor : submit call #4
  Executor -> P4 : validate, hooks, execute
  Planner -> Executor : submit call #5
  Executor -> P5 : validate, hooks, execute
  P4 --> Executor : result #4
  P5 --> Executor : result #5
  Planner -> Executor : join segment
end
Planner -> Results : store #1, #2, #3, #4, #5

note over Planner
PARALLEL: Read, Find, Grep, Ls, ListMateTools.
SEQUENTIAL: Cron, CallMateTool, Agent.
Results follow model call order, not completion order.
end note
@enduml

@startuml read_agent_workspace_isolation
title Agent Workspace Boundary for Local Read-only Tools
skinparam shadowing false

' Source evidence (CampusClaw d649866):
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/read/ReadTool.java
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/util/PathUtils.java
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/tool/bash/BashExecutor.java
' pi packages/coding-agent/src/core/tools/read.ts, find.ts, grep.ts, ls.ts
' Observed behavior: current Read checks cwd containment, while the remaining
' tools do not share one session-bound Agent root. Bash cwd is not a sandbox.
' Design reason: every local tool uses the same immutable root and rejects
' symlink or realpath escape. Command and write tools are never assembled.

actor Model
participant "Read / Find / Grep / Ls" as Tool
participant "WorkspacePathResolver" as Resolver
participant "AgentWorkspaceBoundary" as Boundary
participant "Read-only operations" as Operations
database "agent/{agentId}" as Root
database "agent/{otherAgentId}" as Other
database "External path" as External

Model -> Tool : path or search path
Tool -> Resolver : resolve and validate(requestPath)
Resolver -> Boundary : root + realRoot
Boundary --> Resolver : immutable current Agent root
Resolver -> Resolver : reject NUL and invalid path
Resolver -> Resolver : resolve relative path against root
Resolver -> Resolver : normalize lexical path
alt lexical path escapes root
  Resolver --> Tool : sanitized boundary error
  Tool --> Model : isError=true
else lexical path is inside root
  Resolver -> Root : inspect each existing component
  alt any component is a symlink
    Root --> Resolver : symlink
    Resolver --> Tool : sanitized boundary error
    Tool --> Model : isError=true
  else no symlink
    Root --> Resolver : realpath and file type
    alt realpath escapes or target type is invalid
      Resolver --> Tool : sanitized boundary error
      Tool --> Model : isError=true
    else valid target inside current Agent root
      Resolver --> Tool : ValidatedWorkspacePath
      Tool -> Operations : read, find, grep, or list
      Operations -> Root : access validated target
      Root --> Operations : data
      Operations --> Tool : bounded result
      Tool --> Model : ToolResultMessage
    end
  end
end

Root -[hidden]-> Other
Other -[hidden]-> External
note over Other
Never read sibling Agent data.
Do not expose its ID or path in errors.
end note
note over External
Absolute paths do not widen the boundary.
end note
@enduml

@startuml tui_capability_migration
title TUI and CLI Capability Migration Boundary
skinparam componentStyle rectangle
skinparam shadowing false

' Source evidence (CampusClaw PR 167 f60cc3e against d649866):
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/command
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/modes
' Observed behavior: the deleted package tree also owned compaction and Slash Command logic.
' Architecture change: classify by responsibility before deleting a product entry point.
' Design reason: shared session behavior must survive while terminal-only behavior is removed.

rectangle "Former TUI and CLI tree" as Old
package "Keep as host-neutral source" {
  [Slash core and registry] as Slash
  [/model /thinking /compact /name] as Handlers
  [Session operation port] as Port
}
package "Move to common session" {
  [Threshold compaction] as Threshold
  [Overflow compaction and one retry] as Overflow
  [Read file tracker] as Tracker
}
package "Delete" {
  [TUI components and launchers] as Tui
  [Interactive OneShot RPC ACP] as Modes
  [JSONL auth settings tree] as Local
  [Import export clipboard editor templates] as Terminal
  [PackageManager extensions themes shortcuts] as Packages
  [Loop OS cron installer notifications] as Legacy
}

Old --> Slash : keep
Slash --> Handlers
Handlers --> Port
Old --> Threshold : move
Old --> Overflow : move
Old --> Tracker : move
Old --> Tui : delete
Old --> Modes : delete
Old --> Local : delete
Old --> Terminal : delete
Old --> Packages : delete
Old --> Legacy : delete

note bottom of Port
Version 1 has no Host implementation.
Slash-looking HTTP messages stay user messages.
Name ownership remains in mate-service.
end note
@enduml

@startuml managed_session_compaction
title Common Session Compaction and Overflow Recovery
skinparam shadowing false

' Source evidence (pi 5cd93f6):
' packages/coding-agent/src/core/agent-session.ts: prompt and compaction recovery
' packages/coding-agent/src/core/compaction.ts: compaction preparation and summary
' Source evidence (CampusClaw PR 167 f60cc3e): shared compaction was removed with CLI sources.
' Target-only Java design: ManagedAgentSession and SessionCompactor own common behavior.
' Design reason: Runtime, Cron, and Child require one failure-safe context policy.

actor Host
participant "ManagedAgentSession" as Session
participant "Agent loop" as Agent
participant "SessionCompactor" as Compactor
participant "FileOperationTracker" as Tracker
participant "Model Manager" as Model
database "Append-only history" as History

Host -> Session : prompt(message)
Session -> Agent : execute
Agent --> Session : completed response or overflow error
alt context overflow and no prior recovery
  Session -> Session : remove failed Assistant from retry context
  Session -> Compactor : compact(reason=overflow, willRetry=true)
  Compactor -> Tracker : collect Read paths only
  Compactor -> Model : summarize old context
  alt summary succeeds
    Model --> Compactor : full summary and Usage
    Compactor --> Session : summary, retained messages, boundary
    Session -> Agent : replace context and retry once
    Agent --> Session : final result
    Session -> History : append compaction completed
  else summary fails
    Model --> Compactor : error
    Compactor --> Session : failed
    Session -> Session : retain old context
  end
else normal completion exceeds threshold
  Session -> Compactor : compact(reason=threshold, willRetry=false)
  Compactor -> Model : summarize old context
  alt summary succeeds
    Model --> Compactor : full summary and Usage
    Compactor --> Session : summary and retained messages
    Session -> History : append compaction completed
  else summary fails
    Session -> Session : retain old context
  end
end
Session --> Host : execution result

note over Session,Compactor
Defaults: enabled=true, reserveTokens=16384,
keepRecentTokens=20000. At most one recovery retry.
History entries are never deleted.
end note
@enduml

@startuml refresh_next_execution
title Refresh Affects the Next Idle Session Execution
skinparam shadowing false

' Source evidence (CampusClaw PR 167 f60cc3e): AgentRuntimeManager refresh and Runtime Session store.
' Target-only Java design: RuntimeSessionModelReconciler runs before accepting user.message.
' Architecture change: refresh does not mutate an active execution snapshot.
' Design reason: make directory publication atomic while preserving execution consistency.

actor Admin
actor Caller
participant "AgentRuntimeManager" as Runtime
database "Published Agent directory" as Directory
participant "RuntimeSessionModelReconciler" as Reconciler
participant "Model Manager" as Models
database "Session and Entry store" as Store
participant "Execution Host" as Host

Admin -> Runtime : refresh(agentId)
Runtime -> Directory : atomically publish validated tree
Runtime --> Admin : success
note over Host
Any active execution keeps its existing snapshot.
end note

Caller -> Reconciler : POST next user event for idle Session
Reconciler -> Directory : load latest bindingModels and default
Reconciler -> Models : resolve current model with credentials
alt current model remains callable
  Models --> Reconciler : current model
else current model is invalid
  Reconciler -> Models : resolve new default with credentials
  alt default is callable
    Models --> Reconciler : fallback model
    Reconciler -> Store : atomically update model and optional thinking
    Reconciler -> Store : append model and thinking changed entries
    Store --> Caller : project configuration events first
  else no callable default
    Models --> Reconciler : unavailable
    Reconciler --> Caller : reject before user.message
  end
end
Reconciler -> Store : accept user.message and mark running
Reconciler -> Host : start with reconciled immutable snapshot
@enduml
