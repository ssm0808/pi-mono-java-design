title Managed Runtime Prepare and Explicit Refresh

' Source evidence (CampusClaw d649866):
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtime/AgentRuntimeManager.java:
' prepare, materialize, isRuntimeComplete
' Observed behavior: current materialization writes the managed tree directly and
' generates references/tools.json.
' Design reason: candidate-tree publication prevents partial reads; explicit
' management refresh changes only future sessions and never tool configuration.

actor "Session Host" as Host
actor "Management workflow" as Admin
participant "Agent Runtime\nManager" as Manager
participant "Per-agent lock" as Lock
participant "Mate directory client" as Mate
participant "Sibling candidate tree" as Candidate
database "Published agent/{agentId}" as Published

group prepare(agentId)
  Host -> Manager : prepare(agentId)
  Manager -> Published : validate complete tree
  alt cache is complete
    Published --> Manager : PreparedAgentRuntime
    Manager --> Host : immutable runtime snapshot
  else missing or incomplete
    Manager -> Lock : acquire(agentId)
    Manager -> Published : validate again
    alt another caller published a valid tree
      Published --> Manager : PreparedAgentRuntime
    else still invalid
      Manager -> Mate : fetch agent, settings, SYSTEM,\nskills, and direct children
      Mate --> Manager : source data
      Manager -> Candidate : write complete candidate
      Manager -> Candidate : validate names, IDs, versions,\nmodels, paths, and no symlinks
      alt candidate is valid
        Manager -> Published : atomic publish
      else build or validation failed
        Manager -> Candidate : discard candidate
        note right
  Keep the old published tree.
        end note
      end
    end
    Manager -> Lock : release
    Manager --> Host : runtime or explicit error
  end
end

group refresh(agentId)
  Admin -> Manager : refresh(agentId)
  Manager -> Lock : acquire(agentId)
  Manager -> Mate : force fetch complete directory source
  Mate --> Manager : source data
  Manager -> Candidate : build and validate
  alt valid
    Manager -> Published : atomic replace
    Manager --> Admin : refreshed runtime
  else failed
    Manager -> Candidate : discard candidate
    Manager --> Admin : error; old tree retained
  end
  Manager -> Lock : release
end

note over Published
  No references/tools.json.
  Existing sessions retain their snapshots.
  New sessions use the published tree.
end note
@enduml

