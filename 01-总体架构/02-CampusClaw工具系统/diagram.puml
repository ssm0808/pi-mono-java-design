participant "Read call #1" as P1
participant "Grep call #2" as P2
participant "CallTool #3 [P]" as S3
participant "Find call #4" as P4
participant "Ls call #5" as P5
collections "Ordered results" as Results

Planner -> Planner : classify P, P, S, P, P
group first parallel segment
  Planner -> Executor : submit call #1
  Executor -> P1 : validate, hooks, execute
  Planner -> Executor : submit call #2
  Executor -> P2 : validate, hooks, execute
  P1 --> Executor : result #1
  P2 --> Executor : result #2
  Planner -> Executor : join segment
end
Planner -> S3 : execute sequential barrier
S3 --> Planner : result #3
group second parallel segment
  Planner -> Executor : submit call #4
  Executor -> P4 : validate, hooks, execute
  Planner -> Executor : submit call #5
  Executor -> P5 : validate, hooks, execute
  P4 --> Executor : result #4
  P5 --> Executor : result #5
  Planner -> Executor : join segment
end
Planner -> Results : store #1, #2, #3, #4, #5

