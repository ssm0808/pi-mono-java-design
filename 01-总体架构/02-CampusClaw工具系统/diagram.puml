participant "Agent Workspace\nBoundary" as Boundary
participant "Read-only operations" as Operations
database "agent/{agentId}" as Root

Model -> Tool : path or search path
Tool -> Resolver : resolve and validate(requestPath)
Resolver -> Boundary : root + realRoot
Boundary --> Resolver : immutable current Agent root
Resolver -> Resolver : reject NUL and invalid path
Resolver -> Resolver : resolve relative path against root
Resolver -> Resolver : normalize lexical path
alt lexical path escapes root
  Resolver --> Tool : sanitized boundary error
  Tool --> Model : isError=true
else lexical path is inside root
  Resolver -> Root : inspect each existing component
  alt any component is a symlink
    Root --> Resolver : symlink
    Resolver --> Tool : sanitized boundary error
    Tool --> Model : isError=true
  else no symlink
    Root --> Resolver : realpath and file type
    alt realpath escapes or target type is invalid
      Resolver --> Tool : sanitized boundary error
      Tool --> Model : isError=true
    else valid target inside current Agent root
      Resolver --> Tool : ValidatedWorkspacePath
      Tool -> Operations : read, find, grep, or list
      Operations -> Root : access validated target
      Root --> Operations : data
      Operations --> Tool : bounded result
      Tool --> Model : ToolResultMessage
    end
  end
end

note over Resolver,Root
  Reject sibling Agent and external paths.
  Errors never reveal their IDs or physical
  locations.
end note
@enduml

