' pi packages/coding-agent/examples/extensions/subagent/index.ts
' OpenCode packages/opencode/src/tool/task.ts
' Observed behavior: current code has separate spawn and invoke paths plus a
' session after-hook special case.
' Design reason: one Agent tool resolves direct bindings and delegates creation
' to the common AgentSessionFactory. Execution location is not a tool contract.

actor "Parent model" as Model
participant "Agent tool" as Agent
participant "BoundAgentResolver" as Resolver
participant "Subagent Execution\nService" as Service
participant "Agent Runtime\nManager" as Manager
participant "Agent Session\nFactory" as Factory
participant "Child AgentSession" as Child
participant "Progress sink" as Progress

== Validate direct binding ==
Model -> Agent : {agentName, task}
Agent -> Resolver : resolve direct binding
Resolver -> Resolver : validate exact name, self, enabled,\nversion, depth=1, and ancestry
Resolver --> Agent : BoundAgent or error
== Create an independent Child ==
Agent -> Service : execute(boundAgent, task, parentContext)
Service -> Manager : prepare(childAgentId)
Manager --> Service : PreparedAgentRuntime
Service -> Service : validate fixed version and child model
Service -> Factory : create(CHILD_AGENT, childAgentId, context)
Factory --> Service : independent AgentSession instance
== Run and project progress ==
Service -> Child ++ : run(task), empty messages
loop high-level progress only
  Child -> Service : target, tool start/end, completion
  Service -> Progress : project progress
end
alt parent cancellation
  Agent -> Service : cancel
  Service -> Child : cancel child scope
  Child --> Service : cancelled
  Service --> Agent : cancellation error
else child completes
  Child --> Service : final non-empty Assistant text
  deactivate Child
  Service --> Agent : final text
end
Agent --> Model : ToolResultMessage

note over Factory,Child
  Same AgentSession type and pipeline as the
  parent.
