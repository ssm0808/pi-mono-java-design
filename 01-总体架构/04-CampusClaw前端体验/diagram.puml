title Runtime Workbench - Target Classes
left to right direction
skinparam backgroundColor #FFFCFA
skinparam shadowing false
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #BFAEA5
skinparam packageBackgroundColor #F8F3F0
skinparam packageBorderColor #CDBEB6
skinparam ArrowColor #7A6F69
skinparam defaultFontName Arial
hide empty members
package "Browser page [target-only]" {
  class WorkbenchView <<view>>
  class Composer <<view>>
  class HeaderEditor <<DEV view>>
  class WorkbenchCoordinator <<page lifecycle>> {
    selectSession(id)
    setPinned(id, pinned)
    renameSession(id, displayName, etag)
    restoreIndex()
    submit(snapshot)
    stop(target)
  }
  class SessionViewState <<active Session>> {
    generation
    rootEventId
    terminal
    uncertainty
    primaryAction
  }
  class SessionIndexRepository <<persistent metadata>> {
    patchMetadata(entry)
    recordActivity(id, acceptedAt)
    setPinned(id, pinned)
  }
  class SessionIndexEntry <<browser-local>> {
    sessionId
    displayName
    lastActivityAt
    pinned
  }
  class RequestSnapshot <<immutable per request>>
  class DraftStore <<page memory>>
  class HeaderStore <<DEV page memory>>
  class TokenCoordinator <<DEV page lifecycle>>
  interface RuntimeGateway
  class RuntimeHttpGateway <<HTTP adapter>>
}
package "Local Vite serve process [target-only]" {
  class DevAuthMiddleware <<loopback boundary>>
  class AuthCenterClient <<HTTPS adapter>>
  class LocalAuthConfig <<server-only credentials>>
}
class "Browser localStorage\nSession metadata only" as Storage <<persistent resource>>
class "Runtime Session API\nexisting plus target Name API" as Runtime <<external API>>
class "AuthCenter\nlogin and Set-Cookie" as AuthCenter <<external API>>
WorkbenchView *-- Composer
WorkbenchView *-- HeaderEditor
WorkbenchView --> WorkbenchCoordinator
Composer --> WorkbenchCoordinator : send / stop / command
HeaderEditor --> HeaderStore
HeaderEditor --> TokenCoordinator : explicit get token
WorkbenchCoordinator *-- "1" SessionViewState
WorkbenchCoordinator *-- "0..*" RequestSnapshot
WorkbenchCoordinator *-- "1" DraftStore
WorkbenchCoordinator --> SessionIndexRepository : selection never reorders
SessionIndexRepository *-- "0..*" SessionIndexEntry
WorkbenchCoordinator --> HeaderStore : snapshot latest values
WorkbenchCoordinator --> RuntimeGateway : GET, events, and PUT name
RuntimeGateway <|.. RuntimeHttpGateway
RuntimeHttpGateway --> Runtime
SessionIndexRepository --> Storage : schema v2
TokenCoordinator --> HeaderStore : matching IP and edit revision
TokenCoordinator --> DevAuthMiddleware : same-origin JSON POST
DevAuthMiddleware --> AuthCenterClient
AuthCenterClient --> LocalAuthConfig
AuthCenterClient --> AuthCenter : fixed HTTPS login path
legend bottom left
  Header edits do not alter an existing snapshot.
  Reconciliation never replays a write request.
  Only create or accepted user activity changes recent order.
  Pinning changes the group, not lastActivityAt.
  DEV auth has no production or preview registration.
  Return accessToken only; no browser cookies.
endlegend
@enduml
