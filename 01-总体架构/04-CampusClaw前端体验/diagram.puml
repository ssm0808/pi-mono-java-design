  component "User and Assistant timeline\ncompleted replaces preview" as Timeline
  component "Thinking disclosure\noriginal plain text" as ThinkingView
  component "Tool activity\ninput above output" as Activity
  component "Confirmation state\nallow / deny / receipt pending" as Confirmation
  component "Business state\nseparate from connection" as State
}
UserEvents --> Reducer
Message --> Reducer
Thinking --> Reducer
Tool --> Reducer
Idle --> Reducer
Reducer --> Timeline : eventId
Reducer --> ThinkingView
Reducer --> Activity : toolCallId association
Reducer --> Confirmation : verify pending call
Reducer --> State : reliable current target only
note bottom of State
confirming is not ready.
Receipt is not tool success or termination.
EOF and empty history do not prove completion.
Missing target correlation keeps controls gated.
