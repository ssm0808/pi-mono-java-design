@startuml exception_architecture
' Java 基线：455445a4db136a58381f866e073a82d1f16ff1f1；2026-10-15 拉取 main。
' 源码：modules/agent-core/src/main/java/com/campusclaw/agent/error/StableErrorCode.java（待删除）。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/error/RuntimeApiException.java（待删除）。
' 目标：待实现；一个只带错误码的根异常（无 cause、无堆栈）、按模块的错误码枚举、唯一保留的载荷子类和三个投影入口。
' 依赖方向：common <- ai <- agent-core <- cron <- coding-agent-cli，根异常和接口放在 common。
title 异常与错误码：全局目标类图
skinparam backgroundColor white
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 45

package "common（待实现）" as CommonPkg {
  interface ErrorCode <<待实现>> {
    + name() : String
  }
  class CampusClawException <<待实现>> {
    - errorCode : ErrorCode
    - publicDetail : String
    + CampusClawException(code)

    + CampusClawException(code, diagnostic)
    + {static} visible(code, publicDetail) : CampusClawException
    + errorCode() : ErrorCode
    + code() : String
    + publicDetail() : Optional<String>
    + hasCode(code) : boolean
  }
}

