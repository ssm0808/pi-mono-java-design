  }
  enum RuntimeErrorCode <<实现 ErrorCode：待实现>> {
    - httpStatus : HttpStatus
    - retryAfter : Duration
    + isApiError(e) : boolean
  }
  class RuntimeExceptionHandler {
    + handle(CampusClawException) : ResponseEntity
  }
