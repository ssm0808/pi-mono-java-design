title 智能体本地目录的目标类图

package "使用方" {
  class FileAgentDirectoryResolver <<HTTP 会话与命令>> {
    +resolve(agentId) : AgentDirectorySnapshotDTO
    +prepare(agentId) : PreparedAgentRuntime
  }
  class AgentSessionFactory <<Runtime、定时执行、Subagent>> {
    +create(request) : 会话
  }
  class "Help、技能命令" as CachedReaders <<只读>> {
    只读本地副本，不访问 Mate
  }
}

package "目录管理（Spring 单例）" {
  class AgentRuntimeManager {
    -locks : 每个智能体一把锁
    +prepare(agentId) : PreparedAgentRuntime
    +prepareCached(agentId) : PreparedAgentRuntime
    -rebuild(agentId, agentRoot)
    -publish(agentId, agentRoot, staging)
    -requireAgentRoot(agentId) : Path
  }
  class RuntimeAgentPromptLoader {
    +loadSnapshot(dir) : AgentPromptSnapshotDTO
    +loadOverrides(dir) : PLAN.md、BUILD.md
  }
  class SkillLoader {
    按会话同一规则校验技能
  }
}

package "外部" {
  interface MateServiceClient {
    +getAgentRuntime(agentId) : AgentRuntime
    +querySkillInfo(skillId) : SkillInfo
  }
}

package "已解析快照（每次准备新建，不可变）" {
  class PreparedAgentRuntime <<record>> {
    agentId
    agentRoot
    metadata : AgentRuntime
    skills : List<SkillInfo>
    prompts : AgentPromptSnapshotDTO
  }
}

package "Claw 节点本地磁盘：agent/{agentId}/.campusclaw/" as LocalDir {
  class "agent.json" as AgentFile <<文件>> {
    身份、名称、版本、enabled、介绍
  }
  class "settings.json" as SettingsFile <<文件>> {
    schemaVersion=1
    mode
    bindingTools
    不含模型（待实现）
  }
  class "SYSTEM.md" as SystemFile <<文件>> {
    系统提示
  }
  class "PLAN.md / BUILD.md" as ModeFiles <<业务部署，可选>>
  class "agents/{name}.json" as SubagentFile <<文件>> {
    Subagent 身份与固定版本
  }
  class "skills/{name}/" as SkillDir <<目录>> {
    skill.json、SKILL.md
    references/、templates/
  }
}

FileAgentDirectoryResolver --> AgentRuntimeManager : prepare
AgentSessionFactory --> AgentRuntimeManager : prepare
CachedReaders --> AgentRuntimeManager : prepareCached
AgentRuntimeManager --> MateServiceClient : 目录缺失或不完整时
AgentRuntimeManager --> RuntimeAgentPromptLoader
AgentRuntimeManager --> SkillLoader
AgentRuntimeManager ..> PreparedAgentRuntime : 创建
AgentRuntimeManager --> LocalDir : 校验读取、整体替换
RuntimeAgentPromptLoader --> ModeFiles : 只读并在重建时保留

note bottom of PreparedAgentRuntime
  会话、定时执行和 Subagent 各自固定一份；
  本地目录之后被替换，不影响已固定的快照。
end note
@enduml
