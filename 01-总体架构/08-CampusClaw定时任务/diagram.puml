@startuml scheduled_task_architecture
' 实现：superheromeZzh/pi-mono-java PR #332，codex/scheduled-task-backend bdd3af99，核对日期 2026-10-15。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/schedule/dispatch/ScheduleRunLauncher.java handleRunRequest、createAutomaticRun、startAutomaticRun。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/schedule/session/ScheduledSessionStarter.java prepare、acceptSession、startExecution、requestStop。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/runtime/RuntimeActiveExecution.java bindSafetyContext。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/ExecutionSafetyContext.java beforeHook、resolveCredentials。
' 源码：modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/schedule/application/ScheduleRunPublisher.java requestRun。
' 设计原因：立即运行经进程内事件到达 Run 启动器，避免 Runtime 装配构造依赖环。
' 设计原因：服务直接使用 ScheduleMapper 收发 DTO，不另设仓储接口。
' 产品约束：每次 Run 使用关联的 Agent 定义新建 Session；定时执行非交互。
title 定时任务：全局目标类图
!pragma layout elk
top to bottom direction
set separator none
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle

package "入口（schedule.web / tool.cron）" as EntryPkg {
  class ScheduleController <<单例>> {
    + create(grant, request) : ScheduleResponseVO
    + applyAction(id, run|pause|unpause)
    + listRuns(grant, filters) : ScheduleRunListResponseVO
  }
  class CronTool <<每个 Session>> {
    + execute(list | status | runs)
  }
}

package "应用服务（schedule.application）· 单例" as AppPkg {
  class ScheduleService {
    + create / update / delete(grant, ...)
    + pause / unpause(grant, id)
  }
  class ScheduleRunService {
    + runNow(grant, id) : ScheduleRunResponseVO
    + getRun / listRuns(grant, ...)
  }
  class ScheduleRunPublisher {
    + requestRun(grant, scheduleId) : ScheduleRunDTO
  }
  class ScheduleCronCalculator {
    + normalizeRule(rule, now)
    + nextRunAt(cron, timezone, after)
  }
}

package "调度（schedule.dispatch）· 单例" as DispatchPkg {
  class ScheduleTriggerWorker {
    + triggerDueSchedules()
    + deleteExpiredRuns()
  }
  class ScheduleRunLauncher {
    + handleRunRequest(event)
    + createAutomaticRun(schedule, now)
    + startAutomaticRun(claimed)
  }
  class ScheduleRunTerminalHook {
    + onTerminal(target, reason, at)
  }
}

package "定时 Session 创建（schedule.session）" as StarterPkg {
  class ScheduledSessionStarter <<单例>> {
    + prepare(request, deadline) : PreparedScheduledSessionDTO
    + acceptSession(prepared, prompt) : ScheduledSessionReceiptDTO
    + startExecution(prepared, receipt)
    + requestStop(receipt)
  }
  class PreparedScheduledSessionDTO <<每次 Run>> {
    - request : ScheduledSessionRequestDTO
    - session : RuntimeSessionDTO
    - execution : RuntimeActiveExecution
  }
}

package "Runtime（runtimeapi / session）· 既有" as RuntimePkg {
  class RuntimeExecutionCoordinator <<单例>> {
    + start(execution)
  }
  class RuntimeActiveExecution <<每次 Run>> {
    + bindSafetyContext(context)
  }
  class ExecutionSafetyContext <<每次 Run · 仅内存>> {
    - scheduleId / runId / agentId
    + beforeHook(runtime) : 非交互门禁
    + resolveCredentials(agentId, toolId)
  }
  interface ExecutionTerminalHook {
    + onTerminal(target, reason, at)
  }
}

package "Mate 对接（schedule.authorization / schedule.mate）" as MatePkg {
  interface ScheduleSessionRegistry {
    + registerSession(registration)
  }
  interface ScheduleAccessTokenProvider {
    + accessToken() : String
  }
  class MateScheduleSessionRegistry
  class MateAccessTokenClient
}

package "持久化（schedule.persistence）" as PersistPkg {
  interface ScheduleMapper {
    + lockSchedule(id) : ScheduleDTO
    + insertRun(run) / updateRun(run)
    + finishRunByExecution(executionId, at)
  }
  class ScheduleDTO <<持久化对象>>
  class ScheduleRunDTO <<持久化对象>>
}

ScheduleController --> ScheduleService
ScheduleController --> ScheduleRunService
CronTool ..> ScheduleService : 只读
CronTool ..> ScheduleRunService : 只读
ScheduleService --> ScheduleCronCalculator
ScheduleRunService --> ScheduleRunPublisher
ScheduleRunPublisher ..> ScheduleRunLauncher : <<事件>>\nScheduleRunRequestEvent
ScheduleTriggerWorker --> ScheduleRunLauncher : 到期任务
ScheduleRunLauncher --> ScheduledSessionStarter
ScheduledSessionStarter ..> PreparedScheduledSessionDTO : <<创建>>
PreparedScheduledSessionDTO *-- "1" RuntimeActiveExecution
RuntimeActiveExecution o-- "0..1" ExecutionSafetyContext
ScheduledSessionStarter --> RuntimeExecutionCoordinator : 提交后启动
RuntimeExecutionCoordinator --> RuntimeActiveExecution
ScheduledSessionStarter --> ScheduleSessionRegistry
ExecutionSafetyContext --> ScheduleAccessTokenProvider : 每批工具一次
ScheduleRunTerminalHook ..|> ExecutionTerminalHook
MateScheduleSessionRegistry ..|> ScheduleSessionRegistry
MateAccessTokenClient ..|> ScheduleAccessTokenProvider
ScheduleService --> ScheduleMapper
ScheduleRunLauncher --> ScheduleMapper
ScheduleTriggerWorker --> ScheduleMapper
ScheduleRunTerminalHook --> ScheduleMapper
ScheduleMapper ..> ScheduleDTO
ScheduleMapper ..> ScheduleRunDTO
ScheduleDTO "1" o-- "0..*" ScheduleRunDTO


legend bottom left
Mate 管理入口经服务认证调用 ScheduleController；MateScheduleSessionRegistry 与 MateAccessTokenClient 调用 Mate 服务。
单例不持有单次 Run 状态；PreparedScheduledSessionDTO、RuntimeActiveExecution、ExecutionSafetyContext 按 Run 创建。
ScheduleRunService 查询 Run 同样经 ScheduleMapper；ScheduledSessionStarter 在同一事务写入 Session、首条消息与根执行。
endlegend
@enduml

