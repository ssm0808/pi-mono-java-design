{
  "operation": {
    "shortName": "查询 Skill 每日加载次数",
    "operationKey": "getSkillLoadDailyStatistics",
    "method": "GET",
    "path": "/skills/{skillId}/load-statistics/daily",
    "summary": "查看一个 Skill 近 7/30 天的逐日加载趋势",
    "description": "路径 skillId 来自统计列表或已知 Skill，用于定位单项统计详情。先检查累计统计资源，再在同一 SQL 快照中按自然日补齐 7/30 项；零值只代表该日无记账。没有累计统计资源返回 404，不据此断言 Skill 主数据不存在。本接口为全文加载口径候选，target-only，口径待评审；不是实施基线。",
    "parameters": [
      {
        "name": "skillId",
        "schema": "^skill-[0-9a-fA-F]{32}$",
        "description": "Skill 标识；精确匹配，不归一大小写。只校验格式和统计资源，不查询远端 Skill 目录。",
        "in": "path",
        "required": true
      },
      {
        "name": "period",
        "schema": "7d | 30d; default 7d",
        "description": "近 7/30 个自然日，包含今天；不接受 all。",
        "in": "query",
        "required": false
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。示例：?period=7d；不分页。",
      "example": null
    },
    "responses": [
      {
        "id": "200-daily",
        "status": "200",
        "tabLabel": "200 · 近 7 天趋势",
        "label": "OK",
        "summary": "近 7 天趋势：period=7d；连续 7 项按日期升序，合计 12。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "en-US"
        },
