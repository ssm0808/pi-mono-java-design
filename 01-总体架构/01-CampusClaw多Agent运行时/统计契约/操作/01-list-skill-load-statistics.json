{
  "operation": {
    "shortName": "查询 Skill 加载排名",
    "operationKey": "listSkillLoadStatistics",
    "method": "GET",
    "path": "/skills/load-statistics",
    "summary": "直接分页查询累计或近 7/30 天 Skill 加载统计",
    "description": "无需 skillIds。服务端确定统计窗口、汇总、排序后分页；只返回窗口内次数大于零的 Skill。累计查累计表，近 7/30 天查日汇总。统计集合不是全部 Skill 目录，名称及目录权限由 CampusMate 维护。本接口为 target-only 推荐方案。",
    "parameters": [
      {
        "name": "period",
        "schema": "all | 7d | 30d; default all",
        "description": "累计、近 7 个自然日或近 30 个自然日。",
        "in": "query",
        "required": false
      },
      {
        "name": "sort",
        "schema": "fullLoadCount | lastLoadedAt; default fullLoadCount",
        "description": "所选字段倒序，并列时按 skillId 升序；不接受任意 SQL 或自定义排序表达式。",
        "in": "query",
        "required": false
      },
      {
        "name": "page",
        "schema": "integer >= 1; default 1",
        "description": "普通页码，不固定跨页快照；偏移按 (page-1)*limit 计算并检查 64 位整数溢出。",
        "in": "query",
        "required": false
      },
      {
        "name": "limit",
        "schema": "integer 1..200; default 50",
        "description": "每页最多条数。与现有整数分页风格一致；列表示例显式使用 limit=2。",
        "in": "query",
        "required": false
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。示例：?period=7d&sort=fullLoadCount&page=1&limit=2。",
      "example": null
    },
    "responses": [
      {
        "id": "200-ranking",
        "status": "200",
        "tabLabel": "200 · 近 7 天排名",
        "label": "OK",
        "summary": "近 7 天排名：period=7d&sort=fullLoadCount&page=1&limit=2；该快照还有第三项，因此 nextPage=2。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "en-US"
