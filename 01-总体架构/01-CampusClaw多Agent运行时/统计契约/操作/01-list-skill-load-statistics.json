    "contractSections": [
      {
        "title": "计量、时间与权限",
        "columns": [
          "项目",
          "契约"
        ],
        "rows": [
          [
            "计量单位",
            "成功记账的 SKILL.md 全文加载次数；跨 Agent、版本与入口累计。技术失败可能漏计，不代表任务采用、模型接收或任务成功。"
          ],
          [
            "统计时区",
            "Asia/Shanghai；日期为 YYYY-MM-DD，时间戳为 UTC 毫秒。queriedAt 和本页数据取同一数据库查询语句快照；时间戳不是提交水位。"
          ],
          [
            "窗口",
            "7d/30d 包含今天的自然日：数据库日期为 2026-09-15 时，7d 为 [2026-09-09, 2026-09-16)。今天只含查询时可见的已提交记账。"
          ],
          [
            "授权边界",
            "仅供已获部署级统计权限的管理端经 CampusMate/部署入口调用；Claw 沿用上游授权，现有凭据 ID 不能推导租户。浏览器不直连，不将全库统计分页后过滤为租户统计。部署级范围为本版推荐边界，尚待权限选项确认。"
          ],
          [
            "参数校验",
            "拒绝未知参数、重复参数、空字符串、非法枚举、非整数页码及请求体。所有缺省值在 Service 统一应用，不在 request VO 初始化。"
          ],
          [
            "字段类型",
            "fullLoadCount 为非负 64 位整数；Skill ID 沿用现有格式和精确大小写身份。客户端须使用可保留整数精度的读取方式。数据库错误不能转换成零或空列表。"
          ]
        ]
      },
      {
        "title": "列表响应与分页",
        "columns": [
          "项目",
          "契约"
        ],
        "rows": [
          [
            "result 字段",
            "period、timeZone、fromDate、toDate、queriedAt、page、limit、nextPage、items 均存在。all 的 fromDate/toDate 为 null；7d/30d 的日期边界左闭右开。"
          ],
          [
            "items",
            "只含 skillId、fullLoadCount、lastLoadedAt；fullLoadCount 大于 0，lastLoadedAt 为同一窗口最近时间且非 null。没有记录不构造虚拟 Skill 项。"
          ],
          [
            "nextPage",
            "取 limit+1 项判定；有下一页返回 page+1，否则为 null。不返回 total，不承诺跨请求稳定排名。"
          ],
          [
            "刷新",
            "跨页间有新记账时可能重复或遗漏；改变 period/sort/limit 时从 page=1 重新查。实时分页不能作为一致性导出。"
          ],
          [
            "SQL 边界",
            "先统计后分页；排序字段由 Service 枚举选择固定 SQL，禁止原样拼接客户端字符串。"
          ]
        ]
      }
    ]
  },
