{
  "operation": {
    "shortName": "查询 Skill 调用排名",
    "operationKey": "listSkillInvocationStatistics",
    "method": "GET",
    "path": "/skills/invocation-statistics",
    "summary": "直接分页查询累计或近 7/30 天 Skill 调用统计",
    "description": "直接分页查询成功 Skill 指令交付的累计或近 7/30 天调用次数，无需 skillIds。服务端先聚合、排序，再分页；仅返回窗口内正计数。首版 scope=runtime，名称由 CampusMate 维护。来源事实与权威事件、累计及日汇总同事务提交。本接口为推荐目标，target-only，尚未实施。",
    "parameters": [
      {
        "name": "period",
        "schema": "all | 7d | 30d; default all",
        "description": "累计、近 7 个自然日或近 30 个自然日。",
        "in": "query",
        "required": false
      },
      {
        "name": "sort",
        "schema": "invocationCount | lastInvokedAt; default invocationCount",
        "description": "所选字段倒序，并列时按 skillId 升序；不接受任意 SQL 或自定义排序表达式。",
        "in": "query",
        "required": false
      },
      {
        "name": "page",
        "schema": "integer >= 1; default 1",
        "description": "普通页码，不固定跨页快照；偏移按 (page-1)*limit 计算并检查 64 位整数溢出。",
        "in": "query",
        "required": false
      },
      {
        "name": "limit",
        "schema": "integer 1..200; default 50",
        "description": "每页最多条数。与现有整数分页风格一致；列表示例显式使用 limit=2。",
        "in": "query",
        "required": false
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。示例：?period=7d&sort=invocationCount&page=1&limit=2。",
      "example": null
    },
