{
  "operation": {
    "shortName": "查询 Skill 使用排名",
    "operationKey": "listSkillUsageStatistics",
    "method": "GET",
    "path": "/skills/usage-statistics",
    "summary": "直接分页查询累计或近 7/30 天 Skill 使用统计",
    "description": "查询按根执行去重的 Skill 使用统计：同一 (sessionId, rootEventId, skillId) 的显式受理和成功主文档 Read 信号共计一次，部分正文即可。首版 scope=runtime。三张统计表在独立短事务中提交，统计失败不阻断主执行但可能漏计。本接口目标方案已确认，target-only，尚未实施。列表无需 skillIds，先聚合排序再分页。",
    "parameters": [
      {
        "name": "period",
        "schema": "all | 7d | 30d; default all",
        "description": "累计、近 7 个自然日或近 30 个自然日。",
        "in": "query",
        "required": false
      },
      {
        "name": "sort",
        "schema": "usageCount | lastUsedAt; default usageCount",
        "description": "所选字段倒序，并列时按 skillId 升序；不接受任意 SQL 或自定义排序表达式。",
        "in": "query",
        "required": false
      },
      {
        "name": "page",
        "schema": "integer >= 1; default 1",
        "description": "普通页码，不固定跨页快照；偏移按 (page-1)*limit 计算并检查 64 位整数溢出。",
        "in": "query",
        "required": false
      },
      {
        "name": "limit",
        "schema": "integer 1..200; default 50",
        "description": "每页最多条数。与现有整数分页风格一致；列表示例显式使用 limit=2。",
        "in": "query",
        "required": false
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。示例：?period=7d&sort=usageCount&page=1&limit=2。",
      "example": null
    },
