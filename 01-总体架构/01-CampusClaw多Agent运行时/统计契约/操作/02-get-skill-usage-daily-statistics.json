{
  "operation": {
    "shortName": "查询 Skill 每日使用次数",
    "operationKey": "getSkillUsageDailyStatistics",
    "method": "GET",
    "path": "/skills/{skillId}/usage-statistics/daily",
    "summary": "查看一个 Skill 近 7/30 天的逐日使用趋势",
    "description": "查询按根执行去重的 Skill 使用统计：同一 (sessionId, rootEventId, skillId) 的显式受理和成功主文档 Read 信号共计一次，部分正文即可。首版 scope=runtime。三张统计表在独立短事务中提交，统计失败不阻断主执行但可能漏计。本接口目标方案已确认，target-only，尚未实施。累计资源不存在返回 404，不推断 Skill 主数据不存在。",
    "parameters": [
      {
        "name": "skillId",
        "schema": "^skill-[0-9a-fA-F]{32}$",
        "description": "Skill 标识；精确匹配，不归一大小写。只校验格式和统计资源，不查询远端 Skill 目录。",
        "in": "path",
        "required": true
      },
      {
        "name": "period",
        "schema": "7d | 30d; default 7d",
        "description": "近 7/30 个自然日，包含今天；不接受 all。",
        "in": "query",
        "required": false
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。示例：?period=7d；不分页。",
      "example": null
    },
