    "contractSections": [
      {
        "title": "计量、时间与权限",
        "columns": [
          "项目",
          "契约"
        ],
        "rows": [
          [
            "计量单位",
            "invocationCount 为成功指令交付次数：一次显式注入或一次实际交付主文档正文的成功 Read 各计 1。分段 Read 分别计数，重复投递同一来源不重计；不表示全文覆盖、任务采用或业务执行成功。"
          ],
          [
            "统计范围",
            "scope 固定为 runtime；仅含接入持久化统计的 Runtime 会话，跨 Agent/版本/plan/build 累计。Child/Cron 尚未接入，不能解释为它们的零调用。"
          ],
          [
            "统计时区",
            "Asia/Shanghai；日期 YYYY-MM-DD，时间戳 UTC 毫秒。按来源 occurredAt 归日，重试不改日期；queriedAt 和当前页取同一查询语句快照，不是执行完成水位。"
          ],
          [
            "窗口与保留",
            "7d/30d 包含今天的自然日：2026-09-15 的 7d 为 [2026-09-09, 2026-09-16)。仅含功能启用以来已提交事实，不回填旧历史；实际保留策略不覆盖窗口时返回 503，不能把过期数据补零。"
          ],
          [
            "授权边界",
            "仅供已获部署级统计权限的管理端经 CampusMate/部署入口调用；Claw 沿用上游授权，凭据 ID 不能推导租户。浏览器不直连；权限未落实不开放，禁止全库分页后再做租户过滤。"
          ],
          [
            "参数校验",
            "拒绝未知/重复参数、空字符串、非法枚举、非整数页码及请求体。缺省值由 Service 统一应用，路径 Skill ID 使用既有精确格式。"
          ],
          [
            "字段类型",
            "invocationCount 为非负 64 位整数；客户端使用保留整数精度的读取方式。scope 为固定字符串，数据库错误不能转换成零或空列表。"
          ]
        ]
      },
      {
        "title": "趋势响应与缺失语义",
        "columns": [
          "项目",
          "契约"
        ],
        "rows": [
          [
            "result 字段",
            "scope、skillId、period、timeZone、fromDate、toDate、queriedAt、invocationCount、lastInvokedAt、items 均存在。"
          ],
          [
            "日期序列",
            "items 恰有 7/30 项，只含 date、invocationCount，升序连续排列；在保留完整的窗口内缺日补零。"
          ],
          [
            "聚合一致性",
            "invocationCount 等于同一快照所有日项之和；lastInvokedAt 为窗口内最近时间，全零窗口为 null。"
          ],
          [
            "无统计资源",
            "累计表无记录返回 404 SKILL_INVOCATION_STATISTICS_NOT_FOUND；该错误不证明 Skill 主数据不存在。写入端首个合格来源可创建统计资源。"
          ],
          [
            "追溯边界",
            "调用事实关联根消息、规范工具调用及结果，保留策略内可核对。汇总不包含 Skill 正文，不保证模型采用或业务成功。"
          ]
        ]
      }
    ]
  },
