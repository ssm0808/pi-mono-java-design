{
  "operation": {
    "shortName": "查询 Skill 每日调用次数",
    "operationKey": "getSkillInvocationDailyStatistics",
    "method": "GET",
    "path": "/skills/{skillId}/invocation-statistics/daily",
    "summary": "查看一个 Skill 近 7/30 天的逐日调用趋势",
    "description": "查看一个 Skill 在近 7/30 天的逐日成功调用次数。首版 scope=runtime；同一 SQL 快照检查累计资源并补齐自然日。无累计统计返回 404，不能据此断言 Skill 主数据不存在。来源事实与汇总同事务。本接口为推荐目标，target-only，尚未实施。",
    "parameters": [
      {
        "name": "skillId",
        "schema": "^skill-[0-9a-fA-F]{32}$",
        "description": "Skill 标识；精确匹配，不归一大小写。只校验格式和统计资源，不查询远端 Skill 目录。",
        "in": "path",
        "required": true
      },
      {
        "name": "period",
        "schema": "7d | 30d; default 7d",
        "description": "近 7/30 个自然日，包含今天；不接受 all。",
        "in": "query",
        "required": false
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。示例：?period=7d；不分页。",
      "example": null
    },
