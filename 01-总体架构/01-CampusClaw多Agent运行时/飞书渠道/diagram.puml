@startuml channel_feishu_target_architecture
' Source evidence: pi-mono-java@1f801dbb82bdda30478e3354e685e3153b179a0c modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/event/RuntimeEventService.java lines 66-102
' Source evidence: pi-mono-java@1f801dbb82bdda30478e3354e685e3153b179a0c modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/event/RuntimeEventStream.java lines 48-79 and 107-138
' Source evidence: openclaw/openclaw@b015925bc30f6a8363f290b07d5f8588e21422b8 extensions/feishu/src/feishu-ingress.ts lines 330-500
' Source evidence: openclaw/openclaw@b015925bc30f6a8363f290b07d5f8588e21422b8 extensions/feishu/src/streaming-card.ts lines 266-403 and 405-726

' Observed behavior at fixed Java source baseline: accepted messages persist before execution; disconnection detaches a subscriber.
' Target-only: every Channel class and relationship below is a recommended assembly, not an implemented Java inventory.
' Architecture change: Channel uses the Chat application port; Provider identifiers never enter Runtime requests.
' Design reason: separate durable admission, execution, projection and delivery while sharing fenced persistent state.
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam ArrowColor #475569
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 20
skinparam ranksep 35
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
hide empty members
top to bottom direction
title Feishu Channel - Global Target Classes
allowmixing
package "Provider ingress | singleton lifecycle" {
  interface ChannelEventSource {
    +start()
    +stop()
  }
  class FeishuTransport
  class FeishuProviderAdapter
  FeishuTransport .up.|> ChannelEventSource
  FeishuTransport --> FeishuProviderAdapter : verified event
}
package "Channel application | singleton services" {
  interface ChannelInboundPort {
    +accept(message): receipt
  }
  class ChannelInboundService
  class ChannelExecutionWorker {
    +executeNext()
    +reconcileAccepted()
  }
  class ChannelDeliveryWorker
  class ChannelEventProjector {
    +projectAllowedContent()
  }
  ChannelInboundService .up.|> ChannelInboundPort
  ChannelExecutionWorker --> ChannelEventProjector
}
package "Chat application | singleton boundary" {
  interface ChannelChatPort {
    +ensureChat()
    +submit()
    +listEvents()
    +getSession()
  }
  class "Chat Application Core" as Chat
  class "Runtime HTTP Client" as Client
  Chat .up.|> ChannelChatPort
  Chat --> Client
}
package "Channel persistence | durable authority" {
  class "Channel Store" as Store {
    +acceptInboxAndOutbox()
    +claimWithFence()
    +saveReceiptAndClearContent()
  }
  class "Execution snapshot DTO" as Snapshot <<per execution>> {
    accepted_event_id
    observed_event_ids
  }
  class "Channel tables" as Tables <<persistent>>
  Store o-- "0..*" Snapshot : loads
  Store --> Tables : transaction
}
package "Outbound adapter | singleton lifecycle" {
  interface ChannelMessageGateway {
    +create()
    +update()
    +finish()
  }
  class FeishuMessageGateway
  class "Secret Manager Client" as Secrets
  FeishuMessageGateway .up.|> ChannelMessageGateway
  FeishuMessageGateway --> Secrets
}
cloud "CampusClaw Runtime\nSession / full events / execution" as Runtime
cloud "Feishu Platform\nEvents / Messages / CardKit" as Feishu
FeishuProviderAdapter --> ChannelInboundPort : normalized DTO
ChannelInboundService --> Store : durable acceptance
ChannelExecutionWorker --> Store
ChannelExecutionWorker --> ChannelChatPort
ChannelExecutionWorker o-- "1" Snapshot
ChannelEventProjector --> Store : desired view / outbox
ChannelDeliveryWorker --> Store : claim delivery
ChannelDeliveryWorker --> ChannelMessageGateway : invoke
Client --> Runtime
FeishuMessageGateway --> Feishu : stable uuid / sequence
FeishuTransport -[norank]-> Secrets : credential reference
ChannelInboundPort -[hidden]right-> ChannelExecutionWorker
ChannelEventProjector -[hidden]right-> ChannelDeliveryWorker
ChannelChatPort -[hidden]down-> ChannelMessageGateway
Store -[hidden]down-> Runtime
legend bottom left
All Channel classes and relations are target-only. SDK types stop at the Provider Adapter.
Store = account, conversation, inbox, execution, delivery and outbox (six t_channel_* tables).
Services are shared; snapshots belong to one fenced execution; tables own durable state.
Only saved accepted_event_id enables history recovery; unknown acceptance needs manual reconciliation.
endlegend
@enduml

@startuml channel_feishu_message_sequence
' Source evidence: 01-%E6%80%BB%E4%BD%93%E6%9E%B6%E6%9E%84/01-CampusClaw%E5%A4%9AAgent%E8%BF%90%E8%A1%8C%E6%97%B6/%E4%BA%8B%E4%BB%B6%E5%A5%91%E7%BA%A6/%E6%93%8D%E4%BD%9C/01-submit-session-event.json, submitSessionEvent
' Source evidence: 01-%E6%80%BB%E4%BD%93%E6%9E%B6%E6%9E%84/01-CampusClaw%E5%A4%9AAgent%E8%BF%90%E8%A1%8C%E6%97%B6/%E4%BA%8B%E4%BB%B6%E5%A5%91%E7%BA%A6/%E6%93%8D%E4%BD%9C/02-list-session-events.json, listSessionEvents
