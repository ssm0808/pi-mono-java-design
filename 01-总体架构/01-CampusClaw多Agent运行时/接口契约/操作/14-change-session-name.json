{
  "operation": {
    "shortName": "重命名会话",
    "operationKey": "changeSessionName",
    "method": "PUT",
    "path": "/sessions/{sessionId}/name",
    "summary": "修改 Session 显示名称",
    "description": "直接更新 Session displayName，与 Builtin /name 命令共用同一名称规范化与持久化服务。直接 HTTP 调用要求 If-Match，事务内锁定 Session 并再次校验资源版本；/name 命令不接收 ETag，保留现有锁内最终写入语义。名称修改不改变当前执行快照，因此 idle/running 均可调用，不写入 Session Entry。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": "strong ETag",
        "description": "最近一次 GET Session 或成功 Session 变更返回的 ETag；缺失返回 428，不匹配返回 412"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": true,
      "contentType": "application/json",
      "description": "只接受 displayName。去除首尾空白后必须非空，保留内部空白；禁止 CR/LF、C0/C1 控制字符和双向文本覆盖/隔离字符，UTF-8 编码最多 80 字节。不接受 name、changed、未知字段或 Idempotency-Key。",
      "example": {
        "displayName": "园区网络故障分析"
      }
    },
    "responses": [
      {
        "id": "200-name-updated",
        "status": "200",
        "tabLabel": "200 · 名称已更新",
        "label": "OK",
        "summary": "返回更新后的完整 Session 资源及 ETag；示例显式说明 running 期间也允许重命名。",
