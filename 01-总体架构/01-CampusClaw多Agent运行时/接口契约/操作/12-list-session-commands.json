{
  "operation": {
    "shortName": "查看会话命令清单",
    "operationKey": "listSessionCommands",
    "method": "GET",
    "path": "/sessions/{sessionId}/commands",
    "summary": "列出当前 Session 可调用的 Builtin 和 Skill 命令形态",
    "description": "Runtime 根据 Session 状态和最新 complete Agent 版本生成严格过滤的命令清单。每一项只描述当前可调用的形态：input 缺失表示当前只允许无参且无附件调用；input.hint 是不参与校验的展示文本，方括号表示可选输入，尖括号表示必填输入；input.acceptsFiles 只在为 true 时输出。响应不含 Slash 前缀、候选模型值、Skill ID、版本、正文或文件路径。该接口只读，不刷新 Agent，也不调用模型。 Builtin 与 Skill Command 由用户统一负责设计、实现和集成。GET 共享清单的字段、排序与状态过滤已确认；Skill 执行联合请求和公共 POST 发布仍待评审，发现示例不代表已经上线。Builtin 按 help、status、name、model、thinking、compact、skills 固定顺序排列，Skill 随后按 name 排序。Help 仅无参介绍 Agent，因此始终不返回 input。无完整 Agent 缓存返回 503 AGENT_NOT_AVAILABLE，不返回残缺的 Builtin 清单；这不改变 POST Help 的既有 422 错误。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不接受前缀、搜索词或 forceReload。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "tabLabel": "200 · Running",
        "summary": "Session 正在运行。只返回当前可调用的命令形态；Model/Thinking 仅保留无参查看，Compact 和 Skill 不返回。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "commands": [
                {
                  "name": "help",
                  "kind": "builtin",
                  "description": "介绍当前 Agent 的用途和使用场景"
                },
                {
                  "name": "status",
                  "kind": "builtin",
                  "description": "查看 Session 状态、模型和深度思考"
                },
                {
                  "name": "name",
                  "kind": "builtin",
                  "description": "查看或修改 Session 名称",
                  "input": {
                    "hint": "[displayName]"
                  }
                },
                {
                  "name": "model",
                  "kind": "builtin",
                  "description": "查看或切换模型"
                },
                {
                  "name": "thinking",
                  "kind": "builtin",
                  "description": "查看或切换深度思考"
                },
                {
                  "name": "skills",
                  "kind": "builtin",
                  "description": "列出当前 Agent 绑定的 Skill"
                }
              ]
            }
          }
        },
        "id": "200-running"
      },
      {
        "status": "200",
        "label": "OK",
        "tabLabel": "200 · Idle",
        "summary": "Session 处于空闲。恢复 Compact、Skill 以及 Model/Thinking 的带参调用形态。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "commands": [
                {
                  "name": "help",
                  "kind": "builtin",
                  "description": "介绍当前 Agent 的用途和使用场景"
                },
                {
                  "name": "status",
                  "kind": "builtin",
                  "description": "查看 Session 状态、模型和深度思考"
                },
                {
                  "name": "name",
                  "kind": "builtin",
                  "description": "查看或修改 Session 名称",
                  "input": {
                    "hint": "[displayName]"
                  }
                },
                {
                  "name": "model",
                  "kind": "builtin",
                  "description": "查看或切换模型",
                  "input": {
                    "hint": "[modelId]"
                  }
                },
                {
                  "name": "thinking",
                  "kind": "builtin",
                  "description": "查看或切换深度思考",
                  "input": {
                    "hint": "[on|off]"
                  }
                },
                {
                  "name": "compact",
                  "kind": "builtin",
                  "description": "压缩当前上下文"
                },
                {
                  "name": "skills",
                  "kind": "builtin",
                  "description": "列出当前 Agent 绑定的 Skill"
                },
                {
                  "name": "skill:pdf",
                  "kind": "skill",
                  "description": "分析和生成 PDF 文档",
                  "input": {
                    "hint": "[request]",
                    "acceptsFiles": true
                  }
                }
              ]
            }
          }
        },
        "id": "200-idle"
      },
      {
        "status": "400",
        "label": "Bad Request",
        "summary": "sessionId 不符合标识格式。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "sessionId 格式不正确。"
          },
          "en-US": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "The sessionId format is invalid."
          }
        }
      },
      {
        "status": "404",
        "label": "Not Found",
        "summary": "Session 不存在或已删除。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "SESSION_NOT_FOUND",
            "resMsg": "指定的 Session 不存在。"
          },
          "en-US": {
            "resCode": "SESSION_NOT_FOUND",
            "resMsg": "The specified Session does not exist."
          }
        }
      },
      {
        "status": "503",
        "label": "Service Unavailable",
        "summary": "当前 Agent 没有可用的 complete 快照，无法生成完整命令清单。",
        "headers": {
          "Content-Language": "zh-CN",
          "Retry-After": "3"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "AGENT_NOT_AVAILABLE",
            "resMsg": "当前 Agent 运行时不可用。"
          },
          "en-US": {
            "resCode": "AGENT_NOT_AVAILABLE",
            "resMsg": "The current Agent runtime is unavailable."
          }
        }
      }
    ]
  },
  "review": {
    "questions": []
  }
}
