{
  "operation": {
    "shortName": "查看会话命令清单",
    "operationKey": "listSessionCommands",
    "method": "GET",
    "path": "/sessions/{sessionId}/commands",
    "summary": "列出当前 Session 的七个 Builtin 命令",
    "description": "本页展示已确认的 Builtin 开发切片；Skill Command 由其他同事并行开发，最终公共清单在 HTTP 发布前整合双方契约，不代表 Skill 延期或禁用。Builtin 视图只按 Session 持久化状态和 Builtin 准入策略生成七个 Builtin，按 name 稳定字典序排序。available 表示空参数调用，input.available 表示带参数调用。暂不可用命令仍保留。列表接口不触发 Agent 刷新、不读取动态 SkillCommandSource、不调用模型。所有列表字段均返回非 null 的列表，空值用 []。本页 Builtin 命令 acceptsFiles=false；该规则不定义 Skill 执行契约。 Help 描述符仅允许无参：介绍当前 Agent 的用途和使用场景，不再提供命令名候选。Help 与其他无参 Builtin 一样使用 input.mode=none；不在本次改变 GET 整体字段或其他命令。清单中的 available 不保证 Agent 缓存完整，Help 执行时仍检查完整快照。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不接受前缀、搜索词或 forceReload。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "summary": "返回七个 Builtin。示例中 Session 正在运行：Model/Thinking 只能查询，Compact 不可执行。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "commands": [
                {
                  "name": "compact",
                  "kind": "builtin",
                  "description": "压缩当前上下文",
                  "available": false,
                  "unavailableCode": "SESSION_BUSY",
                  "input": {
                    "mode": "none",
                    "available": false,
                    "unavailableCode": "COMMAND_ARGUMENTS_NOT_SUPPORTED",
                    "acceptsFiles": false,
                    "placeholder": null,
                    "suggestions": []
                  }
                },
                {
                  "name": "help",
                  "kind": "builtin",
                  "description": "介绍当前 Agent 的用途和使用场景",
                  "available": true,
                  "unavailableCode": null,
                  "input": {
                    "mode": "none",
                    "available": false,
                    "unavailableCode": "COMMAND_ARGUMENTS_NOT_SUPPORTED",
                    "acceptsFiles": false,
                    "placeholder": null,
                    "suggestions": []
                  }
                },
                {
                  "name": "model",
                  "kind": "builtin",
                  "description": "查看或切换模型",
                  "available": true,
                  "unavailableCode": null,
                  "input": {
                    "mode": "optional",
                    "available": false,
                    "unavailableCode": "SESSION_BUSY",
                    "acceptsFiles": false,
                    "placeholder": "modelId",
                    "suggestions": [
                      "claude-sonnet-4-5",
                      "deepseek-v3-2"
                    ]
                  }
                },
                {
                  "name": "name",
                  "kind": "builtin",
                  "description": "查看或修改 Session 名称",
                  "available": true,
                  "unavailableCode": null,
                  "input": {
                    "mode": "optional",
                    "available": true,
                    "unavailableCode": null,
                    "acceptsFiles": false,
                    "placeholder": "displayName",
                    "suggestions": []
                  }
                },
                {
                  "name": "skills",
                  "kind": "builtin",
                  "description": "列出当前 Agent 绑定的 Skill",
                  "available": true,
                  "unavailableCode": null,
                  "input": {
                    "mode": "none",
                    "available": false,
                    "unavailableCode": "COMMAND_ARGUMENTS_NOT_SUPPORTED",
                    "acceptsFiles": false,
                    "placeholder": null,
                    "suggestions": []
                  }
                },
                {
                  "name": "status",
                  "kind": "builtin",
                  "description": "查看 Session 状态、模型和深度思考",
                  "available": true,
                  "unavailableCode": null,
                  "input": {
                    "mode": "none",
                    "available": false,
                    "unavailableCode": "COMMAND_ARGUMENTS_NOT_SUPPORTED",
                    "acceptsFiles": false,
                    "placeholder": null,
                    "suggestions": []
                  }
                },
                {
                  "name": "thinking",
                  "kind": "builtin",
                  "description": "查看或切换深度思考",
                  "available": true,
                  "unavailableCode": null,
                  "input": {
                    "mode": "optional",
                    "available": false,
                    "unavailableCode": "SESSION_BUSY",
                    "acceptsFiles": false,
                    "placeholder": "on|off",
                    "suggestions": [
                      "on",
                      "off"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      {
        "status": "400",
        "label": "Bad Request",
        "summary": "sessionId 不符合标识格式。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "sessionId 格式不正确。"
          },
          "en-US": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "The sessionId format is invalid."
          }
        }
      },
      {
        "status": "404",
        "label": "Not Found",
        "summary": "Session 不存在或已删除。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "SESSION_NOT_FOUND",
            "resMsg": "指定的 Session 不存在。"
          },
          "en-US": {
            "resCode": "SESSION_NOT_FOUND",
            "resMsg": "The specified Session does not exist."
          }
        }
      }
    ]
  },
  "review": {
    "questions": []
  }
}
