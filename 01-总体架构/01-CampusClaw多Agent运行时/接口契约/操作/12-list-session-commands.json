{
  "operation": {
    "shortName": "查看会话命令清单",
    "operationKey": "ListSessionCommands",
    "method": "GET",
    "path": "/sessions/{sessionId}/commands",
    "summary": "列出当前 Session 的 Builtin 和 Skill 命令",
    "description": "查询指定会话的可用命令，返回名称、类别、用途和参数提示，供客户端展示 Slash 命令列表。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不接受前缀、搜索词或 forceReload。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "tabLabel": "200 · Running",
        "summary": "Session 正在运行。只返回当前可调用的命令形态；Model/Thinking 仅保留无参查看，Compact 和 Skill 不返回。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "commands": [
                {
                  "name": "help",
                  "type": "builtin",
                  "description": "介绍当前 Agent 的用途和使用场景",
                  "hints": []
                },
                {
                  "name": "status",
                  "type": "builtin",
                  "description": "查看 Session 状态、模型和深度思考",
                  "hints": []
                },
                {
                  "name": "name",
                  "type": "builtin",
                  "description": "查看或修改 Session 名称",
                  "hints": [
                    "displayName"
                  ]
                },
                {
                  "name": "model",
                  "type": "builtin",
                  "description": "查看或切换模型",
                  "hints": [
                    "modelId"
                  ]
                },
                {
                  "name": "thinking",
                  "type": "builtin",
                  "description": "查看或切换深度思考",
                  "hints": [
                    "on|off"
                  ]
                },
                {
                  "name": "mode",
                  "type": "builtin",
                  "description": "查看或切换 plan/build 工作模式",
                  "hints": [
                    "plan|build"
                  ]
                },
                {
                  "name": "skills",
                  "type": "builtin",
                  "description": "列出当前 Agent 绑定的 Skill",
                  "hints": []
                }
              ]
            }
          }
        },
        "id": "200-running"
      },
