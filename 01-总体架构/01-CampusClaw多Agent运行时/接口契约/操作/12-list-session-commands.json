        "label": "Service Unavailable",
        "summary": "当前 Agent 没有可用的 complete 快照，无法生成完整命令清单。",
        "headers": {
          "Content-Language": "zh-CN",
          "Retry-After": "3"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "AGENT_NOT_AVAILABLE",
            "resMsg": "当前 Agent 运行时不可用。"
          },
          "en-US": {
            "resCode": "AGENT_NOT_AVAILABLE",
            "resMsg": "The current Agent runtime is unavailable."
