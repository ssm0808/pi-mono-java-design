{
  "operation": {
    "shortName": "更新会话",
    "operationKey": "updateSession",
    "method": "POST",
    "path": "/sessions/{sessionId}",
    "summary": "统一更新 Session 名称、模型、思考和工作模式",
    "description": "按明确提交的 displayName、modelId、thinking、mode 部分更新同一 Session，允许单字段或多字段组合。当前前端每次选择器或重命名操作仅提交对应一个字段，接口不限制为只能提交一项。所有字段先校验、再在同一行锁事务中提交；任何字段失败整笔回滚，禁止依次调用旧修改接口。仅 displayName 请求在 idle/running 均可用；只要携带 modelId、thinking 或 mode，即使值相同也要求 idle，否则 SESSION_BUSY。请求使用 If-Match 保护同一资源版本；真实变化只增加一次 resourceVersion 并更新一次 updatedAt。模型、思考、模式实际变化按顺序追加 session.model_changed、session.thinking_changed、session.mode_changed；名称不写入 Session Entry。全部无变化返回原 Session 和 ETag。成功不启动模型、不批准计划，也不排队；既有思考原文不因关闭 thinking 而隐藏。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": "strong ETag",
        "description": "最近一次 GET Session 或成功 Session 更新返回的单个强 ETag；必填，缺失 428，不匹配 412。禁止弱标签、通配符和标签列表。"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": true,
      "contentType": "application/json",
      "description": "仅接受 displayName、modelId、thinking、mode，四项均可省略但至少提交一项；未提交字段保留（仅切换模型时可按能力自动关闭未提交的 thinking）。显式 null、空对象、类型强转、重复 JSON 键、未知字段和只读字段均拒绝。displayName 去除首尾空白后非空，保留内部空白，禁止 CR/LF、C0/C1 控制字符与双向文本覆盖/隔离字符，UTF-8 最多 80 字节。thinking 是 boolean，不接收 level/reasoningEffort；mode 只接受 plan/build。ID、state、usage 和时间戳不可写，不接收 provider、凭据或 Idempotency-Key；不在请求 VO 设置默认值。",
      "example": {
        "displayName": "园区网络故障分析"
      },
      "examples": [
        {
          "label": "仅修改名称",
          "description": "running 也可提交；不会修改执行配置。",
          "value": {
            "displayName": "教学楼网络排障"
          }
        },
        {
          "label": "仅切换模型",
          "description": "省略 thinking，目标模型不支持思考时沿用自动关闭规则。",
          "value": {
            "modelId": "model_011CZq2GkV8aD4NwP7sLmXfS"
          }
        },
        {
          "label": "仅修改思考",
          "description": "false 必须作为明确提交的布尔值处理，不能当成省略。",
          "value": {
            "thinking": false
          }
        },
        {
          "label": "仅修改模式",
          "description": "要求 idle；切到 build 不等于批准任何计划。",
          "value": {
            "mode": "build"
          }
        },
        {
          "label": "多字段组合更新",
          "description": "展示接口支持的组合提交；当前前端仍按单项操作调用，不要求新增批量保存交互。全部校验通过后一次提交。",
          "value": {
            "displayName": "园区网络故障分析",
            "modelId": "model_011CZq2GkV8aD4NwP7sLmXfS",
            "thinking": true,
            "mode": "plan"
          }
        }
      ],
      "schema": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "modelId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          },
          "thinking": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "plan",
              "build"
            ]
          }
        }
      }
    },
