{
  "operation": {
    "shortName": "设置深度思考",
    "operationKey": "changeSessionThinking",
    "method": "PUT",
    "path": "/sessions/{sessionId}/thinking",
    "summary": "开启或关闭 Session 深度思考",
    "description": "在 Session 处于 idle 时，将 thinking 设置为是否对后续 user.message 启用深度思考。false 映射为关闭推理且 POST /events 不发送 thinking 事件；true 使用当前模型和 Agent 的受管非 off 推理强度。值变化时在同一事务中追加 reason=requested 的 session.thinking_changed；该领域记录不成为模型上下文消息。相同值不追加事件。调用方不选择具体推理等级。B05/B12 已确认：thinking 只影响后续执行，关闭不隐藏已经公开的历史摘要；配置记录按 Events v2 投影；GET 历史已采用普通整数分页，不再继承旧游标失效规则。 B05/B12 已确认：既有公开摘要按当前访问权限读取，不因后续 thinking 开关隐藏；模型/思考真实变更写入 Events v2 的完整配置事件。同值无事件的规则不变。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "in": "header",
        "name": "If-Match",
        "required": true,
        "schema": "strong ETag",
        "description": "最近一次 GET Session 或成功配置变更返回的 ETag；缺失返回 428，不匹配返回 412"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": true,
      "contentType": "application/json",
      "description": "只接受布尔字段 thinking；不接受 level、reasoningEffort、模型参数、客户端 capability 或 Idempotency-Key。",
      "example": {
        "thinking": true
      }
    },
    "responses": [
