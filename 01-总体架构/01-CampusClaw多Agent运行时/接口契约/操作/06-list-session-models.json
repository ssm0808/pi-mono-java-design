{
  "operation": {
    "shortName": "查询可用模型",
    "operationKey": "ListSessionModels",
    "method": "GET",
    "path": "/sessions/{sessionId}/models",
    "summary": "列出 Session 当前可选模型",
    "description": "查询指定会话可选择的模型和当前模型，用于展示模型选择列表。候选范围由绑定 Agent 的模型配置与 Runtime 当前可用模型共同决定。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体；不支持 all、provider、page 或 capability 过滤参数。",
      "example": null
    },
    "responses": [
      {
        "status": "200",
        "label": "OK",
        "summary": "返回当前模型标识和实时可选模型；models 允许为空，且 currentModelId 不承诺一定出现在 models 中。",
        "headers": {
          "Cache-Control": "no-store",
          "Content-Language": "en-US"
        },
        "bodies": {
          "en-US": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "currentModelId": "model_011CZq2GkV8aD4NwP7sLmXfR",
              "models": [
                "model_011CZq2GkV8aD4NwP7sLmXfR",
                "model_011CZq2GkV8aD4NwP7sLmXfS"
              ]
            }
          }
        }
      },
      {
        "status": "400",
        "label": "Bad Request",
        "summary": "sessionId 不符合标识格式。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "sessionId 格式不正确。"
          },
          "en-US": {
            "resCode": "INVALID_SESSION_ID",
            "resMsg": "The sessionId format is invalid."
          }
        }
      },
      {
        "status": "404",
        "label": "Not Found",
        "summary": "Session 不存在或已删除。",
        "headers": {
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "SESSION_NOT_FOUND",
            "resMsg": "指定的 Session 不存在。"
          },
          "en-US": {
            "resCode": "SESSION_NOT_FOUND",
            "resMsg": "The specified Session does not exist."
          }
        }
      },
      {
        "status": "503",
        "label": "Service Unavailable",
        "summary": "Model Manager 暂时不可用，无法形成实时可选模型列表。",
        "headers": {
          "Content-Language": "zh-CN",
          "Retry-After": "3"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "MANAGER_UNAVAILABLE",
            "resMsg": "Model Manager 暂时不可用，请稍后重试。"
          },
          "en-US": {
            "resCode": "MANAGER_UNAVAILABLE",
            "resMsg": "Model Manager is temporarily unavailable. Try again later."
          }
        }
      }
    ]
  },
