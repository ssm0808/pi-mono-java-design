{
  "operation": {
    "shortName": "查询会话事件",
    "operationKey": "listSessionEvents",
    "method": "GET",
    "path": "/sessions/{sessionId}/events",
    "summary": "分页读取 Session 持久化事件",
    "description": "从与 POST 相同的 Events 集合路径分页读取当前 Session 分支中的公共消息、领域事件和允许显示的 thinking。始终可见 user.message、assistant.message.completed、tool.result、session.model.changed、session.thinking.changed 和 session.compaction.completed；thinking=false 时只过滤 assistant.thinking.completed。assistant/compaction completed 含完整 Usage。thinking/message/tool delta、compaction started/failed 和流控制事件不进入历史。该公开投影与模型上下文恢复分离；恢复只消费消息、工具结果及最新压缩边界，不把模型或思考变更当作模型消息。page 绑定 thinking 状态；开关改变后旧 page 无效。示例使用 limit=7。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": "integer 1..200; default 100",
        "description": "限制本页最多返回的持久化事件数量；下方成功示例使用 limit=7"
      },
      {
        "in": "query",
        "name": "page",
        "required": false,
        "schema": "opaque string",
        "description": "后续页原样使用上一响应的 nextPage；第一页不传。客户端不得解析、修改或自行构造；游标只表示当前分支的继续位置，不包含固定历史上界"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。成功示例对应第一页 ?limit=7；后续请求原样传入上一响应的 nextPage。limit 可在每页指定。",
      "example": null
    },
