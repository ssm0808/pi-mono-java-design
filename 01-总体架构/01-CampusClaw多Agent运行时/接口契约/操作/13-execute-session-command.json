{
  "operation": {
    "shortName": "执行会话命令",
    "operationKey": "executeSessionCommand",
    "method": "POST",
    "path": "/sessions/{sessionId}/command",
    "summary": "执行一个 Builtin 命令并返回对应业务资源",
    "description": "本页展示已确认的 Builtin 开发切片：help、status、name、model、thinking、compact 和 skills。Builtin 与 Skill Command 由用户统一负责设计、实现和集成，最终共享 HTTP 入口的命名与请求联合类型在发布前统一对齐；Skill 具体契约继续评审。Service 将省略或 null 的 arguments 归一为空字符串，Builtin 请求拒绝未知字段和附件；不得使用 Builtin 名称正则全局拒绝 skill:*。成功返回普通 ResultBean JSON，不生成公开 commandId，不保存 command.started/completed/failed；Name 只保存当前名称，Model/Thinking/Compact 复用权威领域 Entry。Compact 被接受后断线不取消，结果不确定时通过 GET Session/Events 对账，不自动重放 POST。本接口额外必填 access-token。Claw 从请求读取四项凭据，非 Compact 命令只在内存中保留到本次命令处理结束；Compact 仅在 Active Holder 保留到压缩及本次压缩执行结束。仅随实际 Mate tool execute 原名发送，不写入 Session、事件或日志，不进入 Prompt，也不随工具发现、模型或其他请求发送；Claw 不解析或校验凭据。 Help 已确认改为 Agent 使用指南：只取 Session 绑定 Agent 最近成功发布的一份完整本地缓存，不消费命令清单，不调用 prepare、refresh、远端 Mate、模型或 Tool，不写历史或模型上下文、不占执行容量。AgentRuntime 的 userCases 必须完成保存与重载往返；旧缓存显式刷新前缺场景返回 []。三个介绍字段同取一份 PreparedAgentRuntime，读取与发布复用 Agent 级锁，不取 Session 执行锁。元数据仅作不可信纯文本展示，不执行 HTML、脚本或自动加载远程图片。 响应对齐既有 API：status/name/thinking 查询及 name/model/thinking 修改统一返回 GET Session 的完整资源与 ETag；model 查询返回 GET Models 的 currentModelId/models。仅复用业务响应 VO 和投影，不调用其他 Controller；Session 资源与 ETag 同取权威查询快照或锁内更新结果，不从旧命令清单拼接。Help、Compact、Skills 无对应独立 API，保留最小业务结果，不新增公共路径。所有成功结果删除 command、changed、sourceEventSeq，不新增类型判别或命令回执包装；调用方依据自身请求区分响应。配置同值成功保留原 updatedAt/ETag，不写领域 Entry。",
    "requestHeaderExamples": [
      {
        "id": "jwt",
        "label": "JWT Header 示例",
        "preferred": true,
        "headers": [
          {
            "name": "X-HW-ID",
            "value": "credential-jwt",
            "required": true,
            "description": "用户凭据 ID；不是公司、服务或应用标识。Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到本次压缩执行结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          },
          {
            "name": "Authorization",
            "value": "Bearer opaque-token",
            "required": true,
            "description": "Bearer JWT；Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到本次压缩执行结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          },
          {
            "name": "access-token",
            "value": "opaque-access-token",
            "required": true,
            "description": "Mate tool 调用凭据；Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到本次压缩执行结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          }
        ]
      },
      {
        "id": "appkey",
        "label": "APPKEY Header 示例",
        "preferred": false,
        "headers": [
          {
            "name": "X-HW-ID",
            "value": "credential-appkey",
            "required": true,
            "description": "用户凭据 ID；不是公司、服务或应用标识。Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到本次压缩执行结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          },
          {
            "name": "X-HW-APPKEY",
            "value": "opaque-appkey",
            "required": true,
            "description": "AppKey 凭据；可与 Authorization 同时提供。Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到本次压缩执行结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          },
          {
            "name": "access-token",
            "value": "opaque-access-token",
            "required": true,
            "description": "Mate tool 调用凭据；Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到本次压缩执行结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          }
        ]
      }
    ],
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "$ref": "parameters.acceptLanguage",
        "description": "ResultBean 消息语言；缺失或不支持时回退 en-US"
      }
    ],
    "requestBody": {
      "required": true,
      "contentType": "application/json",
      "description": "以下为 Builtin 请求约束，不定义 Skill 请求；共享入口须先选择命令类别，再应用对应约束。name 必填，长度 1～64，匹配 ^[a-z0-9]+(?:-[a-z0-9]+)*$ 且不含 Slash。arguments 可省略或为 null，最多 262144 个 UTF-16 代码单元。只接受 name 和 arguments；fileIds 和其他未知字段按 INVALID_COMMAND_REQUEST 拒绝。If-Match 和 Idempotency-Key 在 Builtin 请求中没有契约语义，出现时按 INVALID_COMMAND_REQUEST 拒绝。 Help 只接受空参数：arguments 缺省/null/空白由 Service 归一为空；非空参数（包括 model 等命令名）按 INVALID_COMMAND_REQUEST 拒绝，不查询命令详情。",
      "example": {
        "name": "model",
        "arguments": "model_011CZq2GkV8aD4NwP7sLmXfS"
      },
      "examples": [
        {
          "label": "Help：无参 Agent 使用指南",
          "description": "idle/running 均可查询；不改变其他 Builtin 的参数规则。",
          "value": {
            "name": "help"
          }
        },
        {
          "label": "Status：查询 Session",
          "value": {
            "name": "status"
          }
        },
        {
          "label": "Name：查询 Session 名称",
          "value": {
            "name": "name"
          }
        },
        {
          "label": "Name：修改名称",
          "value": {
            "name": "name",
            "arguments": "园区网络故障分析"
          }
        },
        {
          "label": "Model：查询可选模型",
          "value": {
            "name": "model"
          }
        },
        {
          "label": "Model：切换模型",
          "value": {
            "name": "model",
            "arguments": "model_011CZq2GkV8aD4NwP7sLmXfS"
          }
        },
        {
          "label": "Thinking：查询开关",
          "value": {
            "name": "thinking"
          }
        },
        {
          "label": "Thinking：开启",
          "value": {
            "name": "thinking",
            "arguments": "on"
          }
        },
        {
          "label": "Compact：压缩",
          "value": {
            "name": "compact"
          }
        },
        {
          "label": "Skills：查询绑定技能",
          "value": {
            "name": "skills"
          }
        }
      ]
    },
    "responses": [
      {
        "id": "200-help",
        "status": "200",
        "tabLabel": "200 · help",
        "label": "OK",
        "summary": "Help 只接受空参数，idle/running 均可查询。result 必填且精确为 displayName、description、userCases。displayName 为非空 Agent 显示名，空白时回退 Agent name，不是 Session 名称。description/userCases 为必填非 null 字符串数组，去除条目两端空白和空白条目，保持作者顺序与内部换行；不翻译、不生成能力说明。以下为虚构示例。",
        "headers": {
