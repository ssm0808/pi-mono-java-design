{
  "operation": {
    "shortName": "执行会话命令",
    "operationKey": "executeSessionCommand",
    "method": "POST",
    "path": "/sessions/{sessionId}/command",
    "summary": "执行一个 Builtin 命令并返回 JSON 结果",
    "description": "只执行 help、status、name、model、thinking、compact 和 skills。Service 将省略或 null 的 arguments 归一为空字符串，拒绝未知字段、skill:* 和附件。成功返回普通 ResultBean JSON，不生成公开 commandId，不保存 command.started/completed/failed；Name 只保存当前名称，Model/Thinking/Compact 复用权威领域 Entry。Compact 被接受后断线不取消，结果不确定时通过 GET Session/Events 对账，不自动重放 POST。本接口额外必填 access-token。Claw 从请求读取四项凭据，非 Compact 命令只在内存中保留到本次命令处理结束；Compact 仅在 Active Holder 保留到压缩及排队续跑结束。仅随实际 Mate tool execute 原名发送，不写入 Session、事件或日志，不进入 Prompt，也不随工具发现、模型或其他请求发送；Claw 不解析或校验凭据。",
    "requestHeaderExamples": [
      {
        "id": "jwt",
        "label": "JWT Header 示例",
        "preferred": true,
        "headers": [
          {
            "name": "X-HW-ID",
            "value": "credential-jwt",
            "required": true,
            "description": "用户凭据 ID；不是公司、服务或应用标识。Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到排队续跑结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          },
          {
            "name": "Authorization",
            "value": "Bearer opaque-token",
            "required": true,
            "description": "Bearer JWT；Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到排队续跑结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          },
          {
            "name": "access-token",
            "value": "opaque-access-token",
            "required": true,
            "description": "Mate tool 调用凭据；Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到排队续跑结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          }
        ]
      },
      {
        "id": "appkey",
        "label": "APPKEY Header 示例",
        "preferred": false,
        "headers": [
          {
            "name": "X-HW-ID",
            "value": "credential-appkey",
            "required": true,
            "description": "用户凭据 ID；不是公司、服务或应用标识。Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到排队续跑结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          },
          {
            "name": "X-HW-APPKEY",
            "value": "opaque-appkey",
            "required": true,
            "description": "AppKey 凭据；可与 Authorization 同时提供。Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到排队续跑结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          },
          {
            "name": "access-token",
            "value": "opaque-access-token",
            "required": true,
            "description": "Mate tool 调用凭据；Claw 只在内存中保留到本次命令处理结束，Compact 时由 Active Holder 保留到排队续跑结束；仅随实际 Mate tool execute 请求发送，不写入 Session、事件或日志"
          }
        ]
      }
    ],
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "$ref": "parameters.acceptLanguage",
        "description": "ResultBean 消息语言；缺失或不支持时回退 en-US"
      }
    ],
    "requestBody": {
      "required": true,
      "contentType": "application/json",
      "description": "name 必填，长度 1～64，匹配 ^[a-z0-9]+(?:-[a-z0-9]+)*$ 且不含 Slash。arguments 可省略或为 null，最多 262144 个 UTF-16 代码单元。只接受 name 和 arguments；fileIds 和其他未知字段按 INVALID_COMMAND_REQUEST 拒绝。If-Match 和 Idempotency-Key 在本接口没有契约语义，出现时按 INVALID_COMMAND_REQUEST 拒绝。",
      "example": {
        "name": "model",
        "arguments": "provider/model"
      }
    },
    "responses": [
      {
        "id": "200-help",
        "status": "200",
        "tabLabel": "200 · help",
        "label": "OK",
        "summary": "空参数返回全部七项；提供名称时去除两端空白后精确匹配一项，不接受前导 Slash。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "command": "help",
              "commands": [
                {
                  "name": "status",
                  "kind": "builtin",
                  "description": "查看 Session 状态、模型和深度思考",
                  "available": true,
                  "unavailableCode": null,
                  "input": {
                    "mode": "none",
                    "available": false,
                    "unavailableCode": "COMMAND_ARGUMENTS_NOT_SUPPORTED",
                    "acceptsFiles": false,
                    "placeholder": null,
                    "suggestions": []
                  }
                }
              ]
            }
          }
        }
      },
      {
        "id": "200-status",
        "status": "200",
        "tabLabel": "200 · status",
        "label": "OK",
        "summary": "返回持久化状态、模型和 Thinking，不估算上下文用量。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "command": "status",
              "state": "running",
              "modelId": "provider/model",
              "thinking": true
            }
          }
        }
      },
      {
        "id": "200-name",
        "status": "200",
        "tabLabel": "200 · name",
        "label": "OK",
        "summary": "返回当前名称和本次是否修改；displayName 即使为 null 也保留。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "command": "name",
              "displayName": null,
              "changed": false
            }
          }
        }
      },
      {
        "id": "200-model",
        "status": "200",
        "tabLabel": "200 · model",
        "label": "OK",
        "summary": "返回当前与可用模型；查询和同值操作省略 sourceEventSeq。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "command": "model",
              "currentModelId": "provider/model",
              "models": [
                "provider/model",
                "provider/model-fast"
              ],
              "changed": true,
              "sourceEventSeq": 23
            }
          }
        }
      },
      {
        "id": "200-thinking",
        "status": "200",
        "tabLabel": "200 · thinking",
        "label": "OK",
        "summary": "只接受小写 on/off；查询和同值操作省略 sourceEventSeq。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "command": "thinking",
              "thinking": false,
              "changed": true,
              "sourceEventSeq": 24
            }
          }
        }
      },
      {
        "id": "200-compact",
        "status": "200",
        "tabLabel": "200 · compact",
        "label": "OK",
        "summary": "压缩成功或无变化即返回，不等待 Steer/FollowUp 续跑；空历史 compacted=false，不占容量、不改变状态、不写 Entry，省略 sourceEventSeq。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "command": "compact",
              "compacted": true,
              "sourceEventSeq": 31
            }
          }
        }
      },
      {
        "id": "200-skills",
        "status": "200",
        "tabLabel": "200 · skills",
        "label": "OK",
        "summary": "最新完整绑定快照中的名称和描述稳定排序；完整空快照返回 []，无完整快照返回 AGENT_NOT_AVAILABLE。",
        "headers": {
          "Content-Type": "application/json",
          "Cache-Control": "no-store",
          "Content-Language": "zh-CN"
        },
        "bodies": {
          "zh-CN": {
            "resCode": "0",
            "resMsg": "success",
            "result": {
              "command": "skills",
              "skills": []
            }
          }
        }
      },
