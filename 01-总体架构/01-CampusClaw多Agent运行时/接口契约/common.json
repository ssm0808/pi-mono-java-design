{
  "api": {
    "title": "CampusClaw Service API",
    "version": "1.43.2",
    "basePath": "/campusclaw-service/v1",
    "visibility": "Internal · 已确认",
    "fieldNaming": "lowerCamelCase",
    "headerNaming": "保留原名"
  },
  "resourceIdPatterns": {
    "agent": "^agent-[0-9a-fA-F]{32}$",
    "tool": "^tool-[0-9a-fA-F]{32}$",
    "skill": "^skill-[0-9a-fA-F]{32}$",
    "session": "^session-[0-9a-fA-F]{32}$",
    "command": "^command-[0-9a-f]{32}$"
  },
  "commandNamePatterns": {
    "builtin": "^[a-z0-9-]+$",
    "skill": "^skill:[a-z0-9-]+$"
  },
  "requestHeaderExamples": [
    {
      "id": "jwt",
      "label": "JWT Header 示例",
      "preferred": true,
      "headers": [
        {
          "name": "X-HW-ID",
          "value": "<CALLER_ID>",
          "required": true,
          "description": "公司调用方标识"
        },
        {
          "name": "Authorization",
          "value": "Bearer <JWT>",
          "required": true,
          "description": "由上游完成真实性与格式检查；Runtime Controller 仅接收调用上下文"
        }
      ]
    },
    {
      "id": "appkey",
      "label": "APPKEY Header 示例",
      "preferred": false,
      "headers": [
        {
          "name": "X-HW-ID",
          "value": "<CALLER_ID>",
          "required": true,
          "description": "公司调用方标识"
        },
        {
          "name": "X-HW-APPKEY",
          "value": "<APPKEY>",
          "required": true,
          "description": "由上游完成真实性与格式检查；可与 Authorization 同时出现，Runtime 不做互斥检查"
        }
      ]
    }
  ],
  "parameters": {
    "agentId": {
      "in": "path",
      "name": "agentId",
      "required": true,
      "schema": {
        "$ref": "resourceIdPatterns.agent"
      },
      "description": "创建后不可变的 Agent 绑定；格式为 agent- 加去掉连字符的 32 位十六进制 UUID"
    },
    "sessionId": {
      "in": "path",
      "name": "sessionId",
      "required": true,
      "schema": {
        "$ref": "resourceIdPatterns.session"
      },
      "description": "已经存在且未删除的 Session 标识；格式为 session- 加去掉连字符的 32 位十六进制 UUID"
    },
    "acceptLanguage": {
      "in": "header",
      "name": "Accept-Language",
      "required": false,
      "schema": "zh-CN | en-US",
      "description": "异常消息语言；缺失或不支持时回退 en-US"
    }
  }
}
