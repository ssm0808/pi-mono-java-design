{
  "api": {
    "title": "CampusClaw Service API",
    "version": "1.58.0",
    "basePath": "/campusclaw-service/v1",
    "visibility": "Internal · 已确认",
    "fieldNaming": "lowerCamelCase",
    "headerNaming": "保留原名"
  },
  "resourceIdPatterns": {
    "agent": "^agent-[0-9a-fA-F]{32}$",
    "tool": "^tool-[0-9a-fA-F]{32}$",
    "skill": "^skill-[0-9a-fA-F]{32}$",
    "session": "^session-[0-9a-fA-F]{32}$"
  },
  "commandNamePatterns": {
    "builtin": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "commandLimits": {
    "builtinNameCharacters": 64,
    "argumentsUtf16CodeUnits": 262144
  },
  "requestHeaderExamples": [
    {
      "id": "jwt",
      "label": "JWT Header 示例",
      "preferred": true,
      "headers": [
        {
          "name": "X-HW-ID",
          "value": "credential-jwt",
          "required": false,
          "description": "可选的用户凭据 ID；不是公司、服务或应用标识。Claw 只捕获已提供值，不在 HTTP 入口校验"
        },
        {
          "name": "Authorization",
          "value": "Bearer opaque-token",
          "required": false,
          "description": "可选的 Bearer JWT；Claw 只捕获已提供值，不在 HTTP 入口校验"
        }
      ]
    },
    {
      "id": "appkey",
      "label": "APPKEY Header 示例",
      "preferred": false,
      "headers": [
        {
          "name": "X-HW-ID",
          "value": "credential-appkey",
          "required": false,
          "description": "可选的用户凭据 ID；不是公司、服务或应用标识。Claw 只捕获已提供值，不在 HTTP 入口校验"
        },
        {
          "name": "X-HW-APPKEY",
          "value": "opaque-appkey",
          "required": false,
          "description": "可选的 AppKey 凭据；Claw 只捕获已提供值，不在 HTTP 入口校验；可与 Authorization 同时提供"
        }
      ]
    }
  ],
  "parameters": {
    "agentId": {
      "in": "path",
      "name": "agentId",
      "required": true,
      "schema": {
        "$ref": "resourceIdPatterns.agent"
      },
      "description": "创建后不可变的 Agent 绑定；格式为 agent- 加去掉连字符的 32 位十六进制 UUID"
    },
    "sessionId": {
      "in": "path",
      "name": "sessionId",
      "required": true,
      "schema": {
        "$ref": "resourceIdPatterns.session"
      },
      "description": "已经存在且未删除的 Session 标识；格式为 session- 加去掉连字符的 32 位十六进制 UUID"
    },
    "acceptLanguage": {
      "in": "header",
      "name": "Accept-Language",
      "required": false,
      "schema": "zh-CN | en-US",
      "description": "异常消息语言；缺失或不支持时回退 en-US"
    }
  }
}
