@startuml target_session_events_resource_model
title CampusClaw Target POST Events and History
' Source evidence: pi-mono-java 918005ee8ccc88d179fc31a0de17a92b4a01383b.
' campusclaw/src/main/java/com/huawei/hicampus/claw/codingagent/runtimeapi/web/RuntimeEventController.java,
' submit/list, lines 61-91: POST SSE and GET history; no standalone read stream.
' campusclaw/src/main/java/com/huawei/hicampus/claw/codingagent/runtimeapi/event/RuntimeEventService.java,
' prepareAndSubmitLocked/acceptUserEntry, lines 101-141: persist message then start.
' These files are unchanged from a8192e047f4061bd385297d3dc6c4358362d0d49.
' Observed behavior: current Java already uses request-scoped POST SSE.
' Confirmed target architecture: combine submission and output in one POST;
' the first business frame is the complete accepted user event, exactly once.
' Design reason: remove the gap between a write and an independent live subscription.
' Target-only: union input, response projection, causal ordering and fixed snapshot.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequence {
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ArrowColor #475569
}
actor "mate-service" as Mate
participant "Event Application Service\n<<target-only>>" as API
participant "Request Output Binding\n<<target-only>>" as Binding
participant "Ordered Event Appender\n<<target-only>>" as Append
database "Session Store" as Store
participant "Execution Coordinator\n<<existing-changed>>" as Execution
participant "Request SSE Writer\n<<per POST>>" as Writer

Mate -> API : POST /sessions/{sessionId}/events
API -> Binding : reserve bounded response capacity
critical Session admission and target binding
  API -> Binding : bind this message, resume segment or interrupt target
  API -> Append : validate dependencies and accept user event
  Append -> Store : short transaction: recheck, allocate sequence, append
  Store --> Append : committed user event
  Append --> API : accepted event
  API -> Binding : enqueue complete user receipt first
  API -> Execution : start, resume or interrupt the bound target
end
Binding -> Writer : release ordered response frames
Writer --> Mate : 200 SSE; data: complete user.* receipt

loop Output belonging to the bound request scope
  alt Preview only
    Execution -> Binding : preview delta best-effort
  else Authoritative event
    Execution -> Append : authoritative event
    Append -> Store : ordered commit outside model/tool calls
    Store --> Append : committed event
    Append -> Binding : publish after commit in Session order
  end
  Binding -> Writer : response-specific immutable event
  Writer --> Mate : data: agent.* JSON
end
group Candidate closing rule, not yet confirmed
  Execution -> Append : corresponding idle state
  Append -> Store : commit authoritative terminal boundary
  Append -> Binding : publish matching session.status_idle
  Binding -> Writer : enqueue idle, then complete this response
  Writer --> Mate : data: idle; response ends
end
Mate -> API : GET /sessions/{sessionId}/events
API -> Store : query fixed snapshot in committed internal order
Store --> API : ordered complete events
API --> Mate : ResultBean JSON history

note over API,Execution
No public executionId, runId or sequence.
Credentials belong only to the required in-memory execution.
Do not hold a DB transaction while calling models, tools or network writers.
end note
note over Binding,Writer
Never broadcast unrelated Session events to this response.
A closed response does not cancel accepted execution.
History repairs uncertainty; never replay the POST automatically.
end note
@enduml

@startuml target_session_events_classes
title CampusClaw Target Request-scoped Event Classes
' Source evidence: pi-mono-java 918005ee8ccc88d179fc31a0de17a92b4a01383b.
' campusclaw/src/main/java/com/huawei/hicampus/claw/codingagent/runtimeapi/event/RuntimeEventStream.java,
' attach/detachInternal, lines 93-159: bounded single-subscriber stream.
' campusclaw/src/main/java/com/huawei/hicampus/claw/codingagent/runtimeapi/event/RuntimeExecutionCoordinator.java,
' completeExecution, lines 154-168: persistence, terminal events, stream completion.
' Observed behavior: a current stream belongs to one active execution.
' Target-only architecture: per-request bindings support union input without a
' public Session subscription API. Exact control-output routing remains proposed.
' Design reason: keep web VOs, application admission, runtime and persistence separate;
' retain independent response backpressure and shared causal append ordering.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475569
  ArrowColor #64748B
}
top to bottom direction

package "runtimeapi.web" {
  class RuntimeEventController <<singleton, existing-changed>>
  class RuntimeSseEmitterSubscriber <<per response, existing-changed>>
}
package "runtimeapi.vo" {
  class SubmitSessionEventRequestVO <<validated request, target-only>>
  class SessionEventResponseVO <<immutable response, target-only>>
}
package "runtimeapi.application" {
  class SessionEventApplicationService <<singleton, target-only>>
  class SessionEventHandlerRegistry <<singleton, target-only>>
  interface SessionEventHandler <<target-only>>
  class UserMessageEventHandler <<singleton, target-only>>
  class UserInterruptEventHandler <<singleton, target-only>>
  class UserToolConfirmationEventHandler <<singleton, target-only>>
  class SessionEventAppender <<singleton, target-only>>
  class SessionEventQueryService <<singleton, existing-changed>>
  class SessionEventProjector <<per execution, target-only>>
}
package "runtimeapi.runtime" {
  class RuntimeExecutionCoordinator <<singleton, existing-changed>>
  class RuntimeActiveExecution <<per execution, existing-changed>>
}
package "runtimeapi.event" {
  class RequestEventRouter <<singleton, target-only>>
  class RequestOutputBinding <<per request, target-only>>
  class RequestEventStream <<per response, target-only>>
}
package "runtimeapi.persistence" {
  interface RuntimeSessionRepository <<existing-changed>>
  class MyBatisRuntimeSessionRepository <<singleton, existing-changed>>
}
package "runtimeapi.dto" {
  class RuntimeEntryDTO <<database data, existing-changed>>
}

RuntimeEventController --> SubmitSessionEventRequestVO : validates
RuntimeEventController --> SessionEventApplicationService : submit
RuntimeEventController --> SessionEventQueryService : list
RuntimeEventController --> RuntimeSseEmitterSubscriber : starts writer
RuntimeSseEmitterSubscriber --> SessionEventResponseVO : serializes
RuntimeSseEmitterSubscriber --> RequestEventStream : drains
SessionEventApplicationService --> SessionEventHandlerRegistry : selects handler
SessionEventHandlerRegistry o-- "3" SessionEventHandler
SessionEventHandler <|.. UserMessageEventHandler
SessionEventHandler <|.. UserInterruptEventHandler
SessionEventHandler <|.. UserToolConfirmationEventHandler
SessionEventHandler --> SessionEventAppender : recheck and accept
SessionEventHandler --> RuntimeExecutionCoordinator : start / interrupt / resume
SessionEventApplicationService --> RequestEventRouter : reserve and bind before action
RuntimeExecutionCoordinator *-- "0..1 per Session" RuntimeActiveExecution
SessionEventApplicationService *-- "0..*" SessionEventProjector : owns subscriptions
SessionEventProjector ..> RuntimeActiveExecution : observes normalized events
SessionEventProjector --> SessionEventAppender : ordered authoritative append
SessionEventAppender --> RuntimeSessionRepository : short transaction
SessionEventAppender --> RequestEventRouter : committed event, ordered
SessionEventProjector --> RequestEventRouter : preview
RequestEventRouter *-- "0..*" RequestOutputBinding
RequestOutputBinding --> "1" RuntimeActiveExecution : fixed internal target
RequestOutputBinding *-- "1" RequestEventStream
RequestEventStream o-- "0..*" SessionEventResponseVO : bounded queue
SessionEventQueryService --> RuntimeSessionRepository
RuntimeSessionRepository <|.. MyBatisRuntimeSessionRepository
MyBatisRuntimeSessionRepository --> RuntimeEntryDTO

note right of RequestOutputBinding
Message / resume segment or interrupt target.
Never resolve the latest active execution on every event.
No raw credentials or public execution identifier.
end note
note bottom of SessionEventAppender
All writers share causal prerequisite checks and ordered commit.
Allocate sequence and append atomically, retaining lock to commit.
Network and model/tool work stay outside the transaction.
Implementation names and scheduling remain target-only.
end note
note bottom of RequestEventStream
Receipt first, exactly once; then matching output.
Slow clients fail independently without cancelling execution.
DTOs never cross the HTTP response boundary.
end note
@enduml

@startuml target_session_live_stream_lifecycle
title CampusClaw POST SSE - Candidate Closing and Recovery
' Stable block name retained for existing SVG links; this is no longer a GET stream.
' Source evidence: pi-mono-java 918005ee8ccc88d179fc31a0de17a92b4a01383b.
' campusclaw/src/main/java/com/huawei/hicampus/claw/codingagent/runtimeapi/event/RuntimeTerminalEventFactory.java,
' emit, lines 34-57: current idle plus stream.end, or stream.error on failure.
' campusclaw/src/main/java/com/huawei/hicampus/claw/codingagent/runtimeapi/web/RuntimeSseEmitterSubscriber.java,
' onEvent/onComplete, lines 33-49: named SSE; explicit emitter completion.
' Confirmed: one POST for input/output, user receipt first, data-only and type+phase.
' Target-only: matching idle ends this response, confirming splits the interaction.
' Design reason: do not keep a completed request open for unrelated later messages.
' Control binding, idle reasons and exact closing behavior are still unconfirmed.
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam sequence {
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ArrowColor #475569
}
actor "mate-service" as Client
participant "POST Events API\n<<target-only>>" as API
participant "Bound Execution\n<<internal>>" as Execution
participant "Response A\n<<per request>>" as A
participant "Response B\n<<per request>>" as B
database "History Store" as Store

Client -> API : POST user.message
API -> A : reserve and bind before starting execution
API -> Store : accept and persist user event
API -> A : complete user.message receipt first
API -> Execution : start only after receipt is queued
A --> Client : data: user.message receipt
Execution -> A : matching agent events
A --> Client : data: agent.* output

alt Candidate: execution finishes
  Execution -> Store : commit done / failed boundary
  Execution -> A : corresponding idle, then complete
  A --> Client : data: session.status_idle; EOF
else Candidate: waiting for tool confirmation
  Execution -> Store : commit Tool Call and confirming boundary
  Execution -> A : tool call, confirming idle, then complete
  A --> Client : data: tool call; data: confirming idle; EOF
  Client -> API : new POST user.tool_confirmation
  API -> B : atomically bind valid pending tool and resume segment
  API -> Store : accept and persist confirmation
  API -> B : complete confirmation receipt first
  API -> Execution : resume
  B --> Client : data: user.tool_confirmation receipt
  Execution -> B : tool result, response, corresponding idle
  B --> Client : data: matching output; idle; EOF
else Candidate: interrupt while response A remains open
  Client -> API : new POST user.interrupt
  API -> B : bind exact active target before interrupt
  API -> Store : accept and persist interrupt
  API -> B : complete interrupt receipt first
  B --> Client : data: user.interrupt receipt
  API -> Execution : request stop of bound target
  Execution -> Store : commit actual stop boundary
  Execution -> A : final matching idle if still attached
  Execution -> B : same idle eventId, then complete
  A --> Client : data: terminated idle; EOF
  B --> Client : data: terminated idle; EOF
end

group Transport failure at any point
  Client -> Client : preserve uncertainty if no authoritative terminal
  note over A,B
  Detach only the failed response; do not cancel execution.
  No POST replay or independent GET stream reconnection.
  end note
  Client -> API : GET /sessions/{sessionId}/events
  API -> Store : fixed committed snapshot
  Store --> API : complete events in internal order
  API --> Client : ResultBean history
  Client -> Client : deduplicate by eventId; retain array order
end
@enduml
