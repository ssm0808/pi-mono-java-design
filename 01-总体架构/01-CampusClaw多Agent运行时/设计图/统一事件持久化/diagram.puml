class "AgentSessionFactory" as Factory <<单例>>
class "ManagedAgentSession" as Session <<每次执行>>
class "AgentLoop / ToolExecutionPipeline" as Loop <<每次执行>>
class "RuntimeEventProjector\n子写入完成反馈接线待实现" as Projector <<每次执行>>
class "RuntimeExecutionPersistenceService" as Persistence <<单例，短事务>>
class "RuntimeSessionRepository" as Repo <<数据库边界>>
class "RuntimeExecutionControlRepository" as Control <<数据库边界>>
class "CommittedEventProjection" as Public <<安全投影>>
class "t_session_execution_links\n六字段父子关系" as Links <<持久记录，待实现>>
