  class "PlanPolicyPromptComposer" as Policy <<target-only>> #EAF2FF
  class "BuiltInToolProperties" as Profile <<extended>> #FFF7DD
}
package "Request snapshot" as RequestLayer {
  class "SessionUpdateCandidateDTO" as Candidate <<target-only, immutable>> #EAF2FF {
    expectedVersion / submittedFields
    final values / resolved capabilities
  }
  class "RuntimeSessionView" as Response <<extended>> #FFF7DD {
    GetSessionResponseVO / ETag
  }
}
package "Persistence / adapters" as PersistenceLayer {
  interface "RuntimeSessionRepository" as Repo <<extended>> #FFF7DD {
    +updateConfiguration(sessionId, expectedVersion, candidateDTO)
  }
  class "MyBatisRuntimeSessionRepository" as Impl <<extended>> #FFF7DD
  interface "RuntimeSessionMapper" as Mapper <<extended>> #FFF7DD
  interface "RuntimeModelManager" as Models <<existing>> #ECFDF5
}
database "GaussDB\nSession + entries + public events" as DB
Name -[hidden]down- Model
Model -[hidden]down- Thinking
Assembler -[hidden]down- Policy
Policy -[hidden]down- Profile
API -[#2563EB]-> App : updateSession
API ..> Request : strict binding
API --> Result : wrap response VO
App -[#2563EB]-> Name : normalize only
App -[#2563EB]-> Model : resolve target only
App -[#2563EB]-> Thinking : validate final model
Model --> Models
App -[#2563EB]-> Policy : validate plan policy
App -[#2563EB]-> Profile : read fixed Runtime profile
App -[#2563EB]-> Candidate : creates once
App -[#2563EB]left-> Repo : one commit
Repo ..> Candidate : version-bound values
Repo <|.. Impl
Impl --> Mapper : DTO only
Mapper --> DB
App --> Assembler : committed Session DTO
Assembler --> Etag
Assembler ..> Response : same snapshot
API ..> Response
note bottom of Candidate
  No credentials and no mutable Agent.
  Snapshot is not final admission.
  Recheck version and state under the row lock.
end note
note bottom of Repo
  Name-only: idle or running.
  Any execution field: idle, even for equal values.
  One version increment; all fields/events or none.
end note
legend bottom left
  Green: existing. Amber: extended. Blue: new target-only.
  Blue arrows: new target-only calls.
  Preparation methods must not independently commit.
