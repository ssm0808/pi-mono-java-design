Caller -> API : Delete Session
API -> Store : Check state and commit logical deletion
alt Existing idle Session or already absent
  Store --> API : Deleted atomically, or already absent
  API --> Caller : 204 No Content
  Worker -> Store : Claim remaining cleanup work if present
  Worker -> Store : Retry cleanup; remove completed work item
else Running or commit failed
