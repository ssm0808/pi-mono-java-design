@startuml target_event_history_paging
' Source baseline: pi-mono-java dfb90cac4e233e09a0b8f047f7e9f4682f5ad238
' Source: campusclaw/src/main/resources/mapper/session/RuntimeSessionMapper.xml, listCurrentBranch.
