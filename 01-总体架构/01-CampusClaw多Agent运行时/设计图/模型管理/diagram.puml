@startuml model_manager_streaming_flow
skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam maxMessageSize 190
skinparam sequenceArrowColor #526777
skinparam sequenceLifeLineBorderColor #BAC4CC
skinparam sequenceParticipantBackgroundColor #F5F7FA
skinparam sequenceParticipantBorderColor #8496A4
skinparam sequenceGroupBackgroundColor #F5F7FA
skinparam sequenceGroupBorderColor #BAC4CC
skinparam noteBackgroundColor #FFFBEF
skinparam noteBorderColor #D2C6A5
hide footbox
autonumber
title Model Manager Provider Streaming Flow

' Source evidence (pi-mono 5cd93f688aaab89dbb6dfa4aca535f21796ae185):
' packages/ai/src/types.ts, Model, Context, AssistantMessageEvent, and Usage.
' packages/coding-agent/src/core/agent-session.ts, _checkCompaction and _runAutoCompaction.
' packages/coding-agent/src/core/compaction/compaction.ts, generateSummaryWithUsage.
' packages/ai/src/utils/overflow.ts, isContextOverflow and isRecoverableLength.
' Source evidence (pi-mono-java PR 167 f60cc3e78bb8b700527ac082c7c8e10524ede095):
' modules/ai/src/main/java/com/campusclaw/ai/provider/ApiProvider.java, ApiProvider.
' modules/ai/src/main/java/com/campusclaw/ai/provider/ApiProviderRegistry.java, ApiProviderRegistry.
' modules/ai/src/main/java/com/campusclaw/ai/types/SimpleStreamOptions.java, metadata.
' modules/ai/src/main/java/com/campusclaw/ai/stream/AssistantMessageEvent.java, event records.
' Observed behavior: Java dispatches by Model.api to a Spring-discovered ApiProvider.
' Implemented source baseline (pi-mono-java bd26e7f81bac8f68be0c3523efe23b51f96c52e4):
' modules/agent-core/src/main/java/com/campusclaw/agent/Agent.java, buildStreamOptions.
' modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/compaction/SessionCompactor.java, decide.
' Architecture change: one MODEL_MANAGER Api routes every managed model through Model Manager.
' Design reason: model_id selects the model while agent_id authorizes it for the current Agent.
' Architecture change: ManagedAgentSession owns compaction calls and preserves their returned Usage.


actor Client
participant "Events application\n(pending implementation)" as Events
participant "Managed Agent\nSession" as Session
participant "AgentLoop" as Loop
participant "CampusClaw\nAI Service" as AiService
participant "Api Provider\nRegistry" as Registry
participant "Model Manager\nAPI Provider" as Provider
participant "Model Manager" as ModelManager

== Execute an accepted message ==
Client -> Events : POST user.message
Events -> Session : execute accepted message
Session -> Loop : prompt
Loop -> AiService : stream(model, Context, options)\nmodel max output if no caller override
AiService -> Registry : getProvider(MODEL_MANAGER)
Registry --> AiService : ModelManagerApiProvider
AiService -> Provider : streamSimple(model, Context, metadata)
Provider -> Provider : require immutable agent_id,\nsession_id, and Trace Context
Provider -> ModelManager : invoke(agent_id, model.id,\nContext, mapped options)
ModelManager -> ModelManager : revalidate Agent model binding

loop stream events
  ModelManager --> Provider : start, content delta,\ntool call, done or error
  Provider --> AiService : AssistantMessageEvent
  AiService --> Loop : AssistantMessageEvent
end

== Compact only a prepared safe window ==
opt a safe prepared threshold or overflow window exists
  Session -> AiService : completeSimple(model, summary Context, options)
  AiService -> Registry : getProvider(MODEL_MANAGER)
  Registry --> AiService : ModelManagerApiProvider
  AiService -> Provider : streamSimple(model, summary Context, metadata)
  Provider -> ModelManager : invoke authorized compaction request
  ModelManager --> Provider : completed summary with Usage
  Provider --> AiService : full summary and Usage
  AiService --> Session : full summary and Usage
  alt ERROR or LENGTH overflow and first recovery attempt
    Session -> Loop : continue execution once with compacted context
  else successful STOP overflow
    Session -> Session : preserve answer and do not replay
  end
end

== Stop the fixed execution ==
opt Session-scoped interrupt (pending implementation)
  Client -> Events : POST /sessions/{sessionId}/events\nuser.interrupt
  Events -> Events : persist fixed-target stop request\ninstance batch check and local cancellation
  Events -> Loop : request cancellation of fixed execution
  Loop -> Provider : cancel model subscription
  Provider -> ModelManager : close stream
end

' Pending implementation control migration, confirmed 2026-09-07: no independent abort route.
' Source: pi-mono-java@dfb90cac RuntimeSessionControlService.requireRunningHolder uses local state.
' Design reason: Events application coordinates DB-backed cancellation; HTTP never calls AgentLoop directly.

note over Provider,ModelManager
  The Provider maps events only. Tool execution
  remains in AgentLoop. No fallback to built-in
  providers.
end note

note over Session,ModelManager
  Compaction uses the same Agent model authority. The
  returned input, output, cache, total token, and USD
  cost fields are persisted with the compaction
  completion event. Summary calls have no tools or
  cache and use a fresh routing ID. Recoverable LENGTH
  compares the same desired max output sent on the
  request.
end note
@enduml
