{
  "operation": {
    "shortName": "查询事件所在轮次",
    "operationKey": "ListTurnEvents",
    "method": "GET",
    "path": "/sessions/{sessionId}/events/{eventId}/turn",
    "summary": "由轮次中任意一条事件读取整轮完整事件",
    "description": "以会话中的一条事件为起点，定位它所属的轮次，即一条用户消息从受理到结束的完整处理，按保存顺序分页返回这一轮的全部完整事件，包括确认续跑后的多段与停止请求。",
    "parameters": [
      {
        "$ref": "parameters.sessionId"
      },
      {
        "in": "path",
        "name": "eventId",
        "required": true,
        "schema": "string 1..128",
        "description": "会话内的事件标识，可以是这一轮中的任意一条事件；通常来自 ListAgentEvents 返回的 event.eventId。"
      },
      {
        "in": "query",
        "name": "page",
        "required": false,
        "schema": "integer >= 1; default 1",
        "description": "普通页码 1、2、3……，省略按第一页处理；有后续页时使用 nextPage。不是 eventId 或内部序号。"
      },
      {
        "in": "query",
        "name": "limit",
        "required": false,
        "schema": "integer 1..200; default 50",
        "description": "本页最多返回的完整事件条数，规则与 ListSessionEvents 相同。跨页保持相同 limit；改变大小时从 page=1 重新加载。"
      },
      {
        "$ref": "parameters.acceptLanguage"
      }
    ],
    "requestBody": {
      "required": false,
      "contentType": null,
      "description": "无请求体。示例：/sessions/session-0123…/events/entry_7K3M…/turn?page=1&limit=50。",
      "example": null
    },
    "responses": [
      {
        "id": "200-turn",
