    "contractSections": [
      {
        "title": "轮次规则",
        "columns": [
          "场景",
          "规则"
        ],
        "rows": [
          [
            "轮次",
            "一条 user.message 受理后的完整处理即一轮，包括确认、计划审核、问题回答后的续跑段和终态 session.status_idle；执行内自动压缩属于所在轮次。"
          ],
          [
            "起点",
            "user.message、确认/审核/回答、agent.*、session.status_idle 及计划批准产生的 session.mode_changed 按所属执行定位；user.interrupt 按 targetEventId 定位被停止的轮次。"
          ],
          [
            "不属于轮次",
            "用户主动修改模型、思考、模式以及手动压缩在执行之外提交，返回 404 EVENT_TURN_NOT_FOUND。"
          ],
          [
            "顺序与分页",
            "按会话内保存顺序升序，整数页码规则与 ListSessionEvents 相同。轮次内事件只在尾部追加，翻页不会移动已读位置。"
          ],
          [
            "响应",
            "只返回 events 与 nextPage，不返回轮次标识或结束标志：第一条即这一轮的 user.message，结束时最后一条是 session.status_idle。"
          ]
        ]
      }
    ],
    "requestHeaderExamples": [
      {
        "id": "json",
        "label": "请求 Header 示例",
        "preferred": true,
        "headers": [
          {
            "name": "Accept-Language",
            "value": "zh-CN",
            "required": false,
            "description": "错误消息语言；缺失或不支持时回退 en-US；不设置 Session 或模型回答语言"
          },
          {
            "name": "Accept",
            "value": "application/json",
            "required": false,
            "description": "可选；接收普通 JSON 响应。"
          }
        ]
      }
    ]
  },
  "review": {
    "questions": [],
    "headerReview": {
      "status": "confirmed",
      "confirmedAt": "2026-10-12",
      "decision": "与 ListSessionEvents 相同：只声明可选 Accept 与 Accept-Language，不声明或消费执行凭据 Header；不改变上游授权，不拒绝额外收到的 Header。"
    }
  },
  "designStatus": "implemented-in-pr"
