@startuml file_upload_and_scan_flow
title File Streaming Upload and Asynchronous Scan

' Source evidence:
' pi-mono packages/agent/src/agent.ts, prompt
' pi-mono packages/ai/src/types.ts, ImageContent
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/types/ImageContent.java, ImageContent
' Observed behavior: both baselines accept inline image content but have no generic upload and scan API.
' Architecture change: mate-service streams files to private OBS and stores metadata in openGauss.
' Security hardening: uploaded scripts remain untrusted bytes and are never executed.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "CampusMate Client" as client
participant "mate-service File API" as api
database "Mate Chat Store" as chats
database "Shared openGauss" as db
participant "Private OBS" as obs
participant "Scan Worker" as worker
participant "Security Scanner" as scanner

client -> api : POST /v1/chats/{chat_id}/attachments\nJWT, file, X-File-Size, and Prefer
api -> chats : authorize chat_id and resolve session_id
chats --> api : authorized session_id
api -> api : normalize filename and validate size
api -> api : generate file_id
api -> db : insert t_file and t_file_active_detail
db --> api : identity committed
api -> obs : create-only streaming PUT by file_id
obs --> api : immutable object persisted
api -> api : verify length, EOF, and SHA-256
api -> db : set PROCESSING and trusted digest
db --> api : update committed

alt Prefer wait and READY within at most 10 seconds
  worker -> db : claim short scan lease and commit
  worker -> obs : streaming GET by file_id
  obs --> worker : bounded byte stream
  worker -> scanner : sniff MIME and scan stream
  scanner --> worker : safe
  worker -> db : conditional READY update
  api --> client : 201 ResultBean with READY resource
else default, asynchronous, or wait expires
  api --> client : 202 ResultBean with PROCESSING resource
  worker -> db : claim short scan lease and commit
  worker -> obs : streaming GET by file_id
  obs --> worker : bounded byte stream
  worker -> scanner : sniff MIME and scan stream
  scanner --> worker : safe, blocked, or failure
  worker -> db : conditional terminal or retry update
end

note over api,obs
No Pod-local file and no complete byte array.
file_id is the exact OBS Object Key.
Create-only conflict enters audited quarantine.
end note

note over db,worker
OBS I/O and scanning never hold a DB transaction.
Only READY files can be resolved by CampusClaw.
end note
@enduml

@startuml file_obs_opengauss_storage_split
!pragma layout elk
title File OBS and openGauss Responsibility Split

' Source evidence:
' pi-mono packages/ai/src/types.ts, ImageContent
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/types/ImageContent.java, ImageContent
' Observed behavior: source images are inline; neither baseline defines a shared large-object authority.
' Architecture change: OBS owns immutable bytes and openGauss owns identity, state, and worker leases.
' Product constraint: Mate Chat Store alone owns chat_id to session_id mappings.
' Design reason: isolate large-object throughput from relational state and database backup.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam ComponentBorderColor #475569
skinparam ComponentBackgroundColor #F8FAFC
skinparam DatabaseBorderColor #475569
skinparam DatabaseBackgroundColor #F8FAFC

rectangle "mate-service Deployment" as mate {
  component "File API Pod A" as a
  component "File API Pod B" as b
  component "Scan and Delete Worker" as worker
  interface "FileContentStore" as port
  component "ObsFileContentStore" as adapter
  a --> port : stream by file_id
  b --> port : stream by file_id
  worker --> port : stat or delete by file_id
  port --> adapter : implemented by
}

database "Mate Chat Store\nchat_id to session_id" as chats
database "Shared openGauss" as db {
  rectangle "t_file\npermanent identity and status" as main
  rectangle "t_file_active_detail\nremoved after content deletion" as detail
  main -- detail : one-to-one while active
}
cloud "Private OBS\nimmutable file bytes" as obs
component "CampusClaw" as runtime

a --> chats : authorize chat and resolve Session
b --> chats : authorize chat and resolve Session
a --> db : metadata transactions
b --> db : metadata transactions
worker --> db : lease and state transactions
adapter --> obs : TLS and private bucket
runtime --> b : internal resolve and content stream

note bottom of db
t_file retains file_id, session_id, status,
created_at, and deleted_at as a permanent tombstone.
Active detail owns filename, trusted MIME, size,
digest, reference, expiry, retry, and lease fields.
end note

note bottom of obs
One immutable object per file_id.
The exact Object Key equals file_id.
There is no second resource id, prefix, or file-name part.
end note

note bottom of mate
No BLOB, URL, credential, local file,
authoritative in-memory map, or complete file cache.
end note
@enduml

@startuml file_cross_pod_resolution_flow
title Cross-Pod File Resolution and Content Streaming

' Source evidence:
' pi-mono packages/agent/src/agent.ts, prompt
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java, prompt
' Observed behavior: neither baseline has a generic file reference or cross-service content resolver.
' Architecture change: CampusClaw resolves ordered file_ids and streams verified content through mate-service.
' Security hardening: CampusClaw receives no OBS location or credential and validates length and digest.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

participant "CampusClaw" as runtime
participant "mate-service File API" as api
database "Shared openGauss" as db
participant "Private OBS" as obs
participant "Model Input Adapter" as model

runtime -> api : POST /internal/v1/files:resolve\nservice credential, sessionId, ordered fileIds
api -> api : select exactly one auth mode
api -> db : begin and lock all IDs in stable order
db --> api : matching rows
api -> api : require same Session, READY, and active

alt any file fails validation
  api -> db : rollback
  api --> runtime : ErrorResponse without result
else complete batch is valid
  api -> db : preserve referenced_at and clear expiry
  db --> api : ordered trusted snapshots
  api --> runtime : ResultBean with ordered files
end

loop each accepted file
  runtime -> api : GET content with session_id, file_id, and expected SHA-256
  api -> db : authorize READY and referenced file
  db --> api : size, digest, and trusted MIME
  api -> obs : streaming GET by file_id
  obs --> api : bounded original bytes
  api --> runtime : binary stream, length, and SHA-256
  runtime -> runtime : incrementally verify length and digest
  runtime -> model : provider-neutral untrusted content
end

note over runtime,api
Resolve is all-or-nothing and preserves request order.
Runtime stores only a trusted metadata snapshot with the User Entry.
end note

note over api,obs
Backpressure and cancellation propagate through the content stream.
No local file or complete in-memory object is created.
end note
@enduml

@startuml file_deletion_and_reconciliation
title File Deletion and Reconciliation

' Source evidence:
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java, abort
' Observed behavior: the baseline has no generic file tombstone, lease, or reconciliation flow.
' Architecture change: conditional database state, short leases, and idempotent OBS operations replace XA.
' Product constraint: referenced files are retained until Chat and Runtime Session cleanup.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "CampusMate Client" as client
participant "mate-service" as mate
participant "CampusClaw" as runtime
database "Mate Chat Store" as chats
database "Shared openGauss" as db
participant "Delete and Reconcile Worker" as worker
participant "Private OBS" as obs

group Delete one unreferenced file
  client -> mate : DELETE /v1/chats/{chat_id}/attachments/{file_id}
  mate -> chats : authorize chat and resolve session_id
  chats --> mate : authorized session_id
  mate -> db : conditional state update
  alt file is referenced
    db --> mate : referenced_at is set
    mate --> client : 409 FILE_REFERENCED
  else object-key conflict quarantine
    db --> mate : retain FAILED active detail
    mate --> client : bounded 503
  else unreferenced or already deleting
    db --> mate : DELETING persisted or already present
    mate --> client : 202 ResultBean
  end
end

group Chat and Runtime Session deletion
  client -> mate : delete Chat
  mate -> chats : authorize chat and load session_id
  chats --> mate : authorized session_id
  mate -> runtime : DELETE Runtime Session
  runtime --> mate : Session hidden and execution stopped
  mate -> db : mark normal Session files DELETING
  db --> mate : cleanup registered
end

group Background delete
  worker -> db : claim expired DELETING lease and commit
  db --> worker : file_id and row_version
  worker -> obs : idempotent DELETE by file_id
  alt deleted or NotFound
    obs --> worker : success
    worker -> db : delete active detail and mark DELETED
  else temporary failure
    obs --> worker : retryable error
    worker -> db : schedule bounded retry and release lease
  end
end

group Audited reconciliation
  worker -> db : find stale or quarantined rows
  db --> worker : candidate file_ids
  worker -> obs : stat by file_id
  alt owned valid object
    obs --> worker : matching object
    worker -> db : recover processing or delete safely
  else object absent
    obs --> worker : NotFound
    worker -> db : remove detail and mark DELETED
  end
end

note over db,obs
Database state controls eligibility.
OBS controls original-byte existence.
NotFound succeeds for idempotent deletion.
end note

note over mate,db
After deletion only file_id, session_id, status,
created_at, and deleted_at remain.
The ID is never issued again.
end note
@enduml
