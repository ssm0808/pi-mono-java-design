class t_agent_definition <<current Agent>> {
  id: VARCHAR PK
  type: VARCHAR
  version: BIGINT
  enabled: BOOLEAN
  name: VARCHAR UK
  display_name: VARCHAR
  description: TEXT
  role: TEXT?
  objective: TEXT?
  instructions: TEXT?
  tool_policy: TEXT?
  safety: TEXT?
  completion: TEXT?
  response_style: TEXT?
  example: TEXT?
  use_cases: JSONB
  created_at: TIMESTAMPTZ
  updated_at: TIMESTAMPTZ
}

class t_agent_binding_models <<binding_models>> {
  agent_id: VARCHAR PK
  model_id: VARCHAR PK
  model_order: INTEGER UK
}

class t_agent_binding_tools <<binding_tools and permission>> {
  agent_id: VARCHAR PK
  tool_id: VARCHAR PK
  tool_version: BIGINT?
  permission: deny | ask | allow | NULL
}

class t_agent_binding_skills <<binding_skills>> {
  agent_id: VARCHAR PK
  skill_id: VARCHAR PK
  skill_version: BIGINT?
}

class t_agent_binding_agents <<binding_agents>> {
  agent_id: VARCHAR PK
  bound_agent_id: VARCHAR PK
  bound_agent_version: BIGINT?
}

t_agent_definition *-- "1..*" t_agent_binding_models : binds models
t_agent_definition *-- "0..*" t_agent_binding_tools : binds and governs
t_agent_definition *-- "0..*" t_agent_binding_skills : binds skills
t_agent_definition *-- "0..*" t_agent_binding_agents : owns bindings
t_agent_binding_agents "0..*" --> "1" t_agent_definition : targets current Agent

