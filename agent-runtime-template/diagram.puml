@startuml agent_runtime_template_lifetimes
!pragma layout elk
title Agent Runtime Template, Session, and Execution Lifetimes

' Source evidence:
' pi-mono packages/coding-agent/src/core/agent-session.ts, AgentSession
' pi-mono packages/coding-agent/src/core/session-manager.ts, SessionManager
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java, initialize
' pi-mono-java modules/agent-core/src/main/java/com/campusclaw/agent/Agent.java, Agent
' Observed behavior: session initialization loads static resources while Agent owns mutable state.
' Architecture change: extract immutable static material into a revision-pinned shared template.
' Product constraint: execution is internal and has no public resource or id.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam ComponentBorderColor #475569
skinparam ComponentBackgroundColor #F8FAFC
skinparam DatabaseBorderColor #475569
skinparam DatabaseBackgroundColor #F8FAFC

rectangle "Bundle Revision Lifetime" {
  component "AgentRuntimeTemplate\ndeeply immutable" as template
  component "System Prompt" as prompt
  component "Skill Specs" as skills
  component "Tool Specs" as tools
  component "Model Allowlist" as models
  template *-- prompt
  template *-- skills
  template *-- tools
  template *-- models
}

rectangle "Session Lifetime" {
  component "AgentSession" as session
  component "Session Snapshot\nmodel and thinking" as snapshot
  database "Current-Branch Entries" as entries
  session *-- snapshot
  session --> entries
}

rectangle "Execution Lifetime" {
  component "ActiveExecution\ninternal only" as execution
  component "ExecutionContext" as context
  component "Cancellation and Queues" as control
  component "Request-Scoped SSE Writer" as sse
  execution *-- context
  execution *-- control
  execution --> sse : live projection
}

component "Stateless AgentRunner" as runner

session --> template : exact revision lease
session --> execution : at most one
runner --> template : static material
runner --> snapshot : session state
runner --> context : explicit input

note bottom of template
No Session, Entry, file, credential,
transport, or execution state.
end note

note bottom of execution
No public execution id is created.
Durable recovery uses Session Entries.
end note
@enduml

@startuml agent_runtime_template_publish_and_pin
title Template Publish, Activation, and Session Pinning

' Source evidence:
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/skill/SkillLoader.java, loadFromDirectory
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/prompt/SystemPromptBuilder.java, build
' Observed behavior: current code scans and builds resources during session initialization.
' Architecture change: move scanning and compilation into an immutable publish pipeline.
' Design reason: new activation must not change existing Session behavior.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "Metadata Publisher" as publisher
participant "Bundle Compiler" as compiler
database "Immutable Revision Store" as revisions
database "Current Activation Store" as activation
participant "Template Registry" as registry
participant "Session Service" as session
database "RuntimeSessionStore" as store

publisher -> compiler : compile fixed metadata revision
compiler -> compiler : normalize prompt, skills, tools, and manifest
compiler --> publisher : content-addressed bundle
publisher -> revisions : write temporary directory and verify hashes
publisher -> revisions : atomic publish revision B
publisher -> activation : CAS current from A to B
activation --> publisher : activation version advanced

group Create a new Session
  session -> activation : read current exact ref
  activation --> session : agent_id and revision B
  session -> registry : acquire exact ref B and Runner ABI
  registry -> revisions : validate and load on cache miss
  revisions --> registry : immutable bundle B
  registry --> session : TemplateLease B
  session -> store : commit Session pinned to B
  store --> session : session_id
end

group Recover an existing Session
  session -> store : load Session exact ref
  store --> session : agent_id and revision A
  session -> registry : acquire exact ref A and Runner ABI
  registry --> session : TemplateLease A
end

note over activation,store
Current affects only new Session creation.
Recovery never resolves current again.
end note
@enduml

@startuml template_cache_and_session_lifecycle
!pragma layout elk
title Template Cache and Session Lifecycle

' Source evidence:
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/AgentSession.java, initialize
' pi-mono-java modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/session/SessionManager.java, appendMessage
' Observed behavior: current Session objects load resources and persist local entries independently.
' Architecture change: introduce exact-key cache leases and database-backed Session records.
' Design reason: cache eviction must not alter revision retention or Session recovery.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #475569
skinparam ComponentBorderColor #475569
skinparam ComponentBackgroundColor #F8FAFC
skinparam DatabaseBorderColor #475569
skinparam DatabaseBackgroundColor #F8FAFC

database "Immutable Revision Store" as revisions
database "RuntimeSessionStore\nexact template refs and Entries" as sessions
component "Template Registry\nweighted exact-key cache" as registry
component "Single-Flight Loader\nkeyed by ref and Runner ABI" as loader
component "Session Holder A" as a
component "Session Holder B" as b
component "Revision GC" as gc

registry --> loader : cache miss
loader --> revisions : validate manifest and hashes
revisions --> loader : immutable bundle
loader --> registry : one shared load result
a --> registry : TemplateLease revision A
b --> registry : TemplateLease revision A
a --> sessions : current-branch Entry writes
b --> sessions : current-branch Entry writes
sessions --> gc : durable revision reference counts
gc --> revisions : delete only unreferenced expired revision

note bottom of registry
Cache key is agent_id, bundle_revision,
and current_runner_abi. Eviction requires
zero leases and never deletes the revision.
end note

note bottom of sessions
Session deletion retains only session_id and deleted_at.
Reference decrement occurs in a reliable cleanup workflow.
end note
@enduml

@startuml runtime_file_service_boundary
title Runtime and File Service Boundary

' Source evidence:
' pi-mono packages/ai/src/types.ts, ImageContent
' pi-mono-java modules/ai/src/main/java/com/campusclaw/ai/types/ImageContent.java, ImageContent
' Observed behavior: both baselines support inline image content but not a generic managed file service.
' Architecture change: mate-service owns file metadata and private OBS bytes; Runtime uses file_ids only.
' Security hardening: Runtime receives no OBS URL, bucket, credential, or caller-declared trusted MIME.

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #475569
  ParticipantBackgroundColor #F8FAFC
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

actor "CampusMate Client" as client
participant "mate-service File API" as files
database "Mate Chat Store" as chats
database "File Metadata in openGauss" as db
participant "Private OBS" as obs
participant "CampusClaw" as runtime
participant "Model Input Adapter" as model

client -> files : upload file for chat_id
files -> chats : authorize chat and resolve session_id
chats --> files : authorized session_id
files -> files : generate file_id
files -> db : create file metadata bound to session_id
files -> obs : streaming PUT with Object Key equal to file_id
obs --> files : immutable bytes stored
files --> client : ResultBean with file resource

client -> runtime : via mate-service POST Session Event with file_ids
runtime -> files : resolve session_id and ordered file_ids
files -> db : require READY, same Session, and not deleted
db --> files : trusted metadata snapshots
files --> runtime : ordered file metadata

loop each accepted file
  runtime -> files : GET content by session_id and file_id
  files -> obs : streaming GET by file_id
  obs --> files : original bytes
  files --> runtime : bounded bytes, length, and SHA-256
  runtime -> runtime : verify length and SHA-256
  runtime -> model : provider-neutral untrusted content
end

note over runtime,obs
file_id is the only resource id and exact OBS Object Key.
There is no second file resource id or object-key mapping.
Runtime never accesses OBS directly.
end note
@enduml
