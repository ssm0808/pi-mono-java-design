package "Runtime entry and assembly" {
  class "SkillCommandExecutionService /\nRuntimeMessageEventService" as Command <<integration>>
  class "RuntimeActiveExecution" as Execution <<per root>>
  class "RuntimeSessionEngineRegistry /\nAgentSessionFactory" as Factory <<singleton, assembly>>
}
package "Generic tool boundary" {
  class "ReadTool /\nSkillTool [P]" as Read <<integration>>
  class "ReadEvidenceDTO" as Evidence <<immutable, per call>>
  class "Final hook observer" as Observer <<pending implementation, per execution>>
}
package "Skill usage attribution" {
  class "ExecutionTargetDTO +\nSkill snapshot" as Snapshot <<immutable, per execution>>
  class "SkillUsageResolver" as Resolver <<pending implementation, singleton>>
  class "SkillUsageTracker" as Tracker <<pending implementation, per root>> {
    +onExplicit(candidate)
    +onRead(finalResult)
    +close()
    catches statistics failures
  }
  class "SkillUsageCandidateDTO" as Candidate <<pending implementation, immutable>>
}
package "Management query" {
  class "SkillUsageStatistics\nController" as Controller <<pending implementation, singleton>>
  class "SkillUsageStatistics\nQueryService" as Query <<pending implementation, singleton>>
}
package "Statistics persistence" {
  class "SkillUsageService" as Writer <<pending implementation, singleton>> {
    +record(candidateDTO)
    independent REQUIRES_NEW TX
  }
  interface "SkillUsageMapper" as Mapper <<pending implementation>>
}
database "GaussDB" {
    entity "Existing Session / root records" as Session
    entity "t_skill_usage" as Fact <<pending implementation>>
    entity "t_skill_usage_stats" as Total <<pending implementation>>
    entity "t_skill_usage_daily_stats" as Daily <<pending implementation>>
}
Factory --> Execution : assemble
Writer -[hidden]right-> Controller
Factory -[norank]-> Observer : install after mutations
Execution "1" *-- "1" Tracker : owns lifetime
Tracker "1" *-- "1" Snapshot : bound root and snapshot
Command --> Tracker : after admission commit\nbefore model start
Read "1" *-- "1 per call" Evidence
Evidence -[hidden]down-> Observer
Execution -[hidden]right-> Read
Observer --> Tracker : final result, no mutation
Tracker --> Resolver : attribute Read / Skill
Resolver -[norank]-> Evidence : verify body and fingerprint
Resolver --> Snapshot : match managed document
Tracker --> Candidate : freeze first signal
Tracker --> Writer : proxy call, outside main TX
Controller --> Query : request / response VO
Query --> Mapper : query DTO
Writer --> Mapper : write DTO
Mapper --> Session : admission / lifecycle lock
Mapper --> Fact : insert unique root + Skill
Mapper --> Total : increment only after insert
Mapper --> Daily : same statistics TX
note bottom of Fact
  PK: session_id + root_event_id + skill_id
  First recorded source and time remain unchanged.
  Statistics may miss signals; main execution continues.
end note
legend bottom left
  [P] SkillTool and its evidence integration: Pending implementation
endlegend
