' Source evidence: pi-mono-java@c9d858bc modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/command/SlashCommandSession.java:19-32
' Target-only design: each builtin contributes one definition, delegates to one handler, and reaches one narrow application service.
' Design reason: adding a builtin must not modify a central switch or create a dependency cycle through the catalog service.

package "Contributors" {
  interface BuiltinCommandContributor
  class HelpContributor
  class StatusContributor
  class NameContributor
  class ModelContributor
  class ThinkingContributor
  class CompactContributor
  class SkillsContributor
}

package "Handlers" {
  class HelpCommandHandler
  class StatusCommandHandler
  class NameCommandHandler
  class ModelCommandHandler
  class ThinkingCommandHandler
  class CompactCommandHandler
  class SkillsCommandHandler
}

package "Narrow application services" {
  class CommandHelpFormatter
  class SessionStatusQueryService
  class SessionNamingService
  class SessionModelConfigurationService
  class SessionThinkingConfigurationService
  class SessionCompactionApplicationService
  class AgentSkillCatalogService
  interface CommandCatalogView
}

BuiltinCommandContributor <|.. HelpContributor
BuiltinCommandContributor <|.. StatusContributor
BuiltinCommandContributor <|.. NameContributor
BuiltinCommandContributor <|.. ModelContributor
BuiltinCommandContributor <|.. ThinkingContributor
BuiltinCommandContributor <|.. CompactContributor
BuiltinCommandContributor <|.. SkillsContributor

HelpContributor --> HelpCommandHandler : binds
StatusContributor --> StatusCommandHandler : binds
NameContributor --> NameCommandHandler : binds
ModelContributor --> ModelCommandHandler : binds
ThinkingContributor --> ThinkingCommandHandler : binds
CompactContributor --> CompactCommandHandler : binds
SkillsContributor --> SkillsCommandHandler : binds

HelpCommandHandler --> CommandHelpFormatter
CommandHelpFormatter ..> CommandCatalogView : formats execution view
StatusCommandHandler --> SessionStatusQueryService
NameCommandHandler --> SessionNamingService
ModelCommandHandler --> SessionModelConfigurationService
ThinkingCommandHandler --> SessionThinkingConfigurationService
CompactCommandHandler --> SessionCompactionApplicationService
SkillsCommandHandler --> AgentSkillCatalogService

note bottom of HelpCommandHandler
The execution context supplies CommandCatalogView.
The handler does not inject CommandCatalogService
or CompositeCommandRegistry, so no bean cycle exists.
end note
@enduml
