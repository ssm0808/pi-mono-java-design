@startuml builtin_dispatch
title Builtin Command Dispatch
skinparam shadowing false

' Source evidence: pi-mono-java@c1311f69 mate-campusclaw/src/main/java/com/huawei/hicampus/mate/matecampusclaw/codingagent/command/builtin/ModelCommand.java:16-36
' Source evidence: pi-mono-java@c1311f69 mate-campusclaw/src/main/java/com/huawei/hicampus/mate/matecampusclaw/codingagent/command/SlashCommandSession.java:19-32
' Observed behavior: handlers currently depend on one broad mutable session facade.
' Target design: every builtin handler depends on one narrow application service.

participant CommandExecutionService as Execution
participant CommandAdmissionPolicy as Admission
participant BuiltinHandler as Handler
participant NarrowApplicationService as Service
participant RuntimeSessionRepository as Repository

Execution -> Admission : evaluate(descriptor, sessionState, input)
Admission --> Execution : admitted
Execution -> Repository : append command.started sidecar
Execution -> Handler : execute(immutable invocation)
Handler -> Service : read or update domain state
Service --> Handler : text and optional sourceEventSeq
Handler --> Execution : CommandResultDTO
Execution -> Repository : append command.completed sidecar
@enduml

@startuml builtin_availability
title Builtin Availability by Session State
skinparam shadowing false

' Source evidence: codex@be33f80b codex-rs/tui/src/chatwidget/slash_dispatch.rs:134-157
' Observed behavior: Codex blocks commands by task state at dispatch time.
' Target design: the catalog reports execution without and with arguments separately.

state idle {
  [*] --> AllBuiltins
  AllBuiltins --> ModelChange
  AllBuiltins --> ThinkingChange
  AllBuiltins --> Compact
}

state running {
  [*] --> HelpStatusSkills
  HelpStatusSkills --> NameViewAndChange
  HelpStatusSkills --> ModelThinkingViewOnly
}

note right of running
model without arguments: available=true
model with arguments: input.available=false
unavailableCode=SESSION_BUSY
end note
@enduml

@startuml session_name_update
title Session Name Update Transaction
skinparam shadowing false

' Source evidence: pi-mono@4af9d21d packages/coding-agent/src/core/agent-session.ts:3005-3012
' Source evidence: deepseek-harness@141eb6fe packages/session/session-title/src/index.ts:343-383
' Source evidence: codex@be33f80b codex-rs/app-server/src/request_processors/thread_processor.rs:1510-1541
' Observed behavior: peer harnesses persist Session or Thread names in the owning runtime domain.
' Architecture change: CampusClaw replaces the current NameCommand mate-service ownership comment.

participant NameCommandHandler as Handler
participant SessionNamingService as Naming
database t_sessions as Sessions
database t_session_entries as Entries

Handler -> Naming : changeDisplayName(sessionId, rawName)
Naming -> Naming : trim and reject blank, controls, newline, or over 80 UTF-8 bytes
Naming -> Sessions : lock current row
alt same normalized value
  Sessions --> Naming : unchanged success
else changed value
  Naming -> Sessions : update display_name, resource_version, updated_at
  Naming -> Entries : append session.name.changed sidecar
end
Naming --> Handler : text and optional sourceEventSeq
@enduml
