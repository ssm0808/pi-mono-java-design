' Source evidence: pi-mono-java@9d0d76f4 modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/command/ResolvedCommandCatalog.java list and find return discovery DTOs, not executable definitions yet.
' Source evidence: pi-mono-java@0bb794f2 modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/command/SkillCommandSource.java preparedRuntime.
' Source evidence: pi-mono-java@d84dd3d6 modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/event/RuntimeExecutionCoordinator.java start, finish, and releaseExecution.
' Source evidence: pi-mono-java@d84dd3d6 modules/coding-agent-cli/src/main/java/com/campusclaw/codingagent/runtimeapi/runtime/RuntimeSessionHolder.java managedSession and activeExecution.
' Observed behavior: discovery snapshots and Runtime execution collaborators exist at the cited baselines; executable Builtin assembly remains target-only.
' Design reason: preserve one connected global view; collapse repeated implementations, not responsibility boundaries.
' Architecture decision retained: narrow services own state changes; no generic command lifecycle or Name sidecar store.
' Target-only: every node and relationship below describes the target assembly, not an inventory of implemented behavior.

package "Web boundary" {
  class RuntimeCommandController {
    +list(sessionId)
    +execute(sessionId, request)
  }
  class "Request VOs / Immutable Response VOs" as CommandVOs
}

package "Application layer - singleton" {
  class CommandCatalogService
  class CommandExecutionService
  class CommandResponseAssembler
  class SkillExecutionService
  class PreparedSkillInvocationDTO <<immutable request snapshot>>
  class SessionEventApplicationService <<shared Events entry>>
}

package "Command core" {
  class CompositeCommandRegistry <<singleton>> {
    +resolve(context, kind)
  }
  class ResolvedCommandCatalog <<request snapshot>> {
    +list()
    +find(name)
  }
  interface CommandDefinitionSource {
    +list(context)
  }
  class BuiltinCommandSource <<singleton>>
  class SkillCommandSource <<singleton>>
  interface BuiltinCommandContributor
  interface CommandDefinition
  class BuiltinCommandDefinition <<immutable>>
  class SkillCommandDefinition <<immutable>>
  class SkillCommandHandler <<singleton adapter>>
  interface CommandAdmissionPolicy
  interface CommandHandler
}

package "Builtin adapters and service delegation - singleton" {
  class "7 x Builtin Contributor" as BuiltinContributors
  class "7 x Builtin Handler" as BuiltinHandlers
  class "Narrow Domain Services" as DomainServices
  class AgentHelpQueryService <<application service>> #E3F2E1
}

package "Runtime and persistence" {
  interface RuntimeSessionRepository
  class AgentRuntimeManager <<singleton>>
  class RuntimeExecutionCoordinator <<singleton>>
  class "RuntimeSessionEngineRegistry\nRuntimeSessionHolder / ManagedAgentSession\nRuntimeEventProjector" as RuntimeExecutionPorts <<grouped>>
}

