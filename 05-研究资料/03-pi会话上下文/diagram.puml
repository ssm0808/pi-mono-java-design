@startuml agent_session_context
' Source evidence:
' - packages/coding-agent/src/main.ts: main, createSessionManager, buildSessionOptions
' - packages/coding-agent/src/core/agent-session-services.ts: createAgentSessionServices
' - packages/coding-agent/src/core/resource-loader.ts: DefaultResourceLoader.reload
' - packages/coding-agent/src/core/package-manager.ts: DefaultPackageManager.resolve
' - packages/coding-agent/src/core/session-manager.ts: buildSessionContext
' - packages/coding-agent/src/core/sdk.ts: createAgentSession
' - packages/coding-agent/src/core/agent-session.ts: constructor, _buildRuntime, _rebuildSystemPrompt
' - packages/coding-agent/src/core/system-prompt.ts: buildSystemPrompt
' - packages/agent/src/agent.ts: createContextSnapshot
' - packages/agent/src/agent-loop.ts: streamAssistantResponse
' Source baseline: badlogic/pi-mono commit fc85bdd88be93b1e9a6b6bcfa41c684282ec79cc
' Observed behavior: file loading is split across model, settings, package, resource,
' and session services before AgentSession assembles tools and the base system prompt.
' Design reason: the diagram separates files that configure runtime behavior from
' content that is ultimately sent to the model.
title pi: From Resource Files to Model Context
top to bottom direction
skinparam shadowing false
skinparam backgroundColor white
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 22
skinparam ranksep 35
skinparam ArrowColor #475569

package "1. Inputs" {
  artifact "settings / trust" as SettingsFiles
  artifact "auth / models / model cache" as ModelFiles
  artifact "instructions / resources / packages" as ResourceFiles
  artifact "Session JSONL" as SessionFiles
}
package "2. Startup assembly" {
  component "Settings and trust" as Settings
  component "ModelRuntime" as Models
  component "PackageManager\nResourceLoader" as Resources
  component "SessionManager" as Sessions
  component "SDK createAgentSession" as SDK
  component "AgentSession" as Session
  component "Mode binding" as Binding
}
package "3. Per-turn request" {
  component "Input and before_agent_start hooks" as Hooks
  artifact "Agent context snapshot" as Snapshot
  component "Context transform\nconvertToLlm" as Transform
  artifact "Provider Context\nsystemPrompt + messages + tools" as Context
}
SettingsFiles --> Settings
ModelFiles --> Models
ResourceFiles --> Resources
SessionFiles --> Sessions
Settings --> Resources : trust and paths
Settings --> SDK
Models --> SDK
Resources --> SDK
Sessions --> SDK : current branch
SDK --> Session : Agent + loaded services
Session --> Binding
Binding --> Session : discovered resources
Session --> Hooks : tools and base prompt
Hooks --> Snapshot
Snapshot --> Transform
Transform --> Context
legend bottom left
Observed pi behavior at fc85bdd88be93b1e9a6b6bcfa41c684282ec79cc.
CLI selects the Session cwd before constructing cwd-bound services.
Agent starts with an empty prompt and tool list; AgentSession assembles both.
Settings, credentials and themes configure behavior; their raw files are not sent to the model.
endlegend
@enduml
