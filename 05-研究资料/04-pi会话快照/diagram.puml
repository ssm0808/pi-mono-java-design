left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475569
  ArrowColor #475569
  FontColor #0F172A
  AttributeFontColor #0F172A
  StereotypeFontColor #475569
}
skinparam note {
  BackgroundColor #FFF7ED
  BorderColor #C2410C
  FontColor #7C2D12
}
skinparam ArrowColor #475569

class SessionSnapshot <<observed_public_protocol>> {
  +id: string
  +name: string?
  +cwd: string
  +createdAt: timestamp
  +updatedAt: timestamp
  +attached: boolean
  +locked: boolean
  +revision: integer
  +queuedSteerCount: integer
}

enum SessionPhase {
  idle
  turn
  compaction
  branch_summary
  retry
}

enum ThinkingLevel {
  off
  minimal
  low
  medium
  high
  xhigh
  max
}

class ModelRef {
  +provider: string
  +id: string
}

abstract class TranscriptItem <<tagged_union>> {
  +id: string
  +role: user | assistant | tool
  +timestamp: timestamp
}

class UserTranscriptItem {
  +role: user
  +content: (TextContent | ImageContent)[*]
}

class AssistantTranscriptItem {
  +role: assistant
  +content: (TextContent | ThinkingContent | ToolCallContent)[*]
  +responseModel: string?
  +status: streaming | complete | error | aborted
  +stopReason: stop | length | toolUse | error | aborted?
  +errorMessage: string?
}

class ToolTranscriptItem {
  +role: tool
  +toolCallId: string
  +toolName: string
  +input: JsonValue
  +content: (TextContent | ImageContent)[*]
  +details: JsonValue?
  +status: running | complete | error
  +isError: boolean
}

class Usage {
  +input: integer
  +output: integer
  +cacheRead: integer
  +cacheWrite: integer
  +reasoning: integer?
  +totalTokens: integer
  +cost: UsageCost
}

class UsageCost {
  +input: number
  +output: number
  +cacheRead: number
  +cacheWrite: number
  +total: number
}

TranscriptItem <|-- UserTranscriptItem
TranscriptItem <|-- AssistantTranscriptItem
TranscriptItem <|-- ToolTranscriptItem

SessionSnapshot --> "1" SessionPhase : phase
SessionSnapshot --> "1" ThinkingLevel : thinkingLevel
SessionSnapshot *-- "1" ModelRef : model
SessionSnapshot *-- "0..*" TranscriptItem : transcript
SessionSnapshot o-- "0..*" UserTranscriptItem : queuedSteer
AssistantTranscriptItem *-- "1" ModelRef : model
AssistantTranscriptItem o-- "0..1" Usage : usage
ToolTranscriptItem o-- "0..1" Usage : usage
Usage *-- "1" UsageCost : cost

note bottom of SessionSnapshot
The snapshot is authoritative for the client.
Transcript progress events are incremental updates,
not fields contained by SessionSnapshot.
end note

note bottom of TranscriptItem
The transcript is a client-visible projection.
It is not the final model context.
end note
@enduml
