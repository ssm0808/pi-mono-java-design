' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/migrations/001_initial.sql: lines 1-59
' - packages/storage/sqlite-node/src/sqlite/migrations/002_branch_tips.sql: lines 1-12
' - packages/storage/sqlite-node/src/sqlite/storage/session-materialized.ts
' Observed behavior: pi has seven Session tables after its two migrations.
' Target-only product constraint: CampusClaw removes branch cache tables,
' entry materialized labels, generic moveTo, and arbitrary branch queries.
' Target adaptation: retain parent_id and active_leaf_id for immutable edits.
' Type adaptation: bounded VARCHAR, BIGINT, TIMESTAMPTZ(3), and JSONB.
' Design reason: use a two-by-two table grid instead of a 2331-pixel row.

entity "t_sessions" as sessions <<session head>> #DCEBFF {
  id : varchar(128) [PK]
  --
  created_at : timestamptz(3)
  cwd : varchar(512)
  parent_session_id : varchar(128) [nullable]
  metadata : jsonb [nullable]
  active_leaf_id : varchar(128) [nullable]
}

entity "t_session_sequences" as sequences <<allocator>> #FFE9CC {
  session_id : varchar(128) [PK]
  --
  next_seq : bigint
}

entity "t_session_entries" as entries <<immutable log>> #E4F4E8 {
  session_id : varchar(128) [PK]
  id : varchar(128) [PK]
  --
  entry_seq : bigint [UQ with session_id]
  parent_id : varchar(128) [nullable]
  type : varchar(64)
  timestamp : timestamptz(3)
  payload : jsonb
}

entity "t_session_materialized" as materialized <<projection>> #EEE8FF {
  session_id : varchar(128) [PK]
  --
  payload : jsonb
  activePath : current path summary
  lifetimeUsage : committed usage total
}

sessions -[hidden]right- sequences
entries -[hidden]right- materialized
sessions -[hidden]down- entries
sequences -[hidden]down- materialized

sessions ..> entries : owns immutable entries
sessions ..> entries : active_leaf_id selects tip
sessions ..> sequences : one allocator
sessions ..> materialized : one projection

note bottom of entries #EAF6ED
parent_id is the path fact.
entry_seq is append order, not path membership.
An edit inserts a sibling; old descendants stay audit-only.
end note

note bottom of materialized #F5F0FF
activePath is rebuilt after edit and fork.
lifetimeUsage never decreases when the active path changes.
Both values are rebuildable from committed entries.
end note

note bottom of sessions
Dashed lines are logical relations, not physical foreign keys.
Service transactions validate ownership, leaf, and sequence state.
end note

