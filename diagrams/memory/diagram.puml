' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/agent/src/harness/types.ts: SessionStorage
' - packages/agent/src/harness/session/repository.ts: SessionRepository
' - packages/storage/sqlite-node/src/sqlite/repo.ts: SerialOperationQueue
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: appendEntry
' Observed behavior: pi stores parent links, an active leaf, materialized state,
' branch caches, and entry materialized labels in a local SQLite backend.
' Target-only product constraint: CampusClaw exposes one active path and only
' allows editing the latest user message on that path.
' Architecture change: centralized GaussDB keeps four tables and reconstructs
' the active path from parent_id without branch cache tables.
' Concurrency hardening: expected leaf and parent fences protect multi-Pod writes.
' Design reason: group command, query, and release flows into readable layers.

actor "Agent Runtime" as runtime
actor "Internal Auditor" as auditor
actor "Database Release Platform" as release

runtime -[hidden]right- auditor

package "Java Session Layer" as javaLayer {
  component "Memory Session\nApplication Service" as app #DCEBFF
  component "Session Repository\nLifecycle" as repository #EEF3F8
  component "Session Storage\nFenced commands" as storage #EEF3F8
  component "Context Projector\nActive path to prompt" as projector #E4F4E8

  repository -[hidden]right- storage
  storage -[hidden]right- projector
  app --> repository : session lifecycle
  app --> storage : append and edit
  app --> projector : project context
}

package "GaussDB Persistence Adapter" as adapter {
  component "MyBatis Session\nMappers" as mappers #EEF3F8
  component "Spring Transaction\nManager" as tx #FFE9CC
  component "Parent Chain\nReader" as pathReader #E4F4E8

  mappers -[hidden]right- tx
  tx -[hidden]right- pathReader
  tx --> mappers : atomic DML
}

database "Centralized GaussDB\nFour Session tables" as db #E8EEF7

runtime --> app : commands and active reads
auditor --> app : authorized audit page
repository --> mappers : create open list fork delete
storage --> tx : fenced write transaction
app --> pathReader : load and validate active path
mappers --> db : fixed SQL
pathReader --> db : recursive parent chain
release --> db : versioned DDL before rollout

note left of app
One visible active path.
Only its latest user message is editable.
Old subtrees remain immutable and audit-only.
end note

note right of db #EAF6ED
t_sessions: active leaf
t_session_entries: immutable parent links
t_session_sequences: per-session order
t_session_materialized: activePath + lifetimeUsage

No branch cache or label tables.
end note

@enduml

@startuml memory-write-transaction
!pragma layout smetana
title Fenced Append and Edit Transaction Protocol
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam defaultTextAlignment left
skinparam ArrowColor #53657D
skinparam ArrowThickness 1.2
skinparam PackageBorderColor #7A8699
skinparam NoteBorderColor #B58B00
skinparam NoteBackgroundColor #FFF8D9

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: appendEntry
' - packages/storage/sqlite-node/src/sqlite/storage/session-sequences.ts
' - packages/storage/sqlite-node/src/sqlite/storage/session-materialized.ts
' Observed behavior: pi serializes writes in one process and updates seven
' categories of Session state in one SQLite transaction.
' Target-only edit rule: a new user entry shares the old user entry parent and
' becomes the new active leaf while the old subtree stays immutable.
' Architecture change: branch caches and label projection writes are removed.
' Concurrency hardening: lock session before sequence and require expected leaf.
' Design reason: show the common fence once and compare only divergent mutations.

rectangle "WRITE REQUEST\nAppendEntryDTO or EditLastUserMessageDTO" as request #DCEBFF

package "One GaussDB Transaction" as transaction {
  rectangle "1  SESSION FENCE\nBEGIN\nLock t_sessions FOR UPDATE\nCheck expectedParentEntryId or expectedLeafId\nReject stale state" as fence #FFE9CC

  rectangle "2  SEQUENCE ALLOCATION\nLock t_session_sequences FOR UPDATE\nAllocate the next entry_seq" as sequence #FFE9CC

  rectangle "3A  APPEND MUTATION\nReject leaf, branch_summary, and label\nInsert entry with parent = expected parent\nIncrement activePath and usage as applicable" as append #E4F4E8

  rectangle "3B  EDIT MUTATION\nValidate the complete active parent chain\nRequire target = nearest user message\nInsert sibling with parent = target.parent_id\nRebuild activePath; keep lifetimeUsage" as edit #EEE8FF

  rectangle "4  ATOMIC COMMIT\nAdvance next_seq\nPersist materialized payload\nMove active_leaf_id to the new entry\nCOMMIT" as commit #DCEBFF

  fence --> sequence
  sequence --> append : append
  sequence --> edit : edit
  append --> commit
  edit --> commit
  append -[hidden]right- edit
}

rectangle "FAIL CLOSED\nAny validation or DML failure rolls back the entire transaction.\nSequence, projection, and active leaf remain unchanged." as rollback #FDE8E7

request --> fence
rollback .up. transaction

note left of edit
Before BEGIN, edit requests make a
best-effort cancellation of the old Run.
The database fence remains authoritative.
end note

note right of commit
Lock order is always:
1. t_sessions
2. t_session_sequences

External Tool side effects are not rolled back.
end note

@enduml

