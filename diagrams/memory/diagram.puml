' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts:
'   readPathToRootOrCompaction
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts:
'   rebuildCachedBranch
' - packages/agent/src/harness/session/session.ts: buildSessionContext
' Observed behavior: pi prefers validated branch cache rows and repairs them
' from session_entries.parent_id when missing or invalid.
' Architecture change: CampusClaw always reads the authoritative parent chain
' and never stores or repairs a branch cache.
' Product constraint: ordinary paging and Context use only the active path;
' all-entry paging is an authorized internal audit operation.
' Design reason: separate active-path reconstruction from its three consumers.

database "t_sessions\nactive_leaf_id" as sessions #DCEBFF
database "t_session_entries\nparent_id + entry_seq" as entries #E4F4E8

sessions -[hidden]right- entries

rectangle "RECURSIVE CTE\nFollow parent_id\nleaf to root" as recursive #EEF3F8
rectangle "PATH INTEGRITY GUARD\nSame session\nComplete parents\nNo repeated IDs or cycles\nConfigured depth limit" as guard #FFE9CC
artifact "VALIDATED ACTIVE PATH\nroot to leaf" as path #E4F4E8

package "Ordinary Product Reads" as ordinary {
  rectangle "ACTIVE-PATH PAGE\nCursor page for UI" as page #DCEBFF
  rectangle "CONTEXT PROJECTOR\nCompaction trim\nModel + thinking + tools\nMessage projection" as projector #EEE8FF
  rectangle "MODEL CONTEXT" as context #E4F4E8

  projector --> context
  page -[hidden]right- projector
}

package "Internal Audit Only" as internal {
  rectangle "ALL APPEND LOG ENTRIES\nORDER BY entry_seq" as allEntries #EEF1F5
  rectangle "AUTHORIZED AUDIT PAGE" as audit #EEF1F5
  allEntries --> audit
}

ordinary -[hidden]right- internal

sessions --> recursive : current leaf
entries --> recursive : parent lookup
recursive --> guard : leaf-to-root rows
guard --> path : reverse after validation
path --> page
path --> projector
entries ..> allEntries : independent query

note bottom of guard
Missing parent, cross-session link, repeated ID,
cycle, or excessive depth fails closed.
There is no fallback to all-entry ordering.
end note

note bottom of audit #F3F4F6
Audit history is never model context
and is not returned by ordinary UI endpoints.
Imported leaf, branch_summary, and label
entries remain audit-only.
end note

