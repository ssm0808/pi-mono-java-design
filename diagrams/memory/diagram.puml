@startuml memory-architecture
!pragma layout smetana
title CampusClaw Four-Table GaussDB Session Storage
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/agent/src/harness/types.ts: SessionStorage
' - packages/agent/src/harness/session/repository.ts: SessionRepository
' - packages/storage/sqlite-node/src/sqlite/repo.ts: SerialOperationQueue
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: appendEntry
' Observed behavior: pi stores parent links, an active leaf, materialized state,
' branch caches, and entry materialized labels in a local SQLite backend.
' Target-only product constraint: CampusClaw exposes one active path and only
' allows editing the latest user message on that path.
' Architecture change: centralized GaussDB keeps four tables and reconstructs
' the active path from parent_id without branch cache tables.
' Concurrency hardening: expected leaf and parent fences protect multi-Pod writes.
' Design reason: preserve immutable edit history without a general branch UI.

actor "Agent Runtime" as runtime
actor "Internal Auditor" as auditor
actor "Database Release Platform" as release

package "Java Session Layer" {
  [Memory Session Application Service] as app
  [Session Repository] as repository
  [Session Storage] as storage
  [Context Projector] as projector
}

package "GaussDB Persistence Adapter" {
  [Spring Transaction Manager] as tx
  [MyBatis Session Mappers] as mappers
  [Parent Chain Reader] as pathReader
}

database "Centralized GaussDB\nFour Session tables" as db

runtime --> app : create append edit read fork
app --> repository : session lifecycle
app --> storage : entry and path operations
storage --> tx : fenced write transaction
tx --> mappers
mappers --> db
storage --> pathReader : active leaf
pathReader --> db : recursive parent chain
pathReader --> projector : validated active path
projector --> app : context and active summary
auditor --> app : authorized all-entry page
release --> db : apply DDL before rollout

note right of db
t_sessions owns the active leaf.
t_session_entries owns immutable parent links.
t_session_sequences allocates per-session order.
t_session_materialized stores activePath
and lifetimeUsage summaries.
There are no branch cache or label tables.
end note

note bottom of app
Only the latest user message on the active path
can be edited. The old subtree remains immutable.
Ordinary reads expose only the active path.
end note

note bottom of release
AgentService has DML permission only.
Schema history and locks are outside
the Session application schema.
end note

@enduml

@startuml memory-write-transaction
title CampusClaw Four-Table Session Write Transactions
skinparam backgroundColor #FFFFFF

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts: appendEntry
' - packages/storage/sqlite-node/src/sqlite/storage/session-sequences.ts
' - packages/storage/sqlite-node/src/sqlite/storage/session-materialized.ts
' Observed behavior: pi serializes writes in one process and updates seven
' categories of Session state in one SQLite transaction.
' Target-only edit rule: a new user entry replaces the latest active user entry
' by sharing its parent and becoming the new active leaf.
' Architecture change: branch caches and label projection writes are removed.
' Concurrency hardening: lock session before sequence and require expected leaf.
' Design reason: reject stale Runs while retaining immutable old-path evidence.

actor "Client or Runtime" as caller
participant "Session Service" as service
participant "Run Coordinator" as run
database "Centralized GaussDB" as db

alt create session
  caller -> service : createSession
  service -> db : BEGIN
  service -> db : insert t_sessions with null active leaf
  service -> db : insert t_session_sequences next_seq=1
  service -> db : insert empty t_session_materialized
  service -> db : COMMIT
  service --> caller : session
else append entry
  caller -> service : append(expectedParent, entry)
  service -> db : BEGIN
  service -> db : lock t_sessions row
  service -> service : require active leaf equals expectedParent
  service -> service : reject leaf, branch_summary, and label
  service -> db : lock t_session_sequences row
  service -> db : insert t_session_entries
  service -> db : advance next_seq
  service -> db : update activePath and lifetimeUsage
  service -> db : update t_sessions active leaf
  service -> db : COMMIT
  service --> caller : appended entry
else edit latest user message
  caller -> service : edit(target, expectedLeaf, new message)
  service -> run : best-effort cancel active Run
  service -> db : BEGIN
  service -> db : lock t_sessions row
  service -> service : require active leaf equals expectedLeaf
  service -> db : read and validate active parent chain
  service -> service : require target is nearest user message
  service -> db : lock t_session_sequences row
  service -> db : insert new user entry with target parent
  service -> db : advance next_seq
  service -> db : rebuild activePath; keep lifetimeUsage
  service -> db : update t_sessions active leaf
  service -> db : COMMIT
  service --> caller : new active user entry
else delete session
  caller -> service : deleteSession
  service -> db : BEGIN
  service -> db : delete t_session_entries
  service -> db : delete t_session_materialized
  service -> db : delete t_session_sequences
  service -> db : delete t_sessions
  service -> db : COMMIT
  service --> caller : deleted
end

note over service,db
The lock order is always session row then sequence row.
Any statement failure rolls back the complete operation.
A stale parent or leaf never selects a newer path silently.
end note

note over service,run
Run cancellation is best effort.
The expected-parent database fence is authoritative.
External tool side effects are not rolled back by an edit.
end note

@enduml

@startuml memory-data-model
title CampusClaw Four-Table GaussDB Session Data Model
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBorderColor #53657D
skinparam classBackgroundColor #F7F9FC

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/migrations/001_initial.sql: lines 1-59
' - packages/storage/sqlite-node/src/sqlite/migrations/002_branch_tips.sql: lines 1-12
' - packages/storage/sqlite-node/src/sqlite/storage/session-materialized.ts
' Observed behavior: pi has seven Session tables after its two migrations.
' Target-only product constraint: CampusClaw removes branch cache tables,
' entry materialized labels, generic moveTo, and arbitrary branch queries.
' Target adaptation: retain parent_id and active_leaf_id for immutable edits.
' Type adaptation: bounded VARCHAR, BIGINT, TIMESTAMPTZ(3), and JSONB.
' Design reason: four tables are sufficient for one visible active path while
' retaining old edited subtrees for authorized audit reads.

class "t_sessions" as sessions <<table>> {
  id : varchar(128) [PK]
  --
  created_at : timestamptz(3)
  cwd : varchar(512)
  parent_session_id : varchar(128) [nullable]
  metadata : jsonb [nullable]
  active_leaf_id : varchar(128) [nullable]
}

class "t_session_entries" as entries <<immutable log>> {
  session_id : varchar(128) [PK]
  id : varchar(128) [PK]
  --
  entry_seq : bigint [UQ with session_id]
  parent_id : varchar(128) [nullable]
  type : varchar(64)
  timestamp : timestamptz(3)
  payload : jsonb
}

class "t_session_sequences" as sequences <<allocator>> {
  session_id : varchar(128) [PK]
  --
  next_seq : bigint
}

class "t_session_materialized" as materialized <<projection>> {
  session_id : varchar(128) [PK]
  --
  payload : jsonb
  activePath : current path summary
  lifetimeUsage : committed usage total
}

sessions .. entries : logical session ownership
sessions .. entries : active_leaf_id selects current tip
entries .. entries : parent_id preserves immutable paths
sessions .. sequences : logical sequence ownership
sessions .. materialized : logical projection ownership

note right of entries
entry_seq is append order, not path membership.
Ordinary reads follow parent_id from active_leaf_id.
An edit inserts a sibling of the replaced user entry.
Old descendants remain available to internal audit only.
end note

note right of materialized
activePath is rebuilt after edit and fork.
lifetimeUsage never decreases when the active path changes.
The projection can be rebuilt from committed entries.
end note

note bottom of sessions
There are no physical foreign keys in this version.
Service transactions validate the active leaf,
parent ownership, and sequence row.
end note

@enduml

@startuml memory-context-rebuild
title CampusClaw Active-Path Context Rebuild Without Branch Cache
skinparam backgroundColor #FFFFFF

' Source evidence:
' - badlogic/pi-mono@f0deb8dd8e9611e89b5bc4145ca92c03ae6ed4ee
' - packages/storage/sqlite-node/src/sqlite/storage/index.ts:
'   readPathToRootOrCompaction
' - packages/storage/sqlite-node/src/sqlite/storage/branch-cache.ts:
'   rebuildCachedBranch
' - packages/agent/src/harness/session/session.ts: buildSessionContext
' Observed behavior: pi prefers validated branch cache rows and repairs them
' from session_entries.parent_id when missing or invalid.
' Architecture change: CampusClaw always reads the authoritative parent chain
' and never stores or repairs a branch cache.
' Product constraint: ordinary paging and Context use only the active path;
' all-entry paging is an authorized internal audit operation.
' Design reason: simplify writes for a product with one visible active path.

actor "Agent Runtime or UI" as caller
participant "Session Service" as service
participant "Parent Chain Reader" as reader
database "Centralized GaussDB" as db
participant "Context Projector" as projector
actor "Internal Auditor" as auditor

caller -> service : loadContext or pageEntries
service -> db : read t_sessions.active_leaf_id
db --> service : current leaf
service -> reader : read active path
reader -> db : recursive parent_id query
db --> reader : leaf-to-root rows
reader -> reader : validate same session and complete parents
reader -> reader : reject cycles and excessive depth
reader -> reader : reverse to entry_seq order
reader --> service : validated active path

alt context request
  service -> projector : active path
  projector -> projector : trim at compaction boundary
  projector -> projector : derive model, thinking, and tools
  projector -> projector : project context messages
  projector --> service : context snapshot
  service --> caller : context
else ordinary page request
  service --> caller : active-path cursor page
end

auditor -> service : pageAllEntriesForAudit
service -> db : query all entries by entry_seq
db --> service : active and old-path entries
service --> auditor : authorized audit page

note over reader,db
Missing parents, cross-session links, repeated IDs,
cycles, and excessive depth are corruption errors.
The service never falls back to all-entry ordering.
end note

note over service,auditor
Audit history is not model context and is not returned
by ordinary UI endpoints. Imported historical leaf,
branch_summary, and label entries remain audit-only.
end note

@enduml
